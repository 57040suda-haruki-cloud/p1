local dmgGuiFolder = visGui

--// hit fx: fortnite damage so bay + clone ForceField
local HitSounds = { bell = "rbxassetid://6518811702", pop = "rbxassetid://9106153995", tick = "rbxassetid://9106202384", fortnite = "rbxassetid://9106232005" }
local function PlayHitSound()
	local id = HitSounds[Config.HitSound.Selected] or HitSounds.bell
	local s = New("Sound", { SoundId = id, Volume = math.clamp(Config.HitSound.Volume, 0, 10), PlaybackSpeed = Config.HitSound.Pitch, Parent = SoundService })
	pcall(function() s:Play() end)
	Debris:AddItem(s, 2)
end
local function FortniteDamage(pos, amount)
	if Config.HitFX.DisableNumbers then return end
	local bb = New("BillboardGui", { Size = UDim2.new(0, 80, 0, 30), StudsOffset = Vector3.new(math.random(-2, 2), 3, 0), AlwaysOnTop = true, Adornee = nil }, dmgGuiFolder)
	local part = New("Part", { Anchored = true, CanCollide = false, CanQuery = false, CanTouch = false, Transparency = 1, Size = Vector3.new(0.5, 0.5, 0.5), CFrame = CFrame.new(pos) }, Workspace)
	bb.Adornee = part
	Debris:AddItem(part, 0.9) Debris:AddItem(bb, 0.9)
	local tl = New("TextLabel", { Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1, Font = Enum.Font.GothamBold, TextSize = 18, TextColor3 = Color3.fromRGB(255, 220, 80), TextStrokeTransparency = 0.2, Text = tostring(amount) }, bb)
	task.spawn(function()
		for i = 1, 20 do
			task.wait(0.03)
			pcall(function()
				part.CFrame = part.CFrame + Vector3.new(0, 0.15, 0)
				tl.TextTransparency = i / 20 tl.TextStrokeTransparency = i / 20
			end)
		end
	end)
end
local function SpawnHitClone(char)
	if not Config.HitFX.Enabled then return end
	pcall(function()
		local hrp = char:FindFirstChild("HumanoidRootPart")
		if not hrp then return end
		local clone = New("Part", { Size = Vector3.new(2, 3, 1), CFrame = hrp.CFrame, Anchored = true, CanCollide = false, CanQuery = false, CanTouch = false, Transparency = 0.3, Material = Enum.Material[Config.HitFX.Material] or Enum.Material.ForceField, Color = C_ACC }, Workspace)
		Debris:AddItem(clone, 0.6)
		task.spawn(function()
			for i = 1, 10 do task.wait(0.05) pcall(function() clone.Transparency = 0.3 + i * 0.07 end) end
		end)
	end)
end

-- hook damage: bat Humanoid.HealthChanged cua dich (co disconnect de khong leak gay lag)
local hooked = {}
local function HookCharDamage(p, ch)
	task.spawn(function()
		task.wait(0.3)
		if State.Destroyed then return end
		local h = ch and ch:FindFirstChildOfClass("Humanoid")
		if not h then return end
		-- ngat conn cu cua player nay
		local old = State.DmgConns[p]
		if old then pcall(function() old:Disconnect() end) State.DmgConns[p] = nil end
		local last = h.Health
		local conn = h.HealthChanged:Connect(function(nh)
			if State.Destroyed then return end
			if not ch.Parent then return end
			if nh < last then
				local dmg = math.floor(last - nh)
				last = nh
				if Config.HitFX.Enabled then
					local hrp = ch:FindFirstChild("HumanoidRootPart")
					if hrp then FortniteDamage(hrp.Position, dmg) end
					SpawnHitClone(ch)
					PlayHitSound()
				end
			else last = nh end
		end)
		State.DmgConns[p] = conn
		table.insert(State.Conns, conn)
	end)
end
local function HookPlayer(p)
	if hooked[p] then return end hooked[p] = true
	-- hook nhan vat hien tai luon, khong doi respawn
	if p.Character then HookCharDamage(p, p.Character) end
	Bind(p.CharacterAdded:Connect(function(ch) HookCharDamage(p, ch) end))
end
for _, p in pairs(Players:GetPlayers()) do HookPlayer(p) end
Bind(Players.PlayerAdded:Connect(HookPlayer))

--// ============ ESP (hinh 2 trai) ============
local function ClearESP(p)
	local f = State.ESPGui[p]
	if f then pcall(function() f:Destroy() end) State.ESPGui[p] = nil end
	local hl = State.ESPGui[p.Name .. "_hl"]
	if hl then pcall(function() hl:Destroy() end) State.ESPGui[p.Name .. "_hl"] = nil end
	State.ESPGui[p.Name .. "_refs"] = nil
	State.ESPGui[p.Name .. "_char"] = nil
end
local function MakeESP(p)
	ClearESP(p)
	local char = p.Character
	if not char then return end
	local hrp = char:FindFirstChild("HumanoidRootPart")
	local hum = char:FindFirstChildOfClass("Humanoid")
	if not hrp or not hum then return end
	local root = New("BillboardGui", { Name = "RV_ESP_" .. p.Name, Adornee = hrp, Size = UDim2.new(0, 120, 0, 96), StudsOffset = Vector3.new(0, 2.5, 0), AlwaysOnTop = true }, visGui)
	State.ESPGui[p] = root
	-- corner box 4 goc (kieu Yokai): 8 doan thang
	local box = New("Frame", { Size = UDim2.new(0, 60, 0, 60), Position = UDim2.new(0.5, -30, 0, 26), BackgroundTransparency = 1, BorderSizePixel = 0, Visible = Config.ESP.Box }, root)
	local corners = {}
	do
		local L0 = 14
		local T0 = math.max(1, math.floor(Config.ESP.Thickness or 2))
		local defs = {
			{0, 0, L0, T0}, {0, 0, T0, L0},
			{60 - L0, 0, L0, T0}, {60 - T0, 0, T0, L0},
			{0, 60 - T0, L0, T0}, {0, 60 - T0, T0, L0},
			{60 - L0, 60 - T0, L0, T0}, {60 - T0, 60 - T0, T0, L0},
		}
		for _, d in pairs(defs) do
			local f = New("Frame", { Size = UDim2.new(0, d[3], 0, d[4]), Position = UDim2.new(0, d[1], 0, d[2]), BackgroundColor3 = Config.ESP.BoxFill, BorderSizePixel = 0 }, box)
			table.insert(corners, f)
		end
	end
	-- name tren, weapon duoi name
	local dname = p.Name
	if Config.ESP.NameType == "DisplayName" then dname = p.DisplayName
	elseif Config.ESP.NameType == "Both" then dname = p.Name .. " [" .. p.DisplayName .. "]" end
	local nl = New("TextLabel", { Size = UDim2.new(1, 0, 0, 14), Position = UDim2.new(0, 0, 0, 0), BackgroundTransparency = 1, Font = Enum.Font.Code, TextSize = 12, TextColor3 = Config.ESP.NameA, TextStrokeTransparency = 0.3, Text = dname, Visible = Config.ESP.Name, Rotation = 0 }, root)
	-- weapon + distance
	local tool = char:FindFirstChildOfClass("Tool")
	local wl = New("TextLabel", { Size = UDim2.new(1, 0, 0, 10), Position = UDim2.new(0, 0, 0, 14), BackgroundTransparency = 1, Font = Enum.Font.Code, TextSize = 10, TextColor3 = C_TXT, TextStrokeTransparency = 0.4, Text = tool and tool.Name or "", Visible = Config.ESP.Weapon }, root)
	local dl = New("TextLabel", { Size = UDim2.new(1, 0, 0, 12), Position = UDim2.new(0, 0, 1, -26), BackgroundTransparency = 1, Font = Enum.Font.Code, TextSize = 10, TextColor3 = C_DIM, Text = "", Visible = Config.ESP.Distance }, root)
	-- watermark duoi cung kieu brand
	local wm = New("TextLabel", { Size = UDim2.new(1, 0, 0, 12), Position = UDim2.new(0, 0, 1, -13), BackgroundTransparency = 1, Font = Enum.Font.GothamBold, TextSize = 11, TextColor3 = Config.ESP.WatermarkColor, TextStrokeTransparency = 0.3, Text = Config.ESP.WatermarkText, Visible = Config.ESP.Watermark }, root)
	-- healthbar trai
	local hbBG = New("Frame", { Size = UDim2.new(0, 4, 0, 56), Position = UDim2.new(0.5, -37, 0, 28), BackgroundColor3 = Color3.fromRGB(20, 20, 20), BorderSizePixel = 0, Visible = Config.ESP.Healthbar }, root)
	local hbFill = New("Frame", { Size = UDim2.new(1, 0, 1, 0), Position = UDim2.new(0, 0, 0, 0), BackgroundColor3 = Config.ESP.HB_A, BorderSizePixel = 0 }, hbBG)
	-- skeleton dot (don gian: highlight thay skeleton nang)
	local hl = nil
	if Config.ESP.Skeleton or Config.ESP.Outline then
		hl = New("Highlight", { FillColor = Config.ESP.BoxFill, OutlineColor = Config.ESP.SkelC, FillTransparency = Config.ESP.Box and 0.7 or 1, OutlineTransparency = 0.1, DepthMode = Enum.HighlightDepthMode.Occluded, Adornee = char }, visGui)
	end
	root:SetAttribute("init", true)
	State.ESPGui[p.Name .. "_hl"] = hl
	State.ESPGui[p.Name .. "_refs"] = { box = box, corners = corners, name = nl, weap = wl, dist = dl, wmark = wm, hbBG = hbBG, hbFill = hbFill, hl = hl, builtThick = math.max(1, math.floor(Config.ESP.Thickness or 2)) }
	State.ESPGui[p.Name .. "_char"] = char
end
local function RefreshESP()
	if State.Destroyed then return end
	-- throttle 10Hz, khong chay moi frame nua
	local now = os.clock()
	if now - State.LastESP < 0.1 then return end
	State.LastESP = now
	-- tat het ESP thi don sach gui cu roi nghi, khoi lap players ton FPS
	if not (Config.ESP.Box or Config.ESP.Name or Config.ESP.Weapon or Config.ESP.Distance or Config.ESP.Healthbar or Config.ESP.Skeleton or Config.ESP.Outline or Config.ESP.Watermark) then
		for _, p in pairs(Players:GetPlayers()) do
			if State.ESPGui[p] then ClearESP(p) end
		end
		return
	end
	local myC = GetChar()
	local myHrp = myC and myC:FindFirstChild("HumanoidRootPart")
	if not myHrp then return end
	for _, p in pairs(Players:GetPlayers()) do
		if State.Destroyed then break end
		if p == LocalPlayer then continue end
		if not Config.ESP.IncludeTeam and p.Team == LocalPlayer.Team then ClearESP(p) continue end
		local charNow = p.Character
		if not charNow then ClearESP(p) continue end
		-- rebuild khi doi character / chet / respawn
		if State.ESPGui[p.Name .. "_char"] ~= charNow then MakeESP(p) end
		if not State.ESPGui[p] then MakeESP(p) end
		local refs = State.ESPGui[p.Name .. "_refs"]
		local root = State.ESPGui[p]
		-- doi do day vien goc thi dung lai cho chuan size
		if refs and refs.builtThick ~= math.max(1, math.floor(Config.ESP.Thickness or 2)) then
			MakeESP(p)
			refs = State.ESPGui[p.Name .. "_refs"]
			root = State.ESPGui[p]
		end
		if refs and root and root.Parent then
			local char = p.Character
			local hum = char and char:FindFirstChildOfClass("Humanoid")
			local hrp = char and char:FindFirstChild("HumanoidRootPart")
			if hum and hrp then
				-- cull theo Dormant / MaxDistance (tat Dormant = ve tam nhin xa)
				local dist = (hrp.Position - myHrp.Position).Magnitude
				local maxD = Config.ESP.Dormant == false and 3000 or (Config.ESP.MaxDistance or 1200)
				local far = dist > maxD
				local showAny = (Config.ESP.Box or Config.ESP.Name or Config.ESP.Weapon or Config.ESP.Distance or Config.ESP.Healthbar or Config.ESP.Skeleton or Config.ESP.Outline or Config.ESP.Watermark) and not far
				root.Enabled = showAny
				if refs.hl then refs.hl.Enabled = (Config.ESP.Skeleton or Config.ESP.Outline or Config.ESP.Box) and not far end
				if not showAny then continue end
				local hp = math.clamp(hum.Health / math.max(hum.MaxHealth, 1), 0, 1)
				refs.box.Visible = Config.ESP.Box
				for _, cf in pairs(refs.corners or {}) do cf.BackgroundColor3 = Config.ESP.BoxFill end
				refs.name.Visible = Config.ESP.Name
				refs.name.TextColor3 = Config.ESP.NameA
				refs.name.Rotation = math.clamp(Config.ESP.NameRot - 85, -20, 20)
				do
					local dn2 = p.Name
					if Config.ESP.NameType == "DisplayName" then dn2 = p.DisplayName
					elseif Config.ESP.NameType == "Both" then dn2 = p.Name .. " [" .. p.DisplayName .. "]" end
					refs.name.Text = dn2
				end
				refs.wmark.Visible = Config.ESP.Watermark
				refs.wmark.Text = Config.ESP.WatermarkText
				refs.wmark.TextColor3 = Config.ESP.WatermarkColor
				local tool = char:FindFirstChildOfClass("Tool")
				refs.weap.Visible = Config.ESP.Weapon
				refs.weap.Text = tool and tool.Name or ""
				refs.weap.Rotation = math.clamp(Config.ESP.WeaponRot, -20, 20)
				refs.dist.Visible = Config.ESP.Distance
				refs.dist.Text = tostring(math.floor(dist)) .. "m"
				refs.hbBG.Visible = Config.ESP.Healthbar
				refs.hbFill.Size = UDim2.new(1, 0, hp, 0)
				refs.hbFill.Position = UDim2.new(0, 0, 1 - hp, 0)
				if Config.ESP.HBType == "gradient" then
					refs.hbFill.BackgroundColor3 = Color3.fromRGB(math.floor(255 * (1 - hp)), math.floor(200 * hp + 40), 120)
				else
					refs.hbFill.BackgroundColor3 = Config.ESP.HB_A
				end
				if refs.hl then
					refs.hl.FillTransparency = Config.ESP.Box and 0.7 or 1
				end
			end
		end
	end
end
Bind(RunService.RenderStepped:Connect(RefreshESP))
Bind(Players.PlayerRemoving:Connect(function(p) ClearESP(p) end))

--// ============ MAIN LOOP (cross, hud, ind, aura pulse, fov, fps) ============
local lastFPSSet = 0
Bind(RunService.RenderStepped:Connect(function(dt)
	if State.Destroyed then return end
	local now = os.clock()
	if now - (State.LastMainLoop or 0) < 0.033 then return end
	State.LastMainLoop = now
	-- fps override
	if Config.Viewmodel.OverrideFPS and typeof(setfpscap) == "function" then
		if now - lastFPSSet > 2 then lastFPSSet = now pcall(setfpscap, Config.Viewmodel.FPS) end
	end
	-- fov (luon lay camera hien tai, khong cache)
	local camNow = Workspace.CurrentCamera
	if Config.Cam.FOVOn and camNow then pcall(function() camNow.FieldOfView = Config.Cam.FOV end) end
	-- blur + anti flash: throttle 1s, KHONG quet PlayerGui moi frame nua (day la thu gay crash)
	if now - State.LastFlash > 1 then
		State.LastFlash = now
		local blurFx = Lighting:FindFirstChild("RV_Blur")
		if Config.Cam.Blur > 0.01 then
			if not blurFx then
				blurFx = Instance.new("BlurEffect") blurFx.Name = "RV_Blur" blurFx.Parent = Lighting table.insert(State.FX, blurFx)
			end
			blurFx.Size = math.clamp(Config.Cam.Blur * 10, 0, 30) blurFx.Enabled = true
		else
			if blurFx then pcall(function() blurFx.Enabled = false end) end
		end
		if Config.Cam.AntiFlash then
			for _, v in pairs(Lighting:GetChildren()) do
				if v:IsA("BlurEffect") and v.Name ~= "RV_Blur" and v.Size > 10 then pcall(function() v.Enabled = false end) end
			end
			local pg = LocalPlayer:FindFirstChildOfClass("PlayerGui")
			if pg then
				for _, v in pairs(pg:GetChildren()) do
					if v:IsA("ScreenGui") and (v.Name:lower():find("flash") or v.Name:lower():find("blind")) then
						pcall(function() v.Enabled = false end)
					end
				end
			end
		end
	end
	-- crosshair (re, giu moi frame)
	UpdateCross(dt)
	-- target hud: throttle 10Hz
	if now - State.LastHUD > 0.1 then
		State.LastHUD = now
		if Config.TargetHUD.Enabled then
		local best, bestD = nil, 1e9
		local myC = GetChar()
		local myHrp = myC and myC:FindFirstChild("HumanoidRootPart")
		for _, p in pairs(EnemyList()) do
			local hrp = p.Character and p.Character:FindFirstChild("HumanoidRootPart")
			if hrp and myHrp then
				local d = (hrp.Position - myHrp.Position).Magnitude
				if d < bestD then bestD = d best = p end
			end
		end
		hud.Visible = true
		hud.Position = UDim2.new(Config.TargetHUD.OffX / 100, 0, Config.TargetHUD.OffY / 100, 0)
		hud.Size = UDim2.new(0, 220 * Config.TargetHUD.UIScale / 100, 0, 64 * Config.TargetHUD.UIScale / 100)
		if best then
			local h = best.Character:FindFirstChildOfClass("Humanoid")
			local hp = h and math.floor(h.Health) or 0
			local mx = h and h.MaxHealth or 100
			hudName.Text = "target: " .. (Config.ESP.NameType == "DisplayName" and best.DisplayName or best.Name)
			hudInfo.Text = "hp: " .. hp .. "  dist: " .. math.floor(bestD) .. "m  [" .. Config.TargetHUD.Mode .. "]"
			hudFill.Size = UDim2.new(math.clamp(hp / mx, 0, 1), 0, 1, 0)
		else
			hudName.Text = "target: -" hudInfo.Text = "hp: -  dist: -" hudFill.Size = UDim2.new(0, 0, 1, 0)
		end
	else hud.Visible = false end
	end
	-- aura follow + pulse (anchored, khong weld nen khong bao gio TP; tat aura thi bo qua han)
	if Config.Aura.Enabled then
	if AuraObjs.Ring and AuraObjs.Ring.Parent and AuraHRP and AuraHRP.Parent then
		pcall(function()
			AuraObjs.Ring.CFrame = AuraHRP.CFrame * CFrame.new(0, -3.05, 0) * CFrame.Angles(0, 0, math.rad(90))
			if Config.Aura.Pulse then
				local s = 6.5 * Config.Aura.Size * (0.9 + 0.15 * math.sin(os.clock() * 4))
				AuraObjs.Ring.Size = Vector3.new(0.2, s, s)
			end
		end)
	elseif AuraObjs.Ring and (not AuraHRP or not AuraHRP.Parent) then
		pcall(function() AuraObjs.Ring:Destroy() end) AuraObjs.Ring = nil AuraHRP = nil
	end
	if Config.Aura.RGB and AuraObjs.L and AuraObjs.L.Parent then
		State.Hue = (State.Hue + 0.005) % 1
		local cc2 = Color3.fromHSV(State.Hue, 0.9, 1)
		pcall(function() AuraObjs.L.Color = cc2 AuraObjs.Ring.Color = cc2 AuraObjs.P1.Color = ColorSequence.new(cc2) end)
	end
	end
end))

-- tracer theo tung vien dan: giu chuot la ve lien tuc tu dau sung toi diem ngam
local TraceParams = RaycastParams.new()
TraceParams.FilterType = Enum.RaycastFilterType.Exclude
TraceParams.IgnoreWater = true
Bind(RunService.Heartbeat:Connect(function(dt)
	if State.Destroyed then return end
	if not Config.Tracers.Enabled then return end
	local now = os.clock()
	if now - State.TracerLast < 0.06 then return end
	-- dang drop FPS thi nghi ve tracer de FPS hoi lai
	if (dt or 0) > 0.05 then return end
	local pressed = false
	pcall(function() pressed = UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) end)
	if not pressed then return end
	local cam = Workspace.CurrentCamera
	local char = GetChar()
	if not cam or not char then return end
	State.TracerLast = now
	TraceParams.FilterDescendantsInstances = { char, cam }
	local origin = cam.CFrame.Position
	local dir = cam.CFrame.LookVector * 1000
	local hitPos = origin + dir
	pcall(function()
		local res = Workspace:Raycast(origin, dir, TraceParams)
		if res and res.Position then hitPos = res.Position end
	end)
	SpawnTracer((cam.CFrame * CFrame.new(0.45, -0.35, -1.5)).Position, hitPos)
end))
Bind(UserInputService.InputBegan:Connect(function(io, g)
	if g then return end
	if io.KeyCode == Enum.KeyCode.RightShift then
		gui.Enabled = not gui.Enabled
	end
end))

--// =============================================================
--// UI DARK + SIDEBAR (giong hinh moi)
--// =============================================================
local C_GR = Color3.fromRGB(126, 200, 92)
local C_UIPANEL = Color3.fromRGB(23, 23, 23)
local C_UITRACK = Color3.fromRGB(48, 48, 48)
local Main = New("Frame", { Size = UDim2.new(0, 780, 0, 540), Position = UDim2.new(0.5, -390, 0.5, -270), BackgroundColor3 = Color3.fromRGB(15, 15, 15), BorderSizePixel = 0, Active = true }, gui)
New("UIStroke", { Color = Color3.fromRGB(42, 42, 42), Thickness = 1 }, Main)
New("UICorner", { CornerRadius = UDim.new(0, 6) }, Main)
local Top = New("Frame", { Size = UDim2.new(1, 0, 0, 28), BackgroundColor3 = Color3.fromRGB(11, 11, 11), BorderSizePixel = 0 }, Main)
New("UICorner", { CornerRadius = UDim.new(0, 6) }, Top)
local Title = New("TextLabel", { Size = UDim2.new(0, 260, 1, 0), Position = UDim2.new(0, 76, 0, 0), BackgroundTransparency = 1, Font = Enum.Font.Code, TextSize = 13, TextColor3 = C_TXT, TextXAlignment = Enum.TextXAlignment.Left, Text = "rivals visuals" }, Top)
local X = New("TextButton", { Size = UDim2.new(0, 26, 0, 20), Position = UDim2.new(1, -32, 0, 4), BackgroundColor3 = Color3.fromRGB(60, 20, 25), Font = Enum.Font.Code, TextSize = 12, TextColor3 = Color3.white, Text = "x", BorderSizePixel = 0 }, Top)
New("UICorner", { CornerRadius = UDim.new(0, 4) }, X)
X.MouseButton1Click:Connect(function() gui.Enabled = false end)
do
	local drag, ds, sp = false, nil, nil
	Bind(Top.InputBegan:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 then drag = true ds = i.Position sp = Main.Position i.Changed:Connect(function() if i.UserInputState == Enum.UserInputState.End then drag = false end end) end end))
	Bind(UserInputService.InputChanged:Connect(function(i) if drag and i.UserInputType == Enum.UserInputType.MouseMovement then local d = i.Position - ds Main.Position = UDim2.new(sp.X.Scale, sp.X.Offset + d.X, sp.Y.Scale, sp.Y.Offset + d.Y) end end))
end

local Side = New("Frame", { Size = UDim2.new(0, 64, 1, -28), Position = UDim2.new(0, 0, 0, 28), BackgroundColor3 = Color3.fromRGB(10, 10, 10), BorderSizePixel = 0 }, Main)
local tabNames = { "player", "other", "effects", "models" }
local tabLabels = { player = "ESP", other = "MISC", effects = "FX", models = "MDL" }
local tabBtns = {}
local Pages = {}
for i, tn in ipairs(tabNames) do
	local b = New("TextButton", { Size = UDim2.new(1, 0, 0, 56), Position = UDim2.new(0, 0, 0, 8 + (i - 1) * 60), BackgroundTransparency = 1, Font = Enum.Font.Code, TextSize = 12, TextColor3 = i == 1 and C_GR or Color3.fromRGB(120, 120, 120), Text = tabLabels[tn], BorderSizePixel = 0 }, Side)
	local bar = New("Frame", { Size = UDim2.new(0, 3, 0, 24), Position = UDim2.new(0, 0, 0.5, -12), BackgroundColor3 = C_GR, BorderSizePixel = 0, Visible = i == 1 }, b)
	tabBtns[tn] = { Btn = b, Bar = bar }
end
local Body = New("Frame", { Size = UDim2.new(1, -76, 1, -40), Position = UDim2.new(0, 70, 0, 34), BackgroundTransparency = 1 }, Main)
for _, tn in ipairs(tabNames) do
	local pg = New("Frame", { Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1, Visible = tn == "player" }, Body)
	Pages[tn] = pg
	local L = New("ScrollingFrame", { Size = UDim2.new(0.5, -4, 1, 0), Position = UDim2.new(0, 0, 0, 0), BackgroundTransparency = 1, ScrollBarThickness = 2, ScrollBarImageColor3 = Color3.fromRGB(60, 60, 60), CanvasSize = UDim2.new(0, 0, 0, 0), AutomaticCanvasSize = Enum.AutomaticSize.Y }, pg)
	New("UIListLayout", { Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder }, L)
	local R = New("ScrollingFrame", { Size = UDim2.new(0.5, -4, 1, 0), Position = UDim2.new(0.5, 4, 0, 0), BackgroundTransparency = 1, ScrollBarThickness = 2, ScrollBarImageColor3 = Color3.fromRGB(60, 60, 60), CanvasSize = UDim2.new(0, 0, 0, 0), AutomaticCanvasSize = Enum.AutomaticSize.Y }, pg)
	New("UIListLayout", { Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder }, R)
	pg:SetAttribute("L", true)
	State[tn .. "_L"] = L State[tn .. "_R"] = R
end
for tn, t in pairs(tabBtns) do
	t.Btn.MouseButton1Click:Connect(function()
		for tn2, pg in pairs(Pages) do pg.Visible = (tn2 == tn) end
		for tn2, tt in pairs(tabBtns) do
			local on = tn2 == tn
			tt.Btn.TextColor3 = on and C_GR or Color3.fromRGB(120, 120, 120)
			tt.Bar.Visible = on
		end
	end)

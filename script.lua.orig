            labels.Y.Text = string.format("%.0f", p.Y)
            labels.Z.Text = string.format("%.0f", p.Z)
        else
            labels.X.Text = "0"; labels.Y.Text = "0"; labels.Z.Text = "0"
        end
    end)
end


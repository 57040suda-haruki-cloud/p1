--  UNCODE v1 ·  Size Modifier
-- ═══════════════════════════════════════════════════════════════
do -- Size Modifier scope
local _szCFG = { enabled=false, scale=1.0 }
local _szL = Tabs.PlayerUtil:AddLeftGroupbox("Size Modifier")
local _szR = Tabs.PlayerUtil:AddRightGroupbox("Size Config")

local function _applySize(scale)
    pcall(function()
        local char = game:GetService("Players").LocalPlayer.Character
        if not char then return end
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not hum then return end
        hum.BodyDepthScale.Value  = scale
        hum.BodyHeightScale.Value = scale
        hum.BodyWidthScale.Value  = scale
        hum.HeadScale.Value       = scale
    end)
end

_szL:AddToggle("SizeModEnabled", { Text="Size Modifier", Default=false,
    Tooltip="Change local character size",
    Callback = function(v)
        _szCFG.enabled = v
        if v then _applySize(_szCFG.scale) else _applySize(1.0) end
        local lp = game:GetService("Players").LocalPlayer
        lp.CharacterAdded:Connect(function()
            task.wait(0.5)
            if _szCFG.enabled then _applySize(_szCFG.scale) end
        end)
    end })
_szR:AddSlider("SizeModScale", { Text="Scale",
    Default=1, Min=0.1, Max=5, Rounding=1,
    Callback = function(v)
        _szCFG.scale = v
        if _szCFG.enabled then _applySize(v) end
    end })
end -- Size Modifier scope

-- ═══════════════════════════════════════════════════════════════
--  UNCODE v1 ·  Auto Block
-- ═══════════════════════════════════════════════════════════════
do -- Auto Block scope
local _ablkCFG = { enabled=false, hpThreshold=80 }
local _ablkCon = nil
local _ablkL = Tabs.PlayerUtil:AddLeftGroupbox("Auto Block")
local _ablkR = Tabs.PlayerUtil:AddRightGroupbox("Block Config")

_ablkL:AddToggle("AutoBlockEnabled", { Text="Auto Block", Default=false,
    Tooltip="Auto block on HP loss",
    Callback = function(v)
        _ablkCFG.enabled = v
        local lp = game:GetService("Players").LocalPlayer
        local function _setupBlock(char)
            if _ablkCon then _ablkCon:Disconnect(); _ablkCon = nil end
            if not v then return end
            local hum = char:WaitForChild("Humanoid", 5)
            if not hum then return end
            local prevHP = hum.Health
            _ablkCon = hum.HealthChanged:Connect(function(hp)
                if not _ablkCFG.enabled then return end
                local pct = (hp / hum.MaxHealth) * 100
                if hp < prevHP and pct <= _ablkCFG.hpThreshold then
                    pcall(function()
                        local RS = game:GetService("ReplicatedStorage")
                        for _, n in ipairs({"Block","Shield","Parry","Guard"}) do
                            local re = RS:FindFirstChild(n)
                            if re then re:FireServer(); break end
                        end
                    end)
                    pcall(function()
                        local VIM = game:GetService("VirtualInputManager")
                        VIM:SendKeyEvent(true,  Enum.KeyCode.Q, false, game)
                        task.delay(0.12, function()
                            VIM:SendKeyEvent(false, Enum.KeyCode.Q, false, game)
                        end)
                    end)
                end
                prevHP = hp
            end)
        end
        if lp.Character then _setupBlock(lp.Character) end
        lp.CharacterAdded:Connect(function(c)
            task.wait(0.5)
            if _ablkCFG.enabled then _setupBlock(c) end
        end)
    end })
_ablkR:AddSlider("AutoBlockThreshold", { Text="Trigger HP %",
    Default=80, Min=10, Max=100, Rounding=0,
    Callback = function(v) _ablkCFG.hpThreshold = v end })
end -- Auto Block scope


local _swL = Tabs.Player:AddLeftGroupbox("Silent Walk")

_swL:AddToggle("SilentWalkEnabled", { Text="Silent Walk", Default=false,
    Tooltip="Mute your footstep sounds",
    Callback = function(v)
        _swCFG.enabled = v
        local lp = game:GetService("Players").LocalPlayer
        local function _muteSounds(char)
            pcall(function()
                for _, snd in ipairs(char:GetDescendants()) do
                    if snd:IsA("Sound") then
                        snd.Volume = v and 0 or 0.5
                    end
                end
            end)
        end
        if lp.Character then _muteSounds(lp.Character) end
        lp.CharacterAdded:Connect(function(c)
            task.wait(0.2)
            if _swCFG.enabled then _muteSounds(c) end
        end)
    end })
end -- Silent Walk scope

-- ═══════════════════════════════════════════════════════════════
--  UNCODE v1 ·  Anti-Hit Emergency TP
-- ═══════════════════════════════════════════════════════════════
do -- Anti-Hit Emergency TP scope
local _ahCFG = { enabled=false, hpThreshold=30, range=60 }
local _ahCon  = nil
local _ahL = Tabs.Player:AddLeftGroupbox("Emergency TP")
local _ahR = Tabs.Player:AddRightGroupbox("Emergency Config")

_ahL:AddToggle("AntiHitEnabled", { Text="Emergency TP", Default=false,
    Tooltip="Auto-TP away on critical HP",
    Callback = function(v)
        _ahCFG.enabled = v
        local lp = game:GetService("Players").LocalPlayer
        local function _setupAH(char)
            if _ahCon then _ahCon:Disconnect(); _ahCon = nil end
            if not v then return end
            local hum = char:WaitForChild("Humanoid", 5)
            local hrp = char:FindFirstChild("HumanoidRootPart")
            if not (hum and hrp) then return end
            local lastHP = hum.Health
            _ahCon = hum.HealthChanged:Connect(function(hp)
                if not _ahCFG.enabled then return end
                local pct = (hp / hum.MaxHealth) * 100
                if hp < lastHP and pct <= _ahCFG.hpThreshold then
                    pcall(function()
                        local spawn = workspace:FindFirstChildOfClass("SpawnLocation")
                        if spawn then
                            hrp.CFrame = spawn.CFrame + Vector3.new(0, 5, 0)
                        else
                            local rx = math.random(-_ahCFG.range, _ahCFG.range)
                            local rz = math.random(-_ahCFG.range, _ahCFG.range)
                            hrp.CFrame = hrp.CFrame + Vector3.new(rx, 8, rz)
                        end
                    end)
                    Notification.new({ Title="Emergency TP",
                        Content="Critical HP → Escaped!", Duration=2 })
                end
                lastHP = hp
            end)
        end
        if lp.Character then _setupAH(lp.Character) end
        lp.CharacterAdded:Connect(function(c)
            task.wait(0.5)
            if _ahCFG.enabled then _setupAH(c) end
        end)
    end })
_ahR:AddSlider("AntiHitHpThreshold", { Text="Trigger HP %",
    Default=30, Min=5, Max=80, Rounding=0,
    Callback = function(v) _ahCFG.hpThreshold = v end })
_ahR:AddSlider("AntiHitRange", { Text="Escape Range (studs)",
    Default=60, Min=10, Max=300, Rounding=0,
    Callback = function(v) _ahCFG.range = v end })
end -- Anti-Hit Emergency TP scope

end -- Player Tab scope


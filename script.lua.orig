                    end
                elseif yabujinUsers[q] and yabujinUsers[q].spoofer then
                    local b = getYabujinSpoofField(q, "Avatar")
                    if b and type(b) == "number" and b ~= 0 then
                        pcall(function()
                            W.Left.Headshot.Image = string.format(leaderboardConstants.HEADSHOT_IMAGE, b)
                        end)
                    end
                end
            end

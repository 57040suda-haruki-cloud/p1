-- lop visuals rieng: tat menu (X / RightShift) khong lam mat ESP/crosshair/HUD nua
local visGui = New("ScreenGui", { Name = "RV_Vis", ResetOnSpawn = false, ZIndexBehavior = Enum.ZIndexBehavior.Sibling, DisplayOrder = 999 }, CoreGui)

-- crosshair xoay RGB kieu yurei (Gui rieng, IgnoreGuiInset, uu tien ve cao nhat)
local crossGui = New("ScreenGui", { Name = "RV_Cross", ResetOnSpawn = false, IgnoreGuiInset = true, DisplayOrder = 9999, ZIndexBehavior = Enum.ZIndexBehavior.Sibling }, CoreGui)
local crossRoot = New("Frame", { Name = "Cross", Size = UDim2.new(0, 0, 0, 0), Position = UDim2.new(0.5, 0, 0.5, 0), BackgroundTransparency = 1, Visible = false }, crossGui)
local crossSpin = New("Frame", { Name = "Spin", Size = UDim2.new(0, 0, 0, 0), Position = UDim2.new(0, 0, 0, 0), BackgroundTransparency = 1 }, crossRoot)
local crossTextBox = New("Frame", { Name = "TextBox", Size = UDim2.new(0, 0, 0, 0), Position = UDim2.new(0, 0, 0, 0), BackgroundTransparency = 1 }, crossRoot)
local crossLines, crossOutlines = {}, {}
for i = 1, 4 do
	local o = New("Frame", { Name = "Borde" .. i, BorderSizePixel = 0, BackgroundColor3 = Color3.fromRGB(0, 0, 0), BackgroundTransparency = 0.5, AnchorPoint = Vector2.new(0.5, 0.5), ZIndex = 2 }, crossSpin)
	crossOutlines[i] = o
	local f = New("Frame", { Name = "Linea" .. i, BorderSizePixel = 0, BackgroundColor3 = Color3.white, AnchorPoint = Vector2.new(0.5, 0.5), ZIndex = 3 }, crossSpin)
	crossLines[i] = f
end
local crossLabel = New("TextLabel", { Name = "YokaiText", Size = UDim2.new(0, 300, 0, 20), Position = UDim2.new(0, -150, 0, 22), BackgroundTransparency = 1, Font = Enum.Font.Arial, TextSize = 14, TextColor3 = Color3.white, TextStrokeTransparency = 0, TextStrokeColor3 = Color3.fromRGB(0, 0, 0), Text = "yurei.win", Visible = false, ZIndex = 4 }, crossTextBox)
local function UpdateCross(dt)
	crossRoot.Visible = Config.Crosshair.Enabled
	crossLabel.Visible = Config.Crosshair.Enabled and Config.Crosshair.Label
	if not crossRoot.Visible then return end
	dt = math.clamp(tonumber(dt) or 0.016, 0, 0.1)
	State.CrossTick = (State.CrossTick or 0) + dt
	local tick = State.CrossTick
	local pos
	local wantFollow = false
	if Config.Crosshair.FollowMouse then
		wantFollow = true
		local mbs = ""
		pcall(function() mbs = tostring(UserInputService.MouseBehavior) end)
		if mbs ~= "Enum.MouseBehavior.Default" and not State.CrossMenuMode then
			wantFollow = false
		end
	end
	if wantFollow then
		local ml = UserInputService:GetMouseLocation()
		-- tru topbar inset vi crossGui bat IgnoreGuiInset (khong tru se lech ~36px duoi chuot)
		local insetY = 0
		pcall(function() insetY = GuiService:GetGuiInset().Y end)
		pos = UDim2.new(0, ml.X, 0, ml.Y - insetY)
	else
		pos = UDim2.new(0.5, 0, 0.5, 0)
	end
	crossSpin.Position = pos
	crossTextBox.Position = pos
	local pulseOn = Config.Crosshair.Pulse
	local pf = pulseOn and math.sin(tick * 3.5) or 0
	local pct = (pf + 1) / 2
	local rotSpd = (Config.Crosshair.RotSpeed or 0) * (0.35 + pct * 1.4)
	crossSpin.Rotation = (crossSpin.Rotation + rotSpd * dt) % 360
	local syncCol = Color3.fromHSV((tick * 0.05) % 1, 1, 1)
	local cols
	if Config.Crosshair.RGB then
		cols = { syncCol, syncCol, syncCol, syncCol }
	else
		cols = { Config.Crosshair.C1, Config.Crosshair.C2, Config.Crosshair.C3, Config.Crosshair.C4 }
	end
	crossLabel.TextColor3 = cols[1]
	crossLabel.Text = Config.Crosshair.LabelText or "yurei.win"
	local len = math.max(1, Config.Crosshair.Size + (pulseOn and pf * 5 or 0))
	local gap = Config.Crosshair.Gap or 0
	local th = math.max(1, Config.Crosshair.Thick or 1)
	local bs = 1
	local geo = {
		{ ls = UDim2.new(0, th, 0, len), lp = UDim2.new(0, 0, 0, -gap - len / 2) },
		{ ls = UDim2.new(0, th, 0, len), lp = UDim2.new(0, 0, 0, gap + len / 2) },
		{ ls = UDim2.new(0, len, 0, th), lp = UDim2.new(0, -gap - len / 2, 0, 0) },
		{ ls = UDim2.new(0, len, 0, th), lp = UDim2.new(0, gap + len / 2, 0, 0) },
	}
	for i = 1, 4 do
		local L, O, G = crossLines[i], crossOutlines[i], geo[i]
		L.Size = G.ls L.Position = G.lp L.BackgroundColor3 = cols[i]
		if i <= 2 then
			O.Size = UDim2.new(0, th + bs * 2, 0, len + bs * 2)
		else
			O.Size = UDim2.new(0, len + bs * 2, 0, th + bs * 2)
		end
		O.Position = G.lp
	end
end

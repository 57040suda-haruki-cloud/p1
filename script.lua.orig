	Toggle(h, "disable damage numbers", function() return Config.HitFX.DisableNumbers end, function(v) Config.HitFX.DisableNumbers = v end)
	Drop(h, "hit sound", { "bell", "pop", "tick", "fortnite" }, function() return Config.HitSound.Selected end, function(v) Config.HitSound.Selected = v end)
	Slider(h, "volume: %s", 0, 10, function() return Config.HitSound.Volume end, function(v) Config.HitSound.Volume = v end, "")

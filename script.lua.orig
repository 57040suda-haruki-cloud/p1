-- ║  UNDERGROUND AA / RESOLVER / AUTO-PEEK                               ║
-- ╚═══════════════════════════════════════════════════════════════════════╝
do
local _UAAL  = Tabs.AA:AddLeftGroupbox("Underground AA")
local _UAAR  = Tabs.AA:AddRightGroupbox("AA Config")
local _URVL  = Tabs.AA:AddLeftGroupbox("Resolver")
local _URVR  = Tabs.AA:AddRightGroupbox("Resolver Config")
local _UAPL  = Tabs.AA:AddRightGroupbox("Auto Peek")

-- ── Underground AA ─────────────────────────────────────────────────────
local _uaaCFG = {
    enabled     = false,
    mode        = "Jitter",
    jitterAngle = 58,
    jitterFreq  = 20,   -- flips per second
    spinSpeed   = 4,    -- rotations per second
    sideAngle   = 90,
    fakeDelta   = 180,
    onMoveOnly  = false,
}

local _uaaLP  = game:GetService("Players").LocalPlayer
local _uaaRS  = game:GetService("RunService")
local _uaaConn

local function _uaaStop()
    if _uaaConn then pcall(function() _uaaConn:Disconnect() end); _uaaConn = nil end
end

local function _uaaStart()
    _uaaStop()
    _uaaConn = _uaaRS.RenderStepped:Connect(function()
        if not _uaaCFG.enabled then return end
        pcall(function()
            local char = _uaaLP.Character
            if not char then return end
            local root = char:FindFirstChild("HumanoidRootPart")
            if not root then return end
            if _uaaCFG.onMoveOnly then
                local hum = char:FindFirstChildOfClass("Humanoid")
                if not hum or hum.MoveDirection.Magnitude < 0.05 then return end
            end
            local t  = tick()
            local cf = root.CFrame
            local _, ry, _ = cf:ToEulerAnglesYXZ()
            local yaw = 0
            if _uaaCFG.mode == "Jitter" then
                local flip = math.floor(t * _uaaCFG.jitterFreq) % 2
                yaw = (flip == 0) and _uaaCFG.jitterAngle or -_uaaCFG.jitterAngle
            elseif _uaaCFG.mode == "Spin" then
                yaw = (t * _uaaCFG.spinSpeed * 360) % 360
            elseif _uaaCFG.mode == "Side L" then
                yaw = -_uaaCFG.sideAngle
            elseif _uaaCFG.mode == "Side R" then
                yaw =  _uaaCFG.sideAngle
            elseif _uaaCFG.mode == "Back" then
                yaw = 180
            elseif _uaaCFG.mode == "Fake 180" then
                yaw = _uaaCFG.fakeDelta + math.sin(t * 8) * 5
            end
            root.CFrame = CFrame.new(cf.Position) * CFrame.Angles(0, ry + math.rad(yaw), 0)
        end)
    end)
end

_UAAL:AddToggle("UaaEnabled", {
    Text    = "Underground AA",
    Default = false,
    Tooltip = "Advanced AA: Jitter/Spin/Back modes to break enemy aimbot.",
    Callback = function(v)
        _uaaCFG.enabled = v
        if v then _uaaStart() else _uaaStop() end
        Notification.new({ Title="UNCODE v1", Content="Underground AA "..(v and "ON" or "OFF"), Duration=1.5 })
    end,
})
_UAAL:AddDropdown("UaaMode", {
    Text    = "AA Mode",
    Values  = {"Jitter","Spin","Side L","Side R","Back","Fake 180"},
    Default = "Jitter",
    Tooltip = "Jitter=alternate ±angle | Spin=360 | Side=sideways | Back=backward | Fake180=fake 180",
    Callback = function(v) _uaaCFG.mode = v end,
})
_UAAL:AddToggle("UaaOnMoveOnly", {
    Text    = "Only on Move",
    Default = false,
    Tooltip = "Activate AA only while moving.",
    Callback = function(v) _uaaCFG.onMoveOnly = v end,
})

_UAAR:AddSlider("UaaJitterAngle", {
    Text    = "Jitter Angle",
    Default = 58,
    Min = 1, Max = 180, Rounding = 0, Suffix = "°",
    Tooltip = "Angle for Jitter flips (recommended 58°).",
    Callback = function(v) _uaaCFG.jitterAngle = v end,
})
_UAAR:AddSlider("UaaJitterFreq", {
    Text    = "Jitter Speed",
    Default = 20,
    Min = 1, Max = 60, Rounding = 0, Suffix = "Hz",
    Tooltip = "Jitter flips per second (recommended 20Hz).",
    Callback = function(v) _uaaCFG.jitterFreq = v end,
})
_UAAR:AddSlider("UaaSpinSpeed", {
    Text    = "Spin Speed",
    Default = 4,
    Min = 1, Max = 20, Rounding = 0, Suffix = "r/s",
    Tooltip = "Rotations per second in Spin mode.",
    Callback = function(v) _uaaCFG.spinSpeed = v end,
})
_UAAR:AddSlider("UaaSideAngle", {
    Text    = "Side Angle",
    Default = 90,
    Min = 10, Max = 175, Rounding = 0, Suffix = "°",
    Tooltip = "Angle offset for Side L / Side R modes.",
    Callback = function(v) _uaaCFG.sideAngle = v end,
})
_UAAR:AddSlider("UaaFakeDelta", {
    Text    = "Fake 180 Delta",
    Default = 180,
    Min = 90, Max = 180, Rounding = 0, Suffix = "°",
    Tooltip = "Yaw offset for Fake 180 mode.",
    Callback = function(v) _uaaCFG.fakeDelta = v end,
})

-- ── Quick keybind registration ──────────────────────────────────────────
_qbLabels["UaaEnabled"] = "Underground AA"
_qbState["UaaEnabled"]  = false
_qbSetKey("UaaEnabled", "None")

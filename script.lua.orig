            local dataKey = RCmod:ToEnum("Data")
            replicatedData[dataKey] = replicatedData[dataKey] or {}
            for _, ctype in pairs({ "Skin", "Charm", "Wrap" }) do
              if eq[ctype] then replicatedData[dataKey][RCmod:ToEnum(ctype)] = eq[ctype] end
            end
          end
        end
      end
    end)
    local result = curNew(replicatedData, clientItem)
    pcall(function()
      if U.active and result and result._UpdateWrap and not result._destroyed and clientItem then
        local wname = clientItem.Name
        local wplayer = clientItem.ClientFighter and clientItem.ClientFighter.Player
        if wplayer == player and wname and U.equipped[wname] and U.equipped[wname].Wrap then
          result:_UpdateWrap()
        end
      end
    end)
    return result
  end
  if CVM.GetCharm then
    local curGC = CVM.GetCharm
    CVM.GetCharm = function(self)
      if U.active then
        local wname = self.ClientItem and self.ClientItem.Name
        local wplayer = self.ClientItem and self.ClientItem.ClientFighter and self.ClientItem.ClientFighter.Player
        if wname and wplayer == player and U.equipped[wname] and U.equipped[wname].Charm then
          return U.equipped[wname].Charm
        end
      end
      return curGC(self)
    end
  end
  if CVM.GetWrap then
    local curGW = CVM.GetWrap
    CVM.GetWrap = function(self)
      if U.active then
        local wname = self.ClientItem and self.ClientItem.Name
        local wplayer = self.ClientItem and self.ClientItem.ClientFighter and self.ClientItem.ClientFighter.Player
        if wname and wplayer == player and U.equipped[wname] and U.equipped[wname].Wrap then
          return U.equipped[wname].Wrap
        end
      end
      return curGW(self)
    end
  end
end)
step(function()
  local cur = ItemLib.GetViewModelImageFromWeaponData
  ItemLib.GetViewModelImageFromWeaponData = function(self, weaponData, highRes)
    if U.active and type(weaponData) == "table" and weaponData.Name then

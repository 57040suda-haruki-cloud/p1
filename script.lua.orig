local State = { Conns = {}, ESPGui = {}, HitClones = {}, TracerN = 0, Destroyed = false, Hue = 0, Backup = nil, FX = {}, SkyObj = nil, VMCon = nil, LastESP = 0, LastHUD = 0, LastFlash = 0, LastVM = 0, VMDirty = false, TracerPool = {}, TracerLast = 0, DmgConns = {}, SliderActive = nil, SliderGlobal = false }

local function Bind(c) table.insert(State.Conns, c) return c end
local function New(cls, props, parent)
	local o = Instance.new(cls)
	for k, v in pairs(props or {}) do
		if k ~= "Parent" then pcall(function() o[k] = v end) end
	end
	o.Parent = parent
	return o
end
local function GetChar(pl) pl = pl or LocalPlayer local c = pl and pl.Character if c and c:FindFirstChild("HumanoidRootPart") and c:FindFirstChildOfClass("Humanoid") then return c end return nil end
local function EnemyList()
	local out = {}
	for _, p in pairs(Players:GetPlayers()) do
		if p ~= LocalPlayer then
			if Config.ESP.IncludeTeam or p.Team ~= LocalPlayer.Team then
				local c = p.Character
				if c and c:FindFirstChild("HumanoidRootPart") and c:FindFirstChildOfClass("Humanoid") then
					if c:FindFirstChildOfClass("Humanoid").Health > 0 then table.insert(out, p) end
				end
			end
		end
	end
	return out
end

--// ============ WORLD BACKUP / APPLY ============
local function BackupL()
	if State.Backup then return end
	State.Backup = { Ambient = Lighting.Ambient, OutdoorAmbient = Lighting.OutdoorAmbient, Brightness = Lighting.Brightness, ClockTime = Lighting.ClockTime, FogColor = Lighting.FogColor, FogEnd = Lighting.FogEnd, FogStart = Lighting.FogStart, ExposureCompensation = Lighting.ExposureCompensation, GlobalShadows = Lighting.GlobalShadows, ColorShift_Bottom = Lighting.ColorShift_Bottom, ColorShift_Top = Lighting.ColorShift_Top }
end
local function GetFX(cls, name)
	local f = Lighting:FindFirstChild("RV_" .. name)
	if f then return f end
	BackupL()
	local e = Instance.new(cls) e.Name = "RV_" .. name e.Parent = Lighting table.insert(State.FX, e) return e
end
local SkyIDs = {
	["Vertical Milky Way"] = { Bk = "rbxassetid://159454299", Ft = "rbxassetid://159454299", Dn = "rbxassetid://159454299", Lf = "rbxassetid://159454299", Rt = "rbxassetid://159454299", Up = "rbxassetid://159454299" },
	["Night Stars"] = { Bk = "rbxassetid://151165214", Ft = "rbxassetid://151165214", Dn = "rbxassetid://151165214", Lf = "rbxassetid://151165214", Rt = "rbxassetid://151165214", Up = "rbxassetid://151165214" },
	["Clean Day"] = { Bk = "rbxassetid://252818973", Ft = "rbxassetid://252818973", Dn = "rbxassetid://252818973", Lf = "rbxassetid://252818973", Rt = "rbxassetid://252818973", Up = "rbxassetid://252818973" },
}
local function ApplyWorld()
	BackupL()
	-- color correction
	local cc = GetFX("ColorCorrectionEffect", "CC")
	cc.Enabled = Config.CC.Enabled
	cc.Saturation = Config.CC.Saturation cc.Contrast = Config.CC.Contrast cc.Brightness = Config.CC.Brightness cc.TintColor = Config.CC.Tint
	-- lighting
	local L = Config.Light
	pcall(function() Lighting.Ambient = L.Ambient Lighting.ColorShift_Bottom = L.CSB Lighting.ColorShift_Top = L.CST Lighting.FogColor = L.FogColor end)
	if L.UseFogEnd then Lighting.FogEnd = L.FogEnd else Lighting.FogEnd = 100000 end
	if L.UseFogStart then Lighting.FogStart = L.FogStart else Lighting.FogStart = 5000 end
	if L.UseExposure then Lighting.ExposureCompensation = L.Exposure end
	if L.UseBright then Lighting.Brightness = L.Bright end
	if L.UseClock then Lighting.ClockTime = L.Clock end
	Lighting.GlobalShadows = L.Shadows
	local atmo = Lighting:FindFirstChildOfClass("Atmosphere")
	if atmo then atmo.Density = 0.25 end
	-- sky
	if State.SkyObj then pcall(function() State.SkyObj:Destroy() end) State.SkyObj = nil end
	for _, v in pairs(Lighting:GetChildren()) do if v:IsA("Sky") and v.Name == "RV_Sky" then v:Destroy() end end
	if Config.Sky.Enabled then
		local d = SkyIDs[Config.Sky.Selected]
		if d then
			local s = Instance.new("Sky") s.Name = "RV_Sky"
			s.SkyboxBk = d.Bk s.SkyboxFt = d.Ft s.SkyboxDn = d.Dn s.SkyboxLf = d.Lf s.SkyboxRt = d.Rt s.SkyboxUp = d.Up
			s.CelestialBodiesShown = not Config.Sky.NoSunStars
			s.Parent = Lighting State.SkyObj = s
		end
	end
	-- bloom
	local bl = GetFX("BloomEffect", "Bloom")
	bl.Enabled = Config.Sky.Bloom bl.Intensity = Config.Sky.BInt bl.Size = math.max(Config.Sky.BSize, 1) bl.Threshold = Config.Sky.BThresh
	local sr = GetFX("SunRaysEffect", "Sun")
	sr.Enabled = Config.Sky.SunRays sr.Intensity = 0.15 sr.Spread = 0.7
end
local function RestoreWorld()
	if State.Backup then
		local B = State.Backup
		pcall(function()
			Lighting.Ambient = B.Ambient Lighting.OutdoorAmbient = B.OutdoorAmbient Lighting.Brightness = B.Brightness
			Lighting.ClockTime = B.ClockTime Lighting.FogColor = B.FogColor Lighting.FogEnd = B.FogEnd Lighting.FogStart = B.FogStart
			Lighting.ExposureCompensation = B.ExposureCompensation Lighting.GlobalShadows = B.GlobalShadows
			Lighting.ColorShift_Bottom = B.ColorShift_Bottom Lighting.ColorShift_Top = B.ColorShift_Top
		end)
	end
	for _, e in pairs(State.FX) do pcall(function() e:Destroy() end) end
	table.clear(State.FX)
	if State.SkyObj then pcall(function() State.SkyObj:Destroy() end) State.SkyObj = nil end
	for _, v in pairs(Lighting:GetChildren()) do if v.Name == "RV_Sky" then v:Destroy() end end
end

--// ============ AURA (giu tu V1, gon nhe) ============
local AuraObjs = {}
local AuraPresets = {
	["Cyber Blue"] = { Color3.fromRGB(0,170,255), Color3.fromRGB(0,255,255) },
	["Blood Red"] = { Color3.fromRGB(255,20,40), Color3.fromRGB(255,120,0) },
	["Venom Green"] = { Color3.fromRGB(0,255,120), Color3.fromRGB(180,255,0) },
	["Royal Purple"] = { Color3.fromRGB(150,0,255), Color3.fromRGB(255,0,200) },
	["Sun God"] = { Color3.fromRGB(255,200,0), Color3.fromRGB(255,90,0) },
	["Shadow"] = { Color3.fromRGB(20,20,25), Color3.fromRGB(120,0,255) },
}
local AuraHRP = nil
local function ClearAura()
	for _, v in pairs(AuraObjs) do
		pcall(function() if typeof(v) == "Instance" and v.Parent then v:Destroy() end end)
	end
	table.clear(AuraObjs)
	AuraHRP = nil
end
local function BuildAura(char)
	ClearAura()
	if not Config.Aura.Enabled then return end
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	if not hrp then return end
	local pr = AuraPresets[Config.Aura.Mode] or AuraPresets["Cyber Blue"]
	local main, second = pr[1], pr[2]
	if Config.Aura.RGB then
		State.Hue = (State.Hue + 0.02) % 1
		main = Color3.fromHSV(State.Hue, 0.9, 1)
		second = Color3.fromHSV((State.Hue + 0.12) % 1, 0.9, 1)
	end
	local inten = math.clamp(Config.Aura.Intensity, 0.3, 2)
	local sz = math.clamp(Config.Aura.Size, 0.6, 1.8)
	local folder = New("Folder", { Name = "RV_Aura" }, char)
	table.insert(AuraObjs, folder)
	if Config.Aura.Light then
		local pl = New("PointLight", { Name = "RV_L", Color = main, Brightness = 2 * inten, Range = 16 * sz, Shadows = false }, hrp)
		table.insert(AuraObjs, pl) AuraObjs.L = pl
	end
	local a0 = New("Attachment", { Name = "RV_A0", Position = Vector3.new(0, -1.2, 0) }, hrp)
	local a1 = New("Attachment", { Name = "RV_A1", Position = Vector3.new(0, 2.5, 0) }, hrp)
	table.insert(AuraObjs, a0) table.insert(AuraObjs, a1)
	local p1 = New("ParticleEmitter", {
		Texture = "rbxassetid://243098098",
		Color = ColorSequence.new({ ColorSequenceKeypoint.new(0, second), ColorSequenceKeypoint.new(1, main) }),
		Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.15), NumberSequenceKeypoint.new(1, 1) }),
		Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.6 * sz), NumberSequenceKeypoint.new(1, 0.05) }),
		Speed = NumberRange.new(3 * inten, 6 * inten), Lifetime = NumberRange.new(0.6, 1.2),
		Rate = math.floor(26 * inten), EmissionDirection = Enum.NormalId.Top, SpreadAngle = Vector2.new(35, 35),
		Acceleration = Vector3.new(0, 6, 0),
	}, a0)
	table.insert(AuraObjs, p1) AuraObjs.P1 = p1
	if Config.Aura.Ring then
		-- FIX TP: khong dung WeldConstraint nua (weld tao sau se giat HRP ve 0,0,0). Dung Anchored + follow moi frame.
		local ring = New("Part", { Name = "RV_Ring", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.2, 6.5 * sz, 6.5 * sz), Transparency = 0.55, CanCollide = false, CanQuery = false, CanTouch = false, Anchored = true, Massless = true, Material = Enum.Material.Neon, Color = main }, folder)
		pcall(function()
			ring.CFrame = hrp.CFrame * CFrame.new(0, -3.05, 0) * CFrame.Angles(0, 0, math.rad(90))
		end)
		table.insert(AuraObjs, ring) AuraObjs.Ring = ring AuraHRP = hrp
	end
	if Config.Aura.Trail then
		for _, ln in ipairs({ "Left Arm", "Right Arm", "Left Leg", "Right Leg" }) do
			local limb = char:FindFirstChild(ln)
			if limb and limb:IsA("BasePart") then
				local t0 = New("Attachment", { Position = Vector3.new(0, 0.8, 0) }, limb)
				local t1 = New("Attachment", { Position = Vector3.new(0, -0.8, 0) }, limb)
				local tr = New("Trail", { Color = ColorSequence.new({ ColorSequenceKeypoint.new(0, second), ColorSequenceKeypoint.new(1, main) }), Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.1), NumberSequenceKeypoint.new(1, 1) }), Lifetime = 0.45, WidthScale = NumberSequence.new(0.35), LightEmission = 1, LightInfluence = 0, Attachment0 = t0, Attachment1 = t1 }, limb)
				table.insert(AuraObjs, t0) table.insert(AuraObjs, t1) table.insert(AuraObjs, tr)
			end
		end
	end
end

--// ============ APPEARANCE OVERRIDE (hinh 2 phai) ============
local function ApplyAppearance()
	local c = GetChar()
	if not c then return end
	if not Config.Appearance.Enabled then return end
	for _, p in pairs(c:GetDescendants()) do
		if p:IsA("BasePart") and p.Name ~= "HumanoidRootPart" then
			pcall(function()
				p.Color = Config.Appearance.Color
				p.Material = Enum.Material[Config.Appearance.Material] or Enum.Material.ForceField
				p.Transparency = math.clamp(1 - Config.Appearance.Transparency / 100, 0, 1) * 0.7
			end)
		end
		if Config.Appearance.NoDecal then
			if p:IsA("Decal") or p:IsA("Shirt") or p:IsA("Pants") or p:IsA("ShirtGraphic") then
				pcall(function() p:Destroy() end)
			end
		end
	end
	if Config.Appearance.Aura then
		local hrp = c:FindFirstChild("HumanoidRootPart")
		if hrp and not hrp:FindFirstChild("RV_AppLight") then
			local l = New("PointLight", { Name = "RV_AppLight", Color = Config.Appearance.AuraC1, Brightness = 2, Range = 14 }, hrp)
			Debris:AddItem(l, 99999)
		end
	end
end

--// ============ VIEWMODEL OVERRIDE + SKIN CHANGER (giong hinh) ============
local VM_MATS = { "Neon", "SmoothPlastic", "Plastic", "Glass", "ForceField", "Metal", "DiamondPlate", "CorrodedMetal", "Foil", "Wood", "WoodPlanks", "Fabric", "Marble", "Slate", "Concrete", "Granite", "Brick", "Cobblestone", "Pebble", "Rock", "Limestone", "Basalt", "Ice", "Sand", "Sandstone", "Grass", "LeafyGrass", "Snow", "Mud", "Ground", "Asphalt" }
local ARM_NAMES = { LeftArm = true, RightArm = true, LeftHand = true, RightHand = true, Hand = true }
local function IsArmPart(part)
	if not part or not part:IsA("BasePart") then return false end
	if ARM_NAMES[part.Name] then return true end
	local n = part.Name:lower()
	if n:find("sleeve") then
		local p = part.Parent
		while p do
			if p.Name == "_fake" then return true end
			local pn = p.Name:lower()
			if pn:find("viewmodel") or pn:find("view_model") or pn == "arms" then return true end
			if p == Workspace or p == game then break end
			p = p.Parent
		end
	end
	return false
end
local function ModelIsViewmodel(model)
	local ok, hit = pcall(function()
		if model:FindFirstChild("_grip", true) or model:FindFirstChild("_center", true) then return true end
		local mn = model.Name:lower()
		if mn:find("itemmodel") or mn:find("viewmodel") or mn:find("view_model") or mn == "_fake" or mn == "weapon" or mn == "gun" or mn == "arms" then return true end
		return false
	end)
	return ok and hit
end
local function FindViewmodelParts()
	local cam = Workspace.CurrentCamera
	if not cam then return {}, {} end
	local weapons, arms = {}, {}
	for _, model in pairs(cam:GetChildren()) do
		if (model:IsA("Model") or model:IsA("Folder")) and ModelIsViewmodel(model) then
			for _, d in pairs(model:GetDescendants()) do
				if d:IsA("BasePart") then
					if ARM_NAMES[d.Name] or IsArmPart(d) then table.insert(arms, d)
					else table.insert(weapons, d) end
				end
			end
		end
	end
	if #weapons == 0 and #arms == 0 then
		-- fallback: part nam thang duoi camera
		for _, d in pairs(cam:GetChildren()) do
			if d:IsA("BasePart") then
				if ARM_NAMES[d.Name] or IsArmPart(d) then table.insert(arms, d)
				else table.insert(weapons, d) end
			end
		end
	end
	return weapons, arms
end
local function BackupPart(part)
	if not part:GetAttribute("RV_OInit") then
		part:SetAttribute("RV_OInit", true)
		pcall(function() part:SetAttribute("RV_OColor", part.Color) end)
		part:SetAttribute("RV_OMat", tostring(part.Material))
		part:SetAttribute("RV_OTrans", part.Transparency)
	end
end
local function RestorePart(part)
	if not part:GetAttribute("RV_OInit") then return end
	pcall(function()
		local c = part:GetAttribute("RV_OColor")
		if typeof(c) == "Color3" then part.Color = c end
		local m = part:GetAttribute("RV_OMat")
		if typeof(m) == "string" and Enum.Material[m] then part.Material = Enum.Material[m] end
		local t = part:GetAttribute("RV_OTrans")
		if typeof(t) == "number" then part.Transparency = t end
		for _, ch in pairs(part:GetChildren()) do
			if ch.Name == "RV_Wire" then ch:Destroy() end
		end
		if part:IsA("BasePart") then
			local st = part:FindFirstChildOfClass("ShirtTexture")
			if st and part:GetAttribute("RV_OShirtT") ~= nil then st.Transparency = part:GetAttribute("RV_OShirtT") end
		end
		for _, ch in pairs(part:GetChildren()) do
			if ch.Name == "RV_SkinTex" then ch:Destroy() end
		end
		if part:IsA("MeshPart") and part:GetAttribute("RV_OMesh") ~= nil then
			part.MeshId = part:GetAttribute("RV_OMesh")
			part.TextureID = part:GetAttribute("RV_OTex") or ""
		end
		part:SetAttribute("RV_Overridden", false)
		part:SetAttribute("RV_Skinned", false)
		part:SetAttribute("RV_SkinApplied", nil)
		part:SetAttribute("RV_OvApplied", nil)
	end)
end
local function ApplyPartLook(part, color, matName, trans01, wireframe, noTextures, isArm, noClothes)
	BackupPart(part)
	pcall(function()
		part.Color = color
		if Enum.Material[matName] then part.Material = Enum.Material[matName] end
		if wireframe then
			-- wireframe luoi That giong hinh: an mat solid, chi ve luoi mesh phat sang
			part.Transparency = 1
			local w = part:FindFirstChild("RV_Wire")
			if not (w and w:IsA("WireframeHandleAdornment")) then
				if w then w:Destroy() end
				local ok, wf = pcall(function()
					local x = Instance.new("WireframeHandleAdornment")
					x.Name = "RV_Wire" x.Adornee = part
					x.Color3 = color x.Transparency = 0
					x.AlwaysOnTop = true
					x.Parent = part
					return x
				end)
				w = (ok and wf) or nil
			end
			if w then pcall(function() w.Color3 = color w.Transparency = 0 end) end
		else
			part.Transparency = math.clamp(trans01, 0, 1)
			local w = part:FindFirstChild("RV_Wire")
			if w then w:Destroy() end
		end
		if noTextures then
			for _, ch in pairs(part:GetChildren()) do
				if ch:IsA("Texture") or ch:IsA("Decal") or ch:IsA("SurfaceAppearance") then
					ch.Transparency = 1
				end
			end
		end
		if isArm and noClothes then
			local st = part:FindFirstChildOfClass("ShirtTexture")
			if st then
				if part:GetAttribute("RV_OShirtT") == nil then part:SetAttribute("RV_OShirtT", st.Transparency) end
				st.Transparency = 1
			end
		end
		part:SetAttribute("RV_Overridden", true)
	end)
end
-- preview khau sung trong menu customize (ViewportFrame): tim model co _center / _fake
local PreviewRoots = {}
local LastPreviewScan = 0
local function FindPreviewRoots()
	local now = os.clock()
	if now - LastPreviewScan < 2 then return PreviewRoots end
	LastPreviewScan = now
	for i = #PreviewRoots, 1, -1 do
		if not PreviewRoots[i] or not PreviewRoots[i].Parent then table.remove(PreviewRoots, i) end
	end
	if #PreviewRoots > 0 then return PreviewRoots end
	local function scan(container)
		local ok, desc = pcall(function() return container:GetDescendants() end)
		if not ok or not desc then return end
		for _, d in pairs(desc) do
			if d.Name == "_center" or d.Name == "_fake" then
				local root = d.Parent
				while root and not root:IsA("Model") do root = root.Parent end
				if root and root.Parent then
					local dup = false
					for _, r in pairs(PreviewRoots) do if r == root then dup = true break end end
					if not dup then table.insert(PreviewRoots, root) end
					if #PreviewRoots >= 4 then return end
				end
			end
		end
	end
	pcall(function()
		local pg = LocalPlayer:FindFirstChildOfClass("PlayerGui")
		if pg then scan(pg) end
	end)
	return PreviewRoots
end
local function CollectTargetParts(withPreview)
	local weapons, arms = FindViewmodelParts()
	if withPreview then
		for _, root in pairs(FindPreviewRoots()) do
			pcall(function()
				for _, d in pairs(root:GetDescendants()) do
					if d:IsA("BasePart") then
						if ARM_NAMES[d.Name] or IsArmPart(d) then
							table.insert(arms, d)
						else
							table.insert(weapons, d)
						end
					end
				end
			end)
		end
	end
	return weapons, arms
end
local function OvSig(color, mat, trans, extra)
	return math.floor(color.R * 255) .. "," .. math.floor(color.G * 255) .. "," .. math.floor(color.B * 255) .. "|" .. mat .. "|" .. math.floor(trans * 100) .. "|" .. (extra or "")
end
local function ApplyViewmodelOverride()
	local cam = Workspace.CurrentCamera
	if not cam then return end
	if not Config.Viewmodel.OverrideEnabled then
		-- restore tat ca part tung bi override (chi quet khi dang dirty, xong thi thoi)
		if not State.VMDirty then return end
		local found = 0
		for _, d in pairs(cam:GetDescendants()) do
			if d:IsA("BasePart") and d:GetAttribute("RV_Overridden") then RestorePart(d) found = found + 1 end
		end
		for _, root in pairs(PreviewRoots) do
			pcall(function()
				for _, d in pairs(root:GetDescendants()) do
					if d:IsA("BasePart") and d:GetAttribute("RV_Overridden") then RestorePart(d) found = found + 1 end
				end
			end)
		end
		if found == 0 then State.VMDirty = false end
		return
	end
	State.VMDirty = true
	local vmT = 1 - math.clamp(Config.Viewmodel.VMTrans, 0, 100) / 100 * 0.9
	local armT = 1 - math.clamp(Config.Viewmodel.ArmTrans, 0, 100) / 100 * 0.9
	local vmSig = OvSig(Config.Viewmodel.VMColor, Config.Viewmodel.VMMaterial, 1 - vmT, (Config.Viewmodel.VMWireframe and "W" or "") .. (Config.Viewmodel.VMNoTextures and "T" or ""))
	local armSig = OvSig(Config.Viewmodel.ArmColor, Config.Viewmodel.ArmMaterial, 1 - armT, (Config.Viewmodel.ArmNoClothes and "C" or ""))
	local weapons, arms = CollectTargetParts(true)
	for _, part in pairs(weapons) do
		if part:GetAttribute("IgnoreTransparency") then continue end
		if part:GetAttribute("RV_OvApplied") == vmSig then continue end
		ApplyPartLook(part, Config.Viewmodel.VMColor, Config.Viewmodel.VMMaterial, 1 - vmT, Config.Viewmodel.VMWireframe, Config.Viewmodel.VMNoTextures, false, false)
		part:SetAttribute("RV_OvApplied", vmSig)
	end
	for _, part in pairs(arms) do
		if part:GetAttribute("RV_OvApplied") == armSig then continue end
		ApplyPartLook(part, Config.Viewmodel.ArmColor, Config.Viewmodel.ArmMaterial, 1 - armT, false, false, true, Config.Viewmodel.ArmNoClothes)
		part:SetAttribute("RV_OvApplied", armSig)
	end
	State.VMCounts = { w = #weapons, a = #arms }
end
-- unlock-all that bai (NOKS-style): mo skins/charms/wraps/dances, tru finishers.
-- khong so crash nhu ban hook cu: chi tra true cho cosmetic co dinh nghia That,
-- MISSING_ va code noi bo van chay ham goc. Tat toggle la hooks ngu dong (U.active).
local SkinStatus = nil
local UNLOCK_SRC = [==[
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local HttpService = game:GetService("HttpService")
local player = Players.LocalPlayer
if not player then return "no player" end
local playerScripts = player:WaitForChild("PlayerScripts", 10)
if not playerScripts then return "no PlayerScripts" end
local controllers = playerScripts:WaitForChild("Controllers", 10)
if not controllers then return "no Controllers" end
local U = getgenv().RV_Unlock
if type(U) ~= "table" then U = {} getgenv().RV_Unlock = U end
U.equipped = U.equipped or {}
U.favorites = U.favorites or {}
U.active = true
local CosLib = require(ReplicatedStorage.Modules:WaitForChild("CosmeticLibrary", 10))
if U.installed and U.cosLib == CosLib then return U.status or "already on" end
U.cosLib = CosLib
local ItemLib = require(ReplicatedStorage.Modules:WaitForChild("ItemLibrary", 10))
local DataCtrl = require(controllers:WaitForChild("PlayerDataController", 10))
local steps, stepsOk = 0, 0
U.stepErr = {}
local function step(fn)
  steps = steps + 1
  local ok, err = pcall(fn)
  if ok then stepsOk = stepsOk + 1 else U.stepErr["step" .. steps] = tostring(err):sub(1, 120) end
end
local function unlockedType(c, name)
  if c then
    local t = c.Type
    if t == "Skin" or t == "Charm" or t == "Wrap" or t == "Wrapping" or t == "Dance" or t == "Emote" then return true end
  end
  if type(name) == "string" then
    local ln = string.lower(name)
    if string.find(ln, "charm", 1, true) or string.find(ln, "wrap", 1, true) or string.find(ln, "dance", 1, true) or string.find(ln, "emote", 1, true) then return true end
  end
  return false
end
step(function()
  local m = ReplicatedStorage.Modules:FindFirstChild("EnumLibrary")
  if m then
    local EnumLib = require(m)
    U.EnumLib = EnumLib
    if EnumLib and EnumLib.WaitForEnumBuilder then EnumLib:WaitForEnumBuilder() end
  end
end)
local function cloneCosmetic(name, cosmeticType, options)
  local base = CosLib.Cosmetics[name]
  if not base then return nil end
  local data = {}
  for k, v in pairs(base) do data[k] = v end
  data.Name = name
  if not data.Type then data.Type = cosmeticType end
  if not data.Seed then data.Seed = math.random(1, 1000000) end
  if U.EnumLib then
    local ok, enumId = pcall(U.EnumLib.ToEnum, U.EnumLib, name)
    if ok and enumId then data.Enum = enumId if not data.ObjectID then data.ObjectID = enumId end end
  end
  if type(options) == "table" then
    if options.inverted ~= nil then data.Inverted = options.inverted end
    if options.favoritesOnly ~= nil then data.OnlyUseFavorites = options.favoritesOnly end
  end
  return data
end
local saveFile = "unlockall/config.json"
local function saveConfig()
  if not writefile then return end
  pcall(function()
    local config = { equipped = {}, favorites = U.favorites }
    for weapon, cosmetics in pairs(U.equipped) do
      if type(cosmetics) == "table" then
        config.equipped[weapon] = {}
        for ctype, cdata in pairs(cosmetics) do
          if type(cdata) == "table" and cdata.Name then
            config.equipped[weapon][ctype] = { name = cdata.Name, seed = cdata.Seed, inverted = cdata.Inverted }
          end
        end
      end
    end
    makefolder("unlockall")
    writefile(saveFile, HttpService:JSONEncode(config))
  end)
end
local function loadConfig()
  if not readfile or not isfile or not isfile(saveFile) then return end
  pcall(function()
    local config = HttpService:JSONDecode(readfile(saveFile))
    if type(config) ~= "table" then return end
    if type(config.equipped) == "table" then
      for weapon, cosmetics in pairs(config.equipped) do
        if type(cosmetics) == "table" then
          U.equipped[weapon] = U.equipped[weapon] or {}
          for ctype, cdata in pairs(cosmetics) do
            if type(cdata) == "table" and cdata.name then
              local cloned = cloneCosmetic(cdata.name, ctype, { inverted = cdata.inverted })
              if cloned then
                if cdata.seed then cloned.Seed = cdata.seed end
                U.equipped[weapon][ctype] = cloned
              end
            end
          end
        end
      end
    end
    if type(config.favorites) == "table" then
      for w, f in pairs(config.favorites) do U.favorites[w] = f end
    end
  end)
end
step(function()
  local cur = CosLib.OwnsCosmetic
  assert(type(cur) == "function", "no OwnsCosmetic")
  CosLib.OwnsCosmetic = function(self, inventory, name, weapon)
    if U.active and type(name) == "string" and not string.find(name, "MISSING_") then
      local c = CosLib.Cosmetics[name]
      if c and unlockedType(c, name) then return true end
    end
    return cur(self, inventory, name, weapon)
  end
end)
step(function()
  local cur = DataCtrl.Get
  DataCtrl.Get = function(self, key)
    local data = cur(self, key)
    if not U.active then return data end
    if key == "CosmeticInventory" then
      local proxy = {}
      if type(data) == "table" then for k, v in pairs(data) do proxy[k] = v end end
      return setmetatable(proxy, { __index = function(t, k)
        if type(k) == "string" then
          local c = CosLib.Cosmetics[k]
          if c and unlockedType(c, k) then return true end
        end
        return nil
      end })
    end
    if key == "FavoritedCosmetics" then
      local result = {}
      if type(data) == "table" then for k, v in pairs(data) do result[k] = v end end
      for w, favs in pairs(U.favorites) do
        if type(favs) == "table" then
          result[w] = result[w] or {}
          for n, f in pairs(favs) do result[w][n] = f end
        end
      end
      return result
    end
    return data
  end
end)
step(function()
  local cur = DataCtrl.GetWeaponData
  DataCtrl.GetWeaponData = function(self, weaponName)
    local data = cur(self, weaponName)
    if not data then return nil end
    if not U.active then return data end
    local eq = U.equipped[weaponName]
    if type(eq) ~= "table" then return data end
    local merged = {}
    for k, v in pairs(data) do merged[k] = v end
    merged.Name = weaponName
    for ctype, cdata in pairs(eq) do merged[ctype] = cdata end
    return merged
  end
end)
step(function()
  assert(type(hookmetamethod) == "function" and type(getnamecallmethod) == "function", "no hook")
  local rems = ReplicatedStorage:FindFirstChild("Remotes")
  local dataRemotes = rems and rems:FindFirstChild("Data")
  local equipRemote = dataRemotes and dataRemotes:FindFirstChild("EquipCosmetic")
  local favoriteRemote = dataRemotes and dataRemotes:FindFirstChild("FavoriteCosmetic")
  assert(equipRemote, "no EquipCosmetic")
  local function isDance(ct, cn)
    if ct == "Dance" or ct == "Emote" then return true end
    if type(cn) == "string" then
      local ln = string.lower(cn)
      if string.find(ln, "dance", 1, true) or string.find(ln, "emote", 1, true) then return true end
    end
    return false
  end
  local function storeEquip(weaponName, cosmeticType, cosmeticName, options)
    if type(options) ~= "table" then options = {} end
    if not cosmeticName or cosmeticName == "None" or cosmeticName == "" then
      if U.equipped[weaponName] then
        U.equipped[weaponName][cosmeticType] = nil
        if not next(U.equipped[weaponName]) then U.equipped[weaponName] = nil end
      end
      return "cleared"
    end
    local cloned = cloneCosmetic(cosmeticName, cosmeticType, { inverted = options.IsInverted, favoritesOnly = options.OnlyUseFavorites })
    if cloned then
      U.equipped[weaponName] = U.equipped[weaponName] or {}
      U.equipped[weaponName][cosmeticType] = cloned
      return "stored"
    end
    return "noclone"
  end
  local function forwarder(self, ...)
    if getnamecallmethod() ~= "FireServer" then return U.trueNamecall(self, ...) end
    if not U.active then return U.trueNamecall(self, ...) end
    local args = { ... }
    if self == equipRemote then
      local weaponName, cosmeticType, cosmeticName, options = args[1], args[2], args[3], args[4]
      local c = type(cosmeticName) == "string" and CosLib.Cosmetics[cosmeticName] or nil
      if isDance(cosmeticType, cosmeticName) then
        U.equipped.Dances = U.equipped.Dances or {}
        storeEquip("Dances", cosmeticType, cosmeticName, options)
        task.defer(function()
          pcall(function() DataCtrl.CurrentData:Replicate("CosmeticInventory") end)
          task.wait(0.2)
          saveConfig()
        end)
        return
      end
      if c and unlockedType(c, cosmeticName) then
        if cosmeticName and cosmeticName ~= "None" and cosmeticName ~= "" then
          local inv = DataCtrl:Get("CosmeticInventory")
          if inv and rawget(inv, cosmeticName) then return U.trueNamecall(self, ...) end
        end
        storeEquip(weaponName, cosmeticType, cosmeticName, options)
        task.defer(function()
          pcall(function() DataCtrl.CurrentData:Replicate("WeaponInventory") end)
          task.wait(0.2)
          saveConfig()
        end)
        return
      end
      return U.trueNamecall(self, ...)
    end
    if self == favoriteRemote then
      local w, cn, fav = args[1], args[2], args[3]
      local c = type(cn) == "string" and CosLib.Cosmetics[cn] or nil
      if (c and unlockedType(c, cn)) or isDance(nil, cn) then
        U.favorites[w] = U.favorites[w] or {}
        U.favorites[w][cn] = fav or nil
        saveConfig()
        task.spawn(function() pcall(function() DataCtrl.CurrentData:Replicate("FavoritedCosmetics") end) end)
        return
      end
      return U.trueNamecall(self, ...)
    end
    return U.trueNamecall(self, ...)
  end
  if not U.trueNamecall or U.hookJob ~= game.JobId then
    U.trueNamecall = hookmetamethod(game, "__namecall", forwarder)
    U.hookJob = game.JobId
  else
    hookmetamethod(game, "__namecall", forwarder)
  end
end)
step(function()
  local ClientItem
  local okR = pcall(function()
    ClientItem = require(playerScripts.Modules.ClientReplicatedClasses.ClientFighter.ClientItem)
  end)
  assert(okR and ClientItem and ClientItem._CreateViewModel, "no ClientItem")
  local cur = ClientItem._CreateViewModel
  ClientItem._CreateViewModel = function(self, viewmodelRef)
    pcall(function()
      local wname = self.Name
      local wplayer = self.ClientFighter and self.ClientFighter.Player
      U._constructing = (wplayer == player) and wname or nil
      if wplayer == player and U.active and viewmodelRef then
        local eq = U.equipped[wname]
        if type(eq) == "table" then
          local dataKey = self:ToEnum("Data")
          local nameKey = self:ToEnum("Name")
          for _, ctype in pairs({ "Skin", "Charm", "Wrap" }) do
            local cd = eq[ctype]
            if cd then
              if viewmodelRef[dataKey] then
                viewmodelRef[dataKey][self:ToEnum(ctype)] = cd
                viewmodelRef[dataKey][nameKey] = cd.Name
              elseif viewmodelRef.Data then
                viewmodelRef.Data[ctype] = cd
                viewmodelRef.Data.Name = cd.Name
              end
            end
          end
        end
      end
    end)
    local result = cur(self, viewmodelRef)
    U._constructing = nil
    return result
  end
end)
step(function()
  local vmMod
  local okR = pcall(function()
    vmMod = playerScripts.Modules.ClientReplicatedClasses.ClientFighter.ClientItem:FindFirstChild("ClientViewModel")
  end)
  assert(okR and vmMod, "no CVM")
local CVM, okR = nil, false
okR, CVM = pcall(require, vmMod)
if not okR or not CVM or type(CVM.new) ~= "function" then return "require loi" end
  local RCmod = nil
  pcall(function() RCmod = require(ReplicatedStorage.Modules.ReplicatedClass) end)
  local curNew = CVM.new

local function Group(parent, title)
	local g = New("Frame", { Size = UDim2.new(1, -2, 0, 10), BackgroundColor3 = C_UIPANEL, BorderSizePixel = 0, AutomaticSize = Enum.AutomaticSize.Y }, parent)
	New("UICorner", { CornerRadius = UDim.new(0, 4) }, g)
	New("UIStroke", { Color = Color3.fromRGB(38, 38, 38), Thickness = 1 }, g)
	New("TextLabel", { Size = UDim2.new(1, -12, 0, 20), Position = UDim2.new(0, 6, 0, 0), BackgroundTransparency = 1, Font = Enum.Font.Code, TextSize = 12, TextColor3 = Color3.fromRGB(215, 215, 215), TextXAlignment = Enum.TextXAlignment.Left, Text = title }, g)
	New("Frame", { Size = UDim2.new(1, -12, 0, 1), Position = UDim2.new(0, 6, 0, 21), BackgroundColor3 = Color3.fromRGB(45, 45, 45), BorderSizePixel = 0 }, g)
	local inner = New("Frame", { Size = UDim2.new(1, -12, 0, 10), Position = UDim2.new(0, 6, 0, 26), BackgroundTransparency = 1, AutomaticSize = Enum.AutomaticSize.Y }, g)
	New("UIListLayout", { Padding = UDim.new(0, 4), SortOrder = Enum.SortOrder.LayoutOrder }, inner)
	New("UIPadding", { PaddingBottom = UDim.new(0, 8) }, inner)
	return inner
end
local function Row(parent, h)
	local f = New("Frame", { Size = UDim2.new(1, 0, 0, h or 16), BackgroundTransparency = 1 }, parent)
	return f
end
local function TextInput(parent, left, get, set)
	local r = Row(parent, 16)
	New("TextLabel", { Size = UDim2.new(0.35, 0, 1, 0), BackgroundTransparency = 1, Font = Enum.Font.Code, TextSize = 12, TextColor3 = C_TXT, TextXAlignment = Enum.TextXAlignment.Left, Text = left }, r)
	local tb = New("TextBox", { Size = UDim2.new(0.65, 0, 1, 0), Position = UDim2.new(0.35, 0, 0, 0), BackgroundColor3 = Color3.fromRGB(28, 28, 28), Font = Enum.Font.Code, TextSize = 12, TextColor3 = Color3.white, TextXAlignment = Enum.TextXAlignment.Right, Text = tostring(get()), ClearTextOnFocus = false, BorderSizePixel = 0 }, r)
	New("UICorner", { CornerRadius = UDim.new(0, 4) }, tb)
	tb.FocusLost:Connect(function()
		pcall(set, tb.Text)
	end)
	return r
end
local function Toggle(parent, text, get, set)
	local r = Row(parent, 18)
	New("TextLabel", { Size = UDim2.new(1, -40, 1, 0), BackgroundTransparency = 1, Font = Enum.Font.Code, TextSize = 12, TextColor3 = C_TXT, TextXAlignment = Enum.TextXAlignment.Left, Text = text }, r)
	local track = New("TextButton", { Size = UDim2.new(0, 28, 0, 14), Position = UDim2.new(1, -30, 0.5, -7), BackgroundColor3 = get() and C_GR or C_UITRACK, Text = "", BorderSizePixel = 0 }, r)
	New("UICorner", { CornerRadius = UDim.new(1, 0) }, track)
	local knob = New("Frame", { Size = UDim2.new(0, 10, 0, 10), Position = get() and UDim2.new(1, -12, 0.5, -5) or UDim2.new(0, 2, 0.5, -5), BackgroundColor3 = Color3.white, BorderSizePixel = 0 }, track)
	New("UICorner", { CornerRadius = UDim.new(1, 0) }, knob)
	local function paint()
		local on = get()
		track.BackgroundColor3 = on and C_GR or C_UITRACK
		knob.Position = on and UDim2.new(1, -12, 0.5, -5) or UDim2.new(0, 2, 0.5, -5)
	end
	track.MouseButton1Click:Connect(function() set(not get()) paint() end)
	return r
end
local function Slider(parent, fmt, min, max, get, set, suffix)
	local pre = fmt:match("^(.-)%s*:") or fmt
	local r = New("Frame", { Size = UDim2.new(1, 0, 0, 30), BackgroundTransparency = 1 }, parent)
	New("TextLabel", { Size = UDim2.new(0.6, 0, 0, 14), BackgroundTransparency = 1, Font = Enum.Font.Code, TextSize = 11, TextColor3 = C_DIM, TextXAlignment = Enum.TextXAlignment.Left, Text = pre }, r)
	local valLbl = New("TextLabel", { Size = UDim2.new(0.4, 0, 0, 14), Position = UDim2.new(0.6, 0, 0, 0), BackgroundTransparency = 1, Font = Enum.Font.Code, TextSize = 11, TextColor3 = C_GR, TextXAlignment = Enum.TextXAlignment.Right, Text = "" }, r)
	local bar = New("Frame", { Size = UDim2.new(1, 0, 0, 6), Position = UDim2.new(0, 0, 0, 19), BackgroundColor3 = C_UITRACK, BorderSizePixel = 0 }, r)
	New("UICorner", { CornerRadius = UDim.new(0, 3) }, bar)
	local fill = New("Frame", { Size = UDim2.new(0, 0, 1, 0), BackgroundColor3 = C_GR, BorderSizePixel = 0 }, bar)
	New("UICorner", { CornerRadius = UDim.new(0, 3) }, fill)
	local function refresh()
		valLbl.Text = tostring(get()) .. (suffix or "")
		fill.Size = UDim2.new(math.clamp((get() - min) / math.max(max - min, 1e-6), 0, 1), 0, 1, 0)
	end
	refresh()
	local function fromX(x)
		local a = math.clamp((x - bar.AbsolutePosition.X) / math.max(bar.AbsoluteSize.X, 1), 0, 1)
		local v = min + (max - min) * a
		v = math.floor(v * 100) / 100
		set(v) refresh()
	end
	-- 1 global listener duy nhat cho tat ca slider (40 listener cu gay lag moi lan di chuot)
	if not State.SliderGlobal then
		State.SliderGlobal = true
		Bind(UserInputService.InputEnded:Connect(function(i)
			if i.UserInputType == Enum.UserInputType.MouseButton1 then State.SliderActive = nil end
		end))
		Bind(UserInputService.InputChanged:Connect(function(i)
			local act = State.SliderActive
			if act and act.r.Parent and i.UserInputType == Enum.UserInputType.MouseMovement then
				act.fromX(i.Position.X)
			elseif act and not act.r.Parent then
				State.SliderActive = nil
			end
		end))
	end
	local selfRef = {}
	selfRef.r = bar selfRef.fromX = fromX
	Bind(bar.InputBegan:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 then
			State.SliderActive = selfRef fromX(i.Position.X)
		end
	end))
	return r
end
local function Drop(parent, left, list, get, set)
	local r = Row(parent, 16)
	New("TextLabel", { Size = UDim2.new(0.6, 0, 1, 0), BackgroundTransparency = 1, Font = Enum.Font.Code, TextSize = 12, TextColor3 = C_TXT, TextXAlignment = Enum.TextXAlignment.Left, Text = left }, r)
	local b = New("TextButton", { Size = UDim2.new(0.4, 0, 1, 0), Position = UDim2.new(0.6, 0, 0, 0), BackgroundTransparency = 1, Font = Enum.Font.Code, TextSize = 12, TextColor3 = C_DIM, TextXAlignment = Enum.TextXAlignment.Right, Text = get() .. "  >" }, r)
	b.MouseButton1Click:Connect(function()
		local idx = table.find(list, get()) or 1
		idx = idx % #list + 1
		set(list[idx]) b.Text = list[idx] .. "  >"
	end)
	return r
end
local function ColorRow(parent, left, get, set)
	local r = Row(parent, 16)
	New("TextLabel", { Size = UDim2.new(1, -70, 1, 0), BackgroundTransparency = 1, Font = Enum.Font.Code, TextSize = 12, TextColor3 = C_TXT, TextXAlignment = Enum.TextXAlignment.Left, Text = left }, r)
	local b = New("TextButton", { Size = UDim2.new(0, 54, 0, 12), Position = UDim2.new(1, -58, 0, 2), BackgroundColor3 = get(), Text = "", BorderSizePixel = 0 }, r)
	New("UIStroke", { Color = Color3.fromRGB(70, 70, 80), Thickness = 1 }, b)
	local presets = { Color3.fromRGB(184,172,255), Color3.fromRGB(255,255,255), Color3.fromRGB(255,150,200), Color3.fromRGB(150,80,255), Color3.fromRGB(255,40,40), Color3.fromRGB(90,140,255), Color3.fromRGB(255,150,0), Color3.fromRGB(0,200,120), Color3.fromRGB(40,80,255) }
	b.MouseButton1Click:Connect(function()
		local cur = b.BackgroundColor3
		local bi, bd = 1, 1e9
		for i, c in ipairs(presets) do
			local d = math.abs(c.R - cur.R) + math.abs(c.G - cur.G) + math.abs(c.B - cur.B)
			if d < bd then bd = d bi = i end
		end
		local nx = presets[bi % #presets + 1]
		set(nx) b.BackgroundColor3 = nx
	end)
	return r
end
local function Colors2(parent, get1, set1, get2, set2)
	local r = Row(parent, 16)
	local b1 = New("TextButton", { Size = UDim2.new(0, 40, 0, 12), Position = UDim2.new(1, -88, 0, 2), BackgroundColor3 = get1(), Text = "", BorderSizePixel = 0 }, r)
	local b2 = New("TextButton", { Size = UDim2.new(0, 40, 0, 12), Position = UDim2.new(1, -44, 0, 2), BackgroundColor3 = get2(), Text = "", BorderSizePixel = 0 }, r)
	b1.MouseButton1Click:Connect(function() local n = get1() == Color3.fromRGB(90,140,255) and Color3.fromRGB(255,60,60) or Color3.fromRGB(90,140,255) set1(n) b1.BackgroundColor3 = n end)
	b2.MouseButton1Click:Connect(function() local n = get2() == Color3.fromRGB(140,80,255) and Color3.fromRGB(0,200,255) or Color3.fromRGB(140,80,255) set2(n) b2.BackgroundColor3 = n end)
	return r
end
local function Label(parent, txt)
	return New("TextLabel", { Size = UDim2.new(1, 0, 0, 14), BackgroundTransparency = 1, Font = Enum.Font.Code, TextSize = 11, TextColor3 = C_DIM, TextXAlignment = Enum.TextXAlignment.Left, Text = txt }, parent)
end

--// ============ BUILD PAGES (giong hinh moi) ============
-- PLAYER ESP
do
	local L = State["player_L"] local R = State["player_R"]
	local e = Group(L, "Player ESP")
	Drop(e, "Activation Type", { "fixed", "dynamic", "off" }, function() return Config.ESP.Bounding end, function(v) Config.ESP.Bounding = v end)
	Toggle(e, "Teammates", function() return Config.ESP.IncludeTeam end, function(v) Config.ESP.IncludeTeam = v end)
	Toggle(e, "Bounding Box", function() return Config.ESP.Box end, function(v) Config.ESP.Box = v end)
	Toggle(e, "Glow", function() return Config.ESP.Outline end, function(v) Config.ESP.Outline = v end)
	Toggle(e, "Dormant", function() return Config.ESP.Dormant ~= false end, function(v) Config.ESP.Dormant = v end)

do -- Combat/HvH UI scope (register isolation)
warn("[UNCODE] Combat/HvH tab init — build 20261009-h")

-- Combat tab: Silent Aim, Aimbot, Visuals
local HvHTab   = Tabs.Combat
local HvHL1    = HvHTab:AddLeftGroupbox("Silent Aim")
local HvHR1    = HvHTab:AddRightGroupbox("Aimbot")
local HvHL4    = HvHTab:AddLeftGroupbox("Visuals")
local HvHR4    = HvHTab:AddRightGroupbox("Visual Config")
-- HvH tab: Ragebot, Triggerbot, Flickbot
local HvHL2    = Tabs.HvH:AddLeftGroupbox("Ragebot")
local HvHR2    = Tabs.HvH:AddRightGroupbox("Rage Config")
local HvHL3    = Tabs.HvH:AddLeftGroupbox("Triggerbot / Flickbot")
local HvHR3    = Tabs.HvH:AddRightGroupbox("Flickbot Config")

-- _kSet is defined above (before Player Tab scope) — shared helper.

-- ═══════════════════════════════════════════════════════════════
-- Pure-Lua Camera Aimbot engine (fallback when Kicia is offline)
-- ═══════════════════════════════════════════════════════════════
local _abCFG2 = {
    enabled     = false,
    fov         = 120,   -- screen-pixel radius
    bone        = "Head",
    mode        = "Lock", -- "Lock" | "Linear" | "Spring"
    speed       = 0.50,
    visibleOnly = true,
    targetLock  = false,
}
local _abLockedPlayer = nil

local function _abFindTarget(lp, char, cam)
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil, nil end
    local cx = cam.ViewportSize.X / 2
    local cy = cam.ViewportSize.Y / 2
    local bestDist, bestPos, bestP = math.huge, nil, nil
    for _, p in ipairs(game:GetService("Players"):GetPlayers()) do
        if p ~= lp and p.Character then
            local phum = p.Character:FindFirstChildOfClass("Humanoid")
            local bone = p.Character:FindFirstChild(_abCFG2.bone)
                      or p.Character:FindFirstChild("Head")
                      or p.Character:FindFirstChild("HumanoidRootPart")
            if phum and phum.Health > 0 and bone then
                local screenPos, onScreen = cam:WorldToViewportPoint(bone.Position)
                if onScreen then
                    local dx = screenPos.X - cx
                    local dy = screenPos.Y - cy
                    local sDist = math.sqrt(dx * dx + dy * dy)
                    if sDist < _abCFG2.fov and sDist < bestDist then
                        local visible = true
                        if _abCFG2.visibleOnly then
                            local rp = RaycastParams.new()
                            rp.FilterDescendantsInstances = {char, p.Character}
                            rp.FilterType = Enum.RaycastFilterType.Exclude
                            local hit = workspace:Raycast(
                                cam.CFrame.Position,
                                (bone.Position - cam.CFrame.Position).Unit * 1200,
                                rp
                            )
                            visible = (hit == nil)
                        end
                        if visible then
                            bestDist = sDist
                            bestPos  = bone.Position
                            bestP    = p
                        end
                    end
                end
            end
        end
    end
    return bestPos, bestP
end

RunService.RenderStepped:Connect(function()
    if not _abCFG2.enabled then return end
    pcall(function()
        local lp   = game:GetService("Players").LocalPlayer
        local char = lp.Character
        if not char then return end
        local cam = workspace.CurrentCamera
        local targetPos, targetP

        -- Target-lock: prefer locked player while alive
        if _abCFG2.targetLock and _abLockedPlayer then
            if _abLockedPlayer.Character then
                local phum = _abLockedPlayer.Character:FindFirstChildOfClass("Humanoid")
                local bone = _abLockedPlayer.Character:FindFirstChild(_abCFG2.bone)
                          or _abLockedPlayer.Character:FindFirstChild("Head")
                          or _abLockedPlayer.Character:FindFirstChild("HumanoidRootPart")
                if phum and phum.Health > 0 and bone then
                    targetPos = bone.Position
                    targetP   = _abLockedPlayer
                end
            end
            if not targetPos then _abLockedPlayer = nil end
        end

        if not targetPos then
            targetPos, targetP = _abFindTarget(lp, char, cam)
            if _abCFG2.targetLock and targetP then
                _abLockedPlayer = targetP
            end
        end

        if not targetPos then return end

        local dir      = (targetPos - cam.CFrame.Position).Unit
        local targetCF = CFrame.new(cam.CFrame.Position, cam.CFrame.Position + dir)

        if _abCFG2.mode == "Lock" then
            cam.CFrame = targetCF
        elseif _abCFG2.mode == "Spring" then
            cam.CFrame = cam.CFrame:Lerp(targetCF, math.clamp(_abCFG2.speed * 2, 0.02, 1.0))
        else -- Linear
            cam.CFrame = cam.CFrame:Lerp(targetCF, _abCFG2.speed)
        end
    end)
end)


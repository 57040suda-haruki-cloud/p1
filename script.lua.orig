-- ╔══════════════════════════════════════════════════════════════════╗
-- ╚══════════════════════════════════════════════════════════════════╝
do
local PanicG = Tabs.Tools:AddRightGroupbox("Panic / Emergency")

local _panicKey = "Delete"

local function _doPanic()
    local count = 0
    for id, cb in pairs(_FlagCb or {}) do
        pcall(function()
            local cur = _qbState and _qbState[id]
            if cur then
                _T(id, false)
                _O(id, false)
                count = count + 1
            end
        end)
    end
    Notification.new({
        Title   = " PANIC",
        Content = count.." features disabled.",
        Duration = 3,
    })
end

PanicG:AddLabel("Panic Key — disable all instantly")
PanicG:AddDropdown("PanicKeyBind", {
    Text    = "Panic Key",
    Default = "Delete",
    Values  = _QB_KEY_LIST,
    Tooltip = "Press to disable all active features.",
    Callback = function(v) _panicKey = v end,
})
PanicG:AddButton("Disable All Now ", _doPanic)

game:GetService("UserInputService").InputBegan:Connect(function(input, gp)
    if gp then return end
    local name = tostring(input.KeyCode.Name)
    if name == _panicKey then _doPanic() end
end)
end -- Panic Key scope

-- ╔══════════════════════════════════════════════════════════════════╗
-- ╚══════════════════════════════════════════════════════════════════╝
do
local KdaG  = Tabs.HUD:AddLeftGroupbox("Session KDA")
local KdaGR = Tabs.HUD:AddRightGroupbox("KDA Config")

local _kda = { kills=0, deaths=0, assists=0, enabled=false }
local _kdaLP = game:GetService("Players").LocalPlayer

local function _kdaWatchPlayer(plr)
    pcall(function()
        local char = plr.Character or plr.CharacterAdded:Wait()
        local hum  = char:WaitForChild("Humanoid", 5)
        if not hum then return end
        hum.Died:Connect(function()
            if not _kda.enabled then return end
            _kda.kills = _kda.kills + 1
            Notification.new({
                Title   = "Kill!",
                Content = "Killed "..plr.Name.."  K:"..tostring(_kda.kills).." D:"..tostring(_kda.deaths),
                Duration = 2,
            })
        end)
    end)
end

local function _kdaWatchSelf()
    _kdaLP.CharacterAdded:Connect(function(char)
        if not _kda.enabled then return end
        _kda.deaths = _kda.deaths + 1
        Notification.new({
            Title   = "Death",
            Content = "Died  K:"..tostring(_kda.kills).." D:"..tostring(_kda.deaths),
            Duration = 2,
        })
    end)
end

local function _kdaStart()
    _kdaWatchSelf()
    for _, plr in ipairs(game:GetService("Players"):GetPlayers()) do
        if plr ~= _kdaLP then
            task.spawn(_kdaWatchPlayer, plr)
        end
    end
    game:GetService("Players").PlayerAdded:Connect(function(plr)
        if _kda.enabled and plr ~= _kdaLP then
            task.spawn(_kdaWatchPlayer, plr)
        end
    end)
end

KdaG:AddToggle("KdaEnabled", {
    Text    = "KDA Tracker",
    Default = false,
    Tooltip = "Count kills/deaths with notifications.",
    Callback = function(v)
        _kda.enabled = v
        if v then _kdaStart() end
        Notification.new({
            Title   = "KDA Tracker",
            Content = "KDA Tracker "..(v and "ON" or "OFF"),
            Duration = 1.5,
        })
    end,
})

KdaG:AddButton("Reset KDA", function()
    _kda.kills  = 0
    _kda.deaths = 0
    _kda.assists= 0
    Notification.new({ Title="KDA", Content="KDA has been reset.", Duration=1.5 })
end)

KdaGR:AddLabel("Current Session Stats:")
KdaGR:AddLabel("Live stats shown via notifications")
end -- Session KDA scope

-- ═══════════════════════════════════════════════════════════════
--  UNCODE v1 ·  Fake Lag / Lag Switch
-- ═══════════════════════════════════════════════════════════════
do -- Fake Lag scope
local _fLagCFG = { enabled=false, delay=0.2 }
local _fLagCon = nil
local FlagL = Tabs.Tools:AddLeftGroupbox("Fake Lag / Lag Switch")
local FlagR = Tabs.Tools:AddRightGroupbox("Lag Config")

FlagL:AddToggle("FakeLagEnabled", { Text="Fake Lag", Default=false,
    Tooltip="Artificially introduce network delay",
    Callback = function(v)
        _fLagCFG.enabled = v
        if v then
            local lp = game:GetService("Players").LocalPlayer
            _fLagCon = game:GetService("RunService").Heartbeat:Connect(function()
                if not _fLagCFG.enabled then return end
                local char = lp.Character
                if not char then return end
                local hrp = char:FindFirstChild("HumanoidRootPart")
                if hrp then
                    pcall(function() hrp:SetNetworkOwner(lp) end)
                end
                task.wait(_fLagCFG.delay)
            end)
        else
            if _fLagCon then _fLagCon:Disconnect(); _fLagCon = nil end
        end
    end })
FlagL:AddButton("Lag Spike (1s)", function()
    if not _fLagCFG.enabled then
        Notification.new({ Title="Fake Lag",
            Content="Enable Fake Lag first", Duration=2 })
        return
    end
    local saved = _fLagCFG.delay
    _fLagCFG.delay = 1.0
    task.delay(1.1, function() _fLagCFG.delay = saved end)
    Notification.new({ Title="Lag Spike",
        Content="1s forced lag spike triggered", Duration=2 })
end)
FlagR:AddSlider("FakeLagDelay", { Text="Delay (sec)",
    Default=0.2, Min=0.05, Max=2.0, Rounding=2,
    Callback = function(v) _fLagCFG.delay = v end })
end -- Fake Lag scope



-- ═══════════════════════════════════════════════════════════════
--  UNCODE v1 ·  Speedometer + Hit Rate HUD
-- ═══════════════════════════════════════════════════════════════
do -- Speedometer & Hit Rate scope
local _spdCFG  = { enabled=false }
local _hrCFG   = { enabled=false, shots=0, hits=0 }
local _spdGui  = nil
local _spdCon  = nil
local _spdRS   = game:GetService("RunService")
local SpdL = Tabs.HUD:AddLeftGroupbox("Speedometer / Hit Rate")
local SpdR = Tabs.HUD:AddRightGroupbox("Speed & Hit Config")

local function _spdBuild()
    if _spdGui then _spdGui:Destroy() end
    local sg = Instance.new("ScreenGui")
    sg.Name = "UNC_SpdHUD"; sg.ResetOnSpawn = false; sg.DisplayOrder = 11
    pcall(function() sg.Parent = game:GetService("CoreGui") end)
    if not sg.Parent then sg.Parent = game:GetService("Players").LocalPlayer.PlayerGui end
    _spdGui = sg
    local spd = Instance.new("TextLabel")
    spd.Name = "SpdLabel"
    spd.Size = UDim2.new(0, 160, 0, 22)
    spd.Position = UDim2.new(0.5, -80, 1, -80)
    spd.Text = "0.0 studs/s"
    spd.TextColor3 = Color3.fromRGB(255,255,255)
    spd.TextSize = 16; spd.Font = Enum.Font.GothamBold
    spd.BackgroundTransparency = 0.5
    spd.BackgroundColor3 = Color3.fromRGB(10,10,10)
    spd.BorderSizePixel = 0
    spd.Parent = sg
    local hr = Instance.new("TextLabel")
    hr.Name = "HrLabel"
    hr.Size = UDim2.new(0, 160, 0, 22)
    hr.Position = UDim2.new(0.5, -80, 1, -110)
    hr.Text = "Acc: 0/0 (0%)"
    hr.TextColor3 = Color3.fromRGB(100,220,255)
    hr.TextSize = 14; hr.Font = Enum.Font.Gotham
    hr.BackgroundTransparency = 0.5
    hr.BackgroundColor3 = Color3.fromRGB(10,10,10)
    hr.BorderSizePixel = 0
    hr.Parent = sg
end

SpdL:AddToggle("SpeedoEnabled", { Text="Speedometer", Default=false,
    Tooltip="Show current movement speed on HUD",
    Callback = function(v)
        _spdCFG.enabled = v
        if v then
            _spdBuild()
            local lp = game:GetService("Players").LocalPlayer
            local prevPos = nil
            _spdCon = _spdRS.Heartbeat:Connect(function(dt)
                if not _spdCFG.enabled or not _spdGui then return end
                local char = lp.Character
                if not char then return end
                local hrp = char:FindFirstChild("HumanoidRootPart")
                if hrp then
                    local pos = hrp.Position
                    if prevPos then
                        local spd = (pos - prevPos).Magnitude / dt
                        local lbl = _spdGui:FindFirstChild("SpdLabel")
                        if lbl then lbl.Text = string.format("%.1f studs/s", spd) end
                    end
                    prevPos = pos
                end
                if _hrCFG.enabled then
                    local lbl = _spdGui:FindFirstChild("HrLabel")
                    if lbl then
                        local acc = _hrCFG.shots > 0
                            and math.floor(_hrCFG.hits / _hrCFG.shots * 100) or 0
                        lbl.Text = string.format("Acc: %d/%d (%d%%)", _hrCFG.hits, _hrCFG.shots, acc)
                    end
                end
            end)
        else
            if _spdCon then _spdCon:Disconnect(); _spdCon = nil end
            if _spdGui then _spdGui:Destroy(); _spdGui = nil end
        end
    end })
SpdL:AddToggle("HitRateEnabled", { Text="Hit Rate HUD", Default=false,
    Tooltip="Show shots fired, hits, accuracy live",
    Callback = function(v)
        _hrCFG.enabled = v
        if v and not _spdGui then _spdBuild() end
        if v then
            pcall(function()
                local RS = game:GetService("ReplicatedStorage")
                local hitEv = RS:FindFirstChild("HitConfirm") or RS:FindFirstChild("ShotFired")
                if hitEv then
                    hitEv.OnClientEvent:Connect(function(isHit)
                        _hrCFG.shots = _hrCFG.shots + 1
                        if isHit then _hrCFG.hits = _hrCFG.hits + 1 end
                    end)
                end
            end)
        end
    end })
SpdL:AddButton("Reset Hit Rate", function()
    _hrCFG.shots = 0; _hrCFG.hits = 0
    Notification.new({ Title="Hit Rate", Content="Reset", Duration=2 })
end)
end -- Speedometer & Hit Rate scope

-- ═══════════════════════════════════════════════════════════════
-- ═══════════════════════════════════════════════════════════════
do -- Sound ESP Plus scope
local _sndCFG  = { enabled=false, gunOnly=false }
local _sndGui  = nil
local _sndConRS = nil
local _sndEvents = {}
local SndL = Tabs.HUD:AddLeftGroupbox("Sound ESP+")
local SndR = Tabs.HUD:AddRightGroupbox("Sound ESP Config")

local function _sndDirArrow(angle, label, duration)
    pcall(function()
        if not _sndGui then return end
        local container = _sndGui:FindFirstChild("SndCompass")
        if not container then return end
        local arrow = Instance.new("TextLabel")
        arrow.Size = UDim2.new(0, 40, 0, 40)
        local cx, cy = 100, 100  -- compass center (200x200 frame)
        local r = 80
        local rad = math.rad(angle - 90)
        arrow.Position = UDim2.new(0, cx + math.cos(rad)*r - 20, 0, cy + math.sin(rad)*r - 20)
        arrow.Text = ""
        arrow.TextSize = 18
        arrow.BackgroundTransparency = 1
        arrow.Font = Enum.Font.GothamBold
        arrow.TextColor3 = Color3.fromRGB(255,80,80)
        arrow.Parent = container
        game:GetService("Debris"):AddItem(arrow, duration or 2)
    end)
end

SndL:AddToggle("SoundEspPlusEnabled", { Text="Sound ESP+", Default=false,
    Tooltip="Show gunshot/footstep direction on compass",
    Callback = function(v)
        _sndCFG.enabled = v
        if v then
            local sg = Instance.new("ScreenGui")
            sg.Name = "UNC_SndESP"; sg.ResetOnSpawn = false; sg.DisplayOrder = 13
            pcall(function() sg.Parent = game:GetService("CoreGui") end)
            if not sg.Parent then sg.Parent = game:GetService("Players").LocalPlayer.PlayerGui end
            _sndGui = sg
            local compass = Instance.new("Frame")
            compass.Name = "SndCompass"
            compass.Size = UDim2.new(0, 200, 0, 200)
            compass.Position = UDim2.new(0.5, -100, 0, 10)
            compass.BackgroundTransparency = 0.85
            compass.BackgroundColor3 = Color3.fromRGB(0,0,0)
            compass.BorderSizePixel = 0
            local corner = Instance.new("UICorner"); corner.CornerRadius = UDim.new(1,0); corner.Parent = compass
            compass.Parent = sg
            for _, info in ipairs({{0,"N"},{90,"E"},{180,"S"},{270,"W"}}) do
                local deg, lbl = info[1], info[2]
                local txt = Instance.new("TextLabel")
                local rad = math.rad(deg - 90)
                txt.Size = UDim2.new(0, 20, 0, 20)
                txt.Position = UDim2.new(0, 100 + math.cos(rad)*88 - 10, 0, 100 + math.sin(rad)*88 - 10)
                txt.Text = lbl; txt.TextSize = 12; txt.Font = Enum.Font.GothamBold
                txt.TextColor3 = Color3.fromRGB(180,180,180); txt.BackgroundTransparency = 1
                txt.Parent = compass
            end
            _sndConRS = game:GetService("RunService").Heartbeat:Connect(function()
                if not _sndCFG.enabled then return end
                local lp  = game:GetService("Players").LocalPlayer
                local char = lp.Character
                if not char then return end
                local hrp = char:FindFirstChild("HumanoidRootPart")
                if not hrp then return end
                local cam = workspace.CurrentCamera
                for _, p in ipairs(game:GetService("Players"):GetPlayers()) do
                    if p ~= lp and p.Character then
                        for _, snd in ipairs(p.Character:GetDescendants()) do
                            if snd:IsA("Sound") and snd.IsPlaying then
                                local isGun = snd.Name:lower():find("shoot") or snd.Name:lower():find("fire") or snd.Name:lower():find("gun")
                                if not _sndCFG.gunOnly or isGun then
                                    local sndPos = snd.Parent and snd.Parent:IsA("BasePart") and snd.Parent.Position or hrp.Position
                                    local rel    = cam.CFrame:PointToObjectSpace(sndPos)
                                    local angle  = math.deg(math.atan2(rel.X, -rel.Z)) % 360
                                    _sndDirArrow(angle, snd.Name, 1.5)
                                end
                            end
                        end
                    end
                end
            end)
        else
            if _sndConRS then _sndConRS:Disconnect(); _sndConRS = nil end
            if _sndGui then _sndGui:Destroy(); _sndGui = nil end
        end
    end })
SndL:AddToggle("SoundEspGunOnly", { Text="Gun Sounds Only", Default=false,
    Callback = function(v) _sndCFG.gunOnly = v end })
end -- Sound ESP Plus scope

do -- FPS Boost scope
local FpsG = Tabs.UI:AddLeftGroupbox("FPS Boost")

-- ── state ─────────────────────────────────────────────────────
local _fpsOrigShadows    = nil
local _fpsShadowsOn      = false
local _fpsParticlesOn    = false
local _fpsPostFxOn       = false
local _fpsDecorOn        = false
local _fpsLowGfxOn       = false
local _fpsConns          = {}
-- lag reduction state
local _fpsUnlockerOn     = false
local _fpsNoSoundOn      = false
local _fpsNoAtmoOn       = false
local _fpsNoAccOn        = false
local _fpsLowMeshOn      = false
local _fpsSoundVols      = {}
local _fpsSoundConn      = nil
local _fpsAtmoProps      = {}
local _fpsAccConns       = {}

local Lighting    = game:GetService("Lighting")
local RunService  = game:GetService("RunService")

-- ── helpers ───────────────────────────────────────────────────
local function setParticles(enabled)
    for _, v in ipairs(workspace:GetDescendants()) do
        if v:IsA("ParticleEmitter") or v:IsA("Trail")
        or v:IsA("Beam") or v:IsA("Fire")
        or v:IsA("Smoke") or v:IsA("Sparkles") then
            pcall(function() v.Enabled = enabled end)
        end
    end
    -- also workspace future descendants
    if not enabled then
        local c = workspace.DescendantAdded:Connect(function(v)
            if v:IsA("ParticleEmitter") or v:IsA("Trail")
            or v:IsA("Beam") or v:IsA("Fire")
            or v:IsA("Smoke") or v:IsA("Sparkles") then
                pcall(function() v.Enabled = false end)
            end
        end)
        _fpsConns[#_fpsConns+1] = c
    else
        for _, c in ipairs(_fpsConns) do pcall(function() c:Disconnect() end) end
        _fpsConns = {}
    end
end

local function setPostFx(enabled)
    for _, v in ipairs(Lighting:GetChildren()) do
        if v:IsA("PostEffect") then
            pcall(function() v.Enabled = enabled end)
        end
    end
end

local function setShadows(enabled)
    pcall(function() Lighting.GlobalShadows = enabled end)
    for _, v in ipairs(workspace:GetDescendants()) do
        if v:IsA("BasePart") then
            pcall(function() v.CastShadow = enabled end)
        end
    end
end

local function setDecor(enabled)
    pcall(function() workspace.Terrain.Decoration = enabled end)
    pcall(function()
        local env = workspace:FindFirstChild("Environment")
        if env then
            for _, v in ipairs(env:GetDescendants()) do
                if v:IsA("BasePart") or v:IsA("Model") then
                    pcall(function() v.Visible = enabled end)
                end
            end
        end
    end)
end

local function setLowGfx(enabled)
    pcall(function()
        if enabled then
            settings().Rendering.QualityLevel = Enum.QualityLevel.Level01
        else
            settings().Rendering.QualityLevel = Enum.QualityLevel.Automatic
        end
    end)
end

local function setFpsCap(fps)
    pcall(function()
        if setfpscap then setfpscap(fps) end
    end)
end

local function setNoSound(enabled)
    if enabled then
        for _, v in ipairs(workspace:GetDescendants()) do
            if v:IsA("Sound") then
                _fpsSoundVols[v] = v.Volume
                pcall(function() v.Volume = 0 end)
            end
        end
        _fpsSoundConn = workspace.DescendantAdded:Connect(function(v)
            if v:IsA("Sound") then pcall(function() v.Volume = 0 end) end
        end)
    else
        if _fpsSoundConn then _fpsSoundConn:Disconnect() _fpsSoundConn = nil end
        for obj, vol in pairs(_fpsSoundVols) do
            pcall(function() obj.Volume = vol end)
        end
        _fpsSoundVols = {}
    end
end

local function setNoAtmosphere(enabled)
    for _, v in ipairs(Lighting:GetChildren()) do
        if v:IsA("Atmosphere") then
            if enabled then
                _fpsAtmoProps[v] = { Density = v.Density, Haze = v.Haze, Glare = v.Glare }
                pcall(function() v.Density = 0; v.Haze = 0; v.Glare = 0 end)
            else
                if _fpsAtmoProps[v] then
                    pcall(function()
                        v.Density = _fpsAtmoProps[v].Density
                        v.Haze    = _fpsAtmoProps[v].Haze
                        v.Glare   = _fpsAtmoProps[v].Glare
                    end)
                    _fpsAtmoProps[v] = nil
                end
            end
        end
    end
end

local function setNoAccessories(enabled)
    local Players = game:GetService("Players")
    local LP = Players.LocalPlayer
    for _, conn in ipairs(_fpsAccConns) do pcall(function() conn:Disconnect() end) end
    _fpsAccConns = {}
    local function hideCharAcc(char)
        for _, v in ipairs(char:GetChildren()) do
            if v:IsA("Accessory") then
                local h = v:FindFirstChild("Handle")
                if h and h:IsA("BasePart") then
                    pcall(function() h.LocalTransparencyModifier = enabled and 1 or 0 end)
                end
            end
        end
    end
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LP then
            if player.Character then hideCharAcc(player.Character) end
            local c = player.CharacterAdded:Connect(function(char)
                task.defer(function() hideCharAcc(char) end)
            end)
            _fpsAccConns[#_fpsAccConns+1] = c
        end
    end
    if enabled then
        local c = Players.PlayerAdded:Connect(function(player)
            if player == LP then return end
            if player.Character then hideCharAcc(player.Character) end
            local c2 = player.CharacterAdded:Connect(function(char)
                task.defer(function() hideCharAcc(char) end)
            end)
            _fpsAccConns[#_fpsAccConns+1] = c2
        end)
        _fpsAccConns[#_fpsAccConns+1] = c
    end
end

local function setLowMesh(enabled)
    for _, v in ipairs(workspace:GetDescendants()) do
        if v:IsA("MeshPart") then
            pcall(function()
                v.RenderFidelity = enabled
                    and Enum.RenderFidelity.Automatic
                    or  Enum.RenderFidelity.Precise
            end)
        end
    end
end

-- ── toggles ───────────────────────────────────────────────────
FpsG:AddToggle("FpsParticles", {
    Text = "Remove Particles & Effects",
    Default = false,
    Tooltip = "Disables ParticleEmitter, Fire, Smoke, Trail, Beam etc.",
    Callback = function(v)
        _fpsParticlesOn = v
        setParticles(not v)
    end
})

FpsG:AddToggle("FpsShadows", {
    Text = "Disable Shadows",
    Default = false,
    Tooltip = "Turns off GlobalShadows and CastShadow on all parts.",
    Callback = function(v)
        _fpsShadowsOn = v
        setShadows(not v)
    end
})

FpsG:AddToggle("FpsPostFx", {
    Text = "Remove Post-Effects",
    Default = false,
    Tooltip = "Disables Bloom, ColorCorrection, DepthOfField etc.",
    Callback = function(v)
        _fpsPostFxOn = v
        setPostFx(not v)
    end
})

FpsG:AddToggle("FpsDecor", {
    Text = "Remove Decorations",
    Default = false,
    Tooltip = "Hides terrain decorations and environment props.",
    Callback = function(v)
        _fpsDecorOn = v
        setDecor(not v)
    end
})

FpsG:AddToggle("FpsLowGfx", {
    Text = "Low Graphics Mode",
    Default = false,
    Tooltip = "Forces Roblox graphics to Level 1.",
    Callback = function(v)
        _fpsLowGfxOn = v
        setLowGfx(v)
    end
})

-- ── lag reduction ──────────────────────────────────────────────
FpsG:AddToggle("FpsUnlocker", {
    Text = "FPS Unlocker",
    Default = false,
    Tooltip = "Removes/changes the FPS cap via setfpscap().",
    Callback = function(v)
        _fpsUnlockerOn = v
        local cap = (Options["FpsCapValue"] and Options["FpsCapValue"].Value) or 240
        setFpsCap(v and cap or 60)
    end
})
FpsG:AddSlider("FpsCapValue", {
    Text = "FPS Cap",
    Default = 240, Min = 30, Max = 360, Rounding = 0,
    Tooltip = "Maximum FPS applied when FPS Unlocker is ON.",
    Callback = function(v)
        if _fpsUnlockerOn then setFpsCap(v) end
    end
})

FpsG:AddToggle("FpsNoSound", {
    Text = "Mute All Sounds",
    Default = false,
    Tooltip = "Sets all Sound volumes to 0 (reduces lag).",
    Callback = function(v)
        _fpsNoSoundOn = v
        setNoSound(v)
    end
})

FpsG:AddToggle("FpsNoAtmo", {
    Text = "Disable Atmosphere",
    Default = false,
    Tooltip = "Sets Atmosphere Density/Haze/Glare to 0.",
    Callback = function(v)
        _fpsNoAtmoOn = v
        setNoAtmosphere(v)
    end
})

FpsG:AddToggle("FpsNoAcc", {
    Text = "Hide Player Accessories",
    Default = false,
    Tooltip = "Hides accessories from other players.",
    Callback = function(v)
        _fpsNoAccOn = v
        setNoAccessories(v)
    end
})

FpsG:AddToggle("FpsLowMesh", {
    Text = "Low Mesh Detail",
    Default = false,
    Tooltip = "Lowers MeshPart RenderFidelity to Automatic.",
    Callback = function(v)
        _fpsLowMeshOn = v
        setLowMesh(v)
    end
})

FpsG:AddButton("Apply All FPS Boost", function()
    setParticles(false)
    setShadows(false)
    setPostFx(false)
    setDecor(false)
    setLowGfx(true)
    setNoSound(true)
    setNoAtmosphere(true)
    setNoAccessories(true)
    setLowMesh(true)
    setFpsCap(240)
    -- sync toggles
    if Toggles.FpsParticles then Toggles.FpsParticles:SetValue(true) end
    if Toggles.FpsShadows   then Toggles.FpsShadows:SetValue(true)   end
    if Toggles.FpsPostFx    then Toggles.FpsPostFx:SetValue(true)    end
    if Toggles.FpsDecor     then Toggles.FpsDecor:SetValue(true)     end
    if Toggles.FpsLowGfx    then Toggles.FpsLowGfx:SetValue(true)    end
    if Toggles.FpsUnlocker  then Toggles.FpsUnlocker:SetValue(true)  end
    if Toggles.FpsNoSound   then Toggles.FpsNoSound:SetValue(true)   end
    if Toggles.FpsNoAtmo    then Toggles.FpsNoAtmo:SetValue(true)    end
    if Toggles.FpsNoAcc     then Toggles.FpsNoAcc:SetValue(true)     end
    if Toggles.FpsLowMesh   then Toggles.FpsLowMesh:SetValue(true)   end
end)

FpsG:AddButton("Reset FPS Boost", function()
    setParticles(true)
    setShadows(true)
    setPostFx(true)
    setDecor(true)
    setLowGfx(false)
    setNoSound(false)
    setNoAtmosphere(false)
    setNoAccessories(false)
    setLowMesh(false)
    setFpsCap(60)
    if Toggles.FpsParticles then Toggles.FpsParticles:SetValue(false) end
    if Toggles.FpsShadows   then Toggles.FpsShadows:SetValue(false)   end
    if Toggles.FpsPostFx    then Toggles.FpsPostFx:SetValue(false)    end
    if Toggles.FpsDecor     then Toggles.FpsDecor:SetValue(false)     end
    if Toggles.FpsLowGfx    then Toggles.FpsLowGfx:SetValue(false)    end
    if Toggles.FpsUnlocker  then Toggles.FpsUnlocker:SetValue(false)  end
    if Toggles.FpsNoSound   then Toggles.FpsNoSound:SetValue(false)   end
    if Toggles.FpsNoAtmo    then Toggles.FpsNoAtmo:SetValue(false)    end
    if Toggles.FpsNoAcc     then Toggles.FpsNoAcc:SetValue(false)     end
    if Toggles.FpsLowMesh   then Toggles.FpsLowMesh:SetValue(false)   end
end)

end -- FPS Boost scope

-- ═══════════════════════════════════════════════════════════════
--  UNCODE v1 ·  Config Save / Load
-- ═══════════════════════════════════════════════════════════════
do -- Config Save scope
local _cfgPath  = "uncode_config.json"
local _cfgL = Tabs.Save:AddLeftGroupbox("Config Save / Load")
local _cfgR = Tabs.Save:AddRightGroupbox("Config Info")

local function _cfgCollect()
    local data = {}
    if Toggles then
        for k, v in pairs(Toggles) do
            pcall(function() data["T:"..k] = v.Value end)
        end
    end
    if Options then
        for k, v in pairs(Options) do
            pcall(function() data["O:"..k] = v.Value end)
        end
    end
    return data
end

_cfgL:AddButton("Save Config", function()
    pcall(function()
        local data = _cfgCollect()
        local json = game:GetService("HttpService"):JSONEncode(data)
        if writefile then
            writefile(_cfgPath, json)
            Notification.new({ Title="Saved",
                Content=_cfgPath.." written", Duration=3 })
        else
            Notification.new({ Title="Save Failed",
                Content="writefile not supported", Duration=3 })
        end
    end)
end)

_cfgL:AddButton("Load Config", function()
    pcall(function()
        if not readfile then
            Notification.new({ Title="Load Failed",
                Content="readfile not supported", Duration=3 })
            return
        end
        local ok, json = pcall(readfile, _cfgPath)
        if not ok or not json then
            Notification.new({ Title="No File",
                Content=_cfgPath.." not found", Duration=3 })
            return
        end
        local data = game:GetService("HttpService"):JSONDecode(json)
        local count = 0
        for key, val in pairs(data) do
            local prefix = key:sub(1,2)
            local id     = key:sub(3)
            if prefix == "T:" and Toggles and Toggles[id] then
                pcall(function() Toggles[id]:SetValue(val) end); count = count + 1
            elseif prefix == "O:" and Options and Options[id] then
                pcall(function() Options[id]:SetValue(val) end); count = count + 1
            end
        end
        Notification.new({ Title="Loaded",
            Content=count.." settings restored", Duration=3 })
    end)
end)

_cfgR:AddLabel("File: ".._cfgPath)
_cfgR:AddLabel("Location: exploit folder")
end -- Config Save scope

-- ═══════════════════════════════════════════════════════════════
--  UNCODE v1 ·  Auto Update Checker
-- ═══════════════════════════════════════════════════════════════
do -- Auto Update scope
local _updCFG   = { enabled=false, checkedOnce=false }
local _updBuild = "20261009-h"
local _updUrl   = "https://raw.githubusercontent.com/57040suda-haruki-cloud/p1/main/version.txt"
local UpdL = Tabs.Save:AddLeftGroupbox("Auto Update Checker")

UpdL:AddToggle("AutoUpdateEnabled", { Text="Check Update on Load", Default=false,
    Tooltip="Compare with latest version on GitHub",
    Callback = function(v)
        _updCFG.enabled = v
    end })
UpdL:AddButton("Check Now", function()
    pcall(function()
        local HS = game:GetService("HttpService")
        local ok, body = pcall(function()
            return HS:GetAsync(_updUrl, true)
        end)
        if ok and body then
            local latest = body:match("^%s*(.-)%s*$")
            if latest == _updBuild then
                Notification.new({ Title="Up to date",
                    Content="Current build: ".._updBuild, Duration=4 })
            else
                Notification.new({ Title="Update Available",
                    Content="Latest: "..latest.." / "
                        .."Current: ".._updBuild, Duration=6 })
            end
        else
            Notification.new({ Title="Check Failed",
                Content="GitHub connection error", Duration=3 })
        end
    end)
end)

task.delay(3, function()
    if _updCFG.enabled and not _updCFG.checkedOnce then
        _updCFG.checkedOnce = true
        pcall(function()
            local HS = game:GetService("HttpService")
            local body = HS:GetAsync(_updUrl, true)
            local latest = body:match("^%s*(.-)%s*$")
            if latest ~= _updBuild then
                Notification.new({ Title="Update Available",
                    Content="Latest: "..latest, Duration=6 })
            end
        end)
    end
end)
end -- Auto Update scope

-- ═══════════════════════════════════════════════════════════════
--  UNCODE v1 ·  UI Color Theme
-- ═══════════════════════════════════════════════════════════════
do -- UI Color Theme scope
local _themeCFG = { current="Default" }
local _themes   = {
    Default  = { accent=Color3.fromRGB(100,160,255), bg=Color3.fromRGB(20,20,30) },
    Crimson  = { accent=Color3.fromRGB(220,50,50),   bg=Color3.fromRGB(25,10,10) },
    Emerald  = { accent=Color3.fromRGB(50,200,100),  bg=Color3.fromRGB(10,25,15) },
    Gold     = { accent=Color3.fromRGB(255,200,50),  bg=Color3.fromRGB(25,20,5)  },
    Neon     = { accent=Color3.fromRGB(0,255,220),   bg=Color3.fromRGB(5,20,25)  },
    Midnight = { accent=Color3.fromRGB(160,90,255),  bg=Color3.fromRGB(15,5,30)  },
}
local ThemeL = Tabs.UI:AddLeftGroupbox("UI Color Theme")
local ThemeR = Tabs.UI:AddRightGroupbox("Theme Config")

end
local function _applyTheme(name)
    local t = _themes[name]
    if not t then return end
    _themeCFG.current = name
    pcall(function()
        if _mlLib and _mlLib.SetAccent then
            _mlLib:SetAccent(t.accent)
        end
        for _, gui in ipairs(game:GetService("CoreGui"):GetDescendants()) do
            if gui:IsA("UIStroke") and gui.Name:find("UNC") then
                gui.Color = t.accent
            end
        end
        Notification.new({ Title="Theme Changed",
            Content=name, Duration=2 })
    end)
end

ThemeL:AddDropdown("UIThemeSelect", { Text="Select Theme",
    Values={"Default","Crimson","Emerald","Gold","Neon","Midnight"}, Default=1,
    Callback = function(v) _applyTheme(v) end })
ThemeL:AddToggle("UIThemeRainbow", { Text="Rainbow UI", Default=false,
    Callback = function(v)
        if v then
            task.spawn(function()
                while Toggles.UIThemeRainbow and Toggles.UIThemeRainbow.Value do
                    local hue = (tick() * 0.2) % 1
                    pcall(function()
                        if _mlLib and _mlLib.SetAccent then
                            _mlLib:SetAccent(Color3.fromHSV(hue, 1, 1))
                        end
                    end)
                    task.wait(0.05)
                end
            end)
        end
    end })
ThemeR:AddColorpicker("UIThemeAccent", { Text="Accent Color",
    Default=Color3.fromRGB(100,160,255),
    Callback = function(v)
        pcall(function()
            if _mlLib and _mlLib.SetAccent then _mlLib:SetAccent(v) end
        end)
    end })
end)()  -- close L74802 UI Settings + Settings sections wrapper (theme boundary)

-- ── Community Configs ──────────────────────────────────────────────────────
;(function()  -- fresh 200-register pool: Community Configs
local CfgG = Tabs.Save:AddLeftGroupbox("Community Configs")

-- NeverLose build: _T / _O use _FlagCb registry (defined at top scope)
local function _T(id, v) if _FlagCb[id] then pcall(_FlagCb[id], v) end end
local function _O(id, v) _T(id, v) end

CfgG:AddButton("Load Legit Config", function()
    -- Silent Aim
    _T("SaEnabled", true)   _O("SaFov", 60)   _T("SaManipulate", false)
    _T("SaVisible", true)   _T("SaVulnerable", true)   _T("SaWithinFov", true)   _T("SaNotReloading", true)

-- UNCODE Combat Feedback (Kicia PlayerHit / PlayerElimination)
-- ═══════════════════════════════════════════════════════════════
task.spawn(function()
    -- Wait for KiciaStore to be exported by the loadstring block above
    repeat task.wait(0.25) until getgenv()._UNC_KiciaStore
    local _ks = getgenv()._UNC_KiciaStore
    -- Kill feedback: enable sound (CoD) + flash + notification
    _ks:Set({"PlayerElimination","Enabled"}, true)
    _ks:Set({"PlayerElimination","Sound","Enabled"}, true)
    _ks:Set({"PlayerElimination","Sound","Name"}, "CoD")
    _ks:Set({"PlayerElimination","Sound","Volume"}, 0.7)
    _ks:Set({"PlayerElimination","Sound","Pitch"}, 1.0)
    _ks:Set({"PlayerElimination","KillFlash","Enabled"}, true)
    _ks:Set({"PlayerElimination","KillFlash","Color"}, Color3.fromRGB(255, 60, 60))
    _ks:Set({"PlayerElimination","KillFlash","Duration"}, 1.35)
    _ks:Set({"PlayerElimination","Notification","Enabled"}, false)
    _ks:Set({"PlayerElimination","Notification","Text"}, "Eliminated %DNAME% (%NAME%)")
    -- Hit feedback: enable sound (TF2 head / Ding body) + flash
    _ks:Set({"PlayerHit","Enabled"}, true)
    _ks:Set({"PlayerHit","Sound","Enabled"}, true)
    _ks:Set({"PlayerHit","Sound","HeadName"}, "TF2 HitSound")
    _ks:Set({"PlayerHit","Sound","BodyName"}, "Ding")
    _ks:Set({"PlayerHit","Sound","HeadVolume"}, 0.6)
    _ks:Set({"PlayerHit","Sound","BodyVolume"}, 0.4)
    _ks:Set({"PlayerHit","Sound","HeadPitch"}, 1.0)
    _ks:Set({"PlayerHit","Sound","BodyPitch"}, 1.0)
    _ks:Set({"PlayerHit","HitFlash","Enabled"}, true)
    _ks:Set({"PlayerHit","HitFlash","Color"}, Color3.fromRGB(90, 170, 255))
    _ks:Set({"PlayerHit","HitFlash","Duration"}, 1.35)
    _ks:Set({"PlayerHit","Notification","Enabled"}, false)
    -- Startup notification via Kicia NotificationCenter
    local _nc = getgenv()._UNC_KiciaNotify
    if _nc then
        pcall(function()
            _nc.get():Notify(
                {{Text = "UNCODE", Accent = true}, {Text = " v1  ready"}},
                {Color = Color3.fromRGB(0, 200, 255), Duration = 5}
            )
        end)
    end
end)


local function SetSkinStatus(txt)
	if SkinStatus and SkinStatus.Parent then
		pcall(function() SkinStatus.Text = txt end)
	end
end
local function RefreshQueue()
	local q = queue_on_teleport or queueonteleport
	if type(q) ~= "function" then return end
	pcall(function()
		local parts = {}
		if Config.Viewmodel.UnlockAll and Config.Viewmodel.UnlockPersist then table.insert(parts, UNLOCK_SRC) end
		if Config.Viewmodel.OverrideEnabled and Config.Viewmodel.UnlockPersist then table.insert(parts, OVERRIDE_SRC) end
		if #parts > 0 then q(table.concat(parts, "\n--rv--\n"))
		else q("-- rv off") end
	end)
end
-- hook thang vao cho game dung sung: moc vao luc bat override, doc config truc tiep
local OverrideStatus = nil
local OVERRIDE_SRC = [==[
local Players = game:GetService("Players")
local player = Players.LocalPlayer
if not player then return "no player" end
local G = getgenv()
local RV = G.RV_OvHook
if type(RV) ~= "table" then RV = {} G.RV_OvHook = RV end
local ps = player:FindFirstChild("PlayerScripts")
local vmMod, okF = nil, false
if ps then
  okF, vmMod = pcall(function()
    return ps.Modules.ClientReplicatedClasses.ClientFighter.ClientItem:FindFirstChild("ClientViewModel")
  end)
end
if not okF or not vmMod then
  local okW = false
  okW, vmMod = pcall(function()
    return ps:WaitForChild("Modules", 5).ClientReplicatedClasses.ClientFighter.ClientItem:WaitForChild("ClientViewModel", 5)
  end)
  if not okW or not vmMod then return "no CVM module" end
end
local CVM = require(vmMod)
if RV.installed and RV.cvm == CVM then return "already on" end
RV.cvm = CVM
local function t01(x) return math.clamp(tonumber(x) or 0, 0, 100) / 100 * 0.9 end
local function stampModel(model, vm)
  if typeof(model) ~= "Instance" then return end
  local ok, desc = pcall(function() return model:GetDescendants() end)
  if not ok or type(desc) ~= "table" then return end
  for _, d in pairs(desc) do
    if d:IsA("BasePart") then
      local arm = (d.Name == "LeftArm" or d.Name == "RightArm")
      pcall(function()
        if not d:GetAttribute("RV_OInit") then
          d:SetAttribute("RV_OInit", true)
          d:SetAttribute("RV_OColor", d.Color)
          d:SetAttribute("RV_OMat", tostring(d.Material))
          d:SetAttribute("RV_OTrans", d.Transparency)
        end
        if arm then
          d.Color = vm.ArmColor
          if Enum.Material[vm.ArmMaterial] then d.Material = Enum.Material[vm.ArmMaterial] end
          d.Transparency = t01(vm.ArmTrans)
          local st = d:FindFirstChildOfClass("ShirtTexture")
          if st and vm.ArmNoClothes then
            if d:GetAttribute("RV_OShirtT") == nil then d:SetAttribute("RV_OShirtT", st.Transparency) end
            st.Transparency = 1
          end
        else
          if d:GetAttribute("IgnoreTransparency") then return end
          d.Color = vm.VMColor
          if Enum.Material[vm.VMMaterial] then d.Material = Enum.Material[vm.VMMaterial] end
          if vm.VMWireframe then
            d.Transparency = 1
            local w = d:FindFirstChild("RV_Wire")
            if not (w and w:IsA("WireframeHandleAdornment")) then
              if w then w:Destroy() end
              pcall(function()
                local x = Instance.new("WireframeHandleAdornment")
                x.Name = "RV_Wire" x.Adornee = d
                x.Color3 = vm.VMColor x.Transparency = 0
                x.AlwaysOnTop = true
                x.Parent = d
              end)
            else
              pcall(function() w.Color3 = vm.VMColor w.Transparency = 0 end)
            end
          else
            d.Transparency = t01(vm.VMTrans)
            local w = d:FindFirstChild("RV_Wire")
            if w then w:Destroy() end
          end
          if vm.VMNoTextures then
            for _, ch in pairs(d:GetChildren()) do
              if ch:IsA("Texture") or ch:IsA("Decal") or ch:IsA("SurfaceAppearance") then
                pcall(function() ch.Transparency = 1 end)
              end
            end
          end
        end
        d:SetAttribute("RV_Overridden", true)
        d:SetAttribute("RV_OvApplied", "hook")
      end)
    end
  end
end
local curNew = CVM.new
CVM.new = function(replicatedData, clientItem)
  local result = curNew(replicatedData, clientItem)
  pcall(function()
    local cfg = G.RivalsVisuals_Config
    local vm = cfg and cfg.Viewmodel
    if not (vm and vm.OverrideEnabled) then return end
    local wplayer = clientItem and clientItem.ClientFighter and clientItem.ClientFighter.Player
    if wplayer ~= player then return end
    if result.Model then stampModel(result.Model, vm) end
    if result.ItemModel then stampModel(result.ItemModel, vm) end
  end)
  return result
end
RV.installed = true
return "hook OK"
]==]
local function SetOverrideStatus(txt)
	if OverrideStatus and OverrideStatus.Parent then
		pcall(function() OverrideStatus.Text = txt end)
	end
end
-- loop rieng 4Hz cho viewmodel (game rebuild viewmodel lien tuc khi doi sung/round)
Bind(RunService.Heartbeat:Connect(function()
	if State.Destroyed then return end
	local now = os.clock()
	if now - State.LastVM < 0.25 then return end
	State.LastVM = now
	-- tat override + sach se roi thi nghi han, khoi quet camera/PlayerGui ton FPS
	if not Config.Viewmodel.OverrideEnabled and not State.VMDirty then
		if now - (State.LastVMStatus or 0) > 1 then
			State.LastVMStatus = now
			SetOverrideStatus("override: OFF")
		end
		return
	end
	pcall(ApplyViewmodelOverride)
	if now - (State.LastVMStatus or 0) > 1 then
		State.LastVMStatus = now
		if Config.Viewmodel.OverrideEnabled then
			local c = State.VMCounts
			if c then SetOverrideStatus("override: " .. c.w .. " sung + " .. c.a .. " tay") end
		else
			SetOverrideStatus("override: OFF")
		end
	end
end))

--// ============ TRACERS (hinh 1 trai) ============
local function SpawnTracer(fromPos, toPos)
	if not Config.Tracers.Enabled then return end
	local now = os.clock()
	-- rate limit + pool cap: khong cho spam part gay crash
	if now - State.TracerLast < 0.03 then return end
	State.TracerLast = now
	State.TracerN = State.TracerN + 1
	local life = math.clamp(Config.Tracers.Lifetime, 0.05, 2)
	local fade = math.clamp(Config.Tracers.Fade, 0.05, 2)
	-- Speed dieu khien toc do fade, Length tang do day, Emission cong them do sang, PosLerp rut ngan tia
	local speedMul = 5 / math.max(Config.Tracers.Speed, 0.5)
	fade = math.clamp(fade * speedMul, 0.05, 3)
	local lerpK = math.clamp(Config.Tracers.PosLerp, 0, 1) * 0.15
	toPos = fromPos:Lerp(toPos, 1 - lerpK)
	-- style selected doi hanh vi That (trail manh dai, beam to, glow sang, energy pulse nhe)
	local styleW, styleE = 1, 0
	local st = Config.Tracers.Selected
	if st == "beam" then styleW = 1.5
	elseif st == "trail" then styleW = 0.7
	elseif st == "glow" then styleE = 3
	elseif st == "energy" then styleW = 1.1 styleE = 1.5 end
	local wBase = 0.25 * Config.Tracers.Size * (0.6 + Config.Tracers.Length / 4) * styleW
	if #State.TracerPool >= 30 then
		local old = table.remove(State.TracerPool, 1)
		pcall(function() if old and old.Parent then old:Destroy() end end)
	end
	local holder = New("Part", { Anchored = true, CanCollide = false, CanQuery = false, CanTouch = false, Transparency = 1, Size = Vector3.new(0.5, 0.5, 0.5), CFrame = CFrame.new(fromPos), Name = "RV_Trace" }, Workspace)
	table.insert(State.TracerPool, holder)
	local a0 = New("Attachment", { Position = Vector3.new(0, 0, 0) }, holder)
	local a1 = New("Attachment", { Position = Vector3.new(0, 0, 0) }, holder)
	pcall(function() a1.WorldPosition = toPos end)
	-- mau outline (2 o mau) lam gradient beam; outline cong them vien
	local c1 = Config.Tracers.OC1 or Color3.fromRGB(140, 90, 255)
	local c2 = Config.Tracers.OC2 or Color3.fromRGB(80, 150, 255)
	local beam = New("Beam", {
		Attachment0 = a0, Attachment1 = a1,
		Color = ColorSequence.new({ ColorSequenceKeypoint.new(0, c1), ColorSequenceKeypoint.new(1, c2) }),
		Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(1, 0) }),
		Width0 = wBase, Width1 = wBase,
		LightEmission = math.clamp(Config.Tracers.Glow + Config.Tracers.Emission + styleE, 0, 10), LightInfluence = 0,
		FaceCamera = true,
	}, holder)
	if Config.Tracers.Outline then
		beam.Width0 = beam.Width0 + 0.15 beam.Width1 = beam.Width1 + 0.15
	end
	task.spawn(function()
		local t = 0
		while t < fade and beam.Parent do
			t = t + task.wait()
			pcall(function() beam.Transparency = NumberSequence.new(t / fade) end)
		end
		pcall(function() holder:Destroy() end)
	end)
	Debris:AddItem(holder, life + fade + 0.5)
end
-- auto tracer khi ban: dung Tool.Activated + camera ray

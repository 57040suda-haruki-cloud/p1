local function _addQbEntry(gb, ddId, label, flagId, defaultKey)
    gb:AddDropdown(ddId, {
        Text    = label,
        Default = defaultKey or "None",
        Values  = _QB_KEY_LIST,
        Tooltip = "Select key from list, or use [Change Key] to bind any key.",
        Callback = function(v) _qbSetKey(flagId, v) end,
    })
    gb:AddDropdown(ddId.."_Mode", {
        Text    = label .. " Mode",
        Default = "Toggle",
        Values  = {"Toggle","Hold","Always"},
        Tooltip = "Toggle=press to flip on/off  Hold=active while held  Always=always on",
        Callback = function(v)
            _qbMode[flagId] = v
            if v == "Always" then
                _qbState[flagId] = true
                pcall(_T, flagId, true)
                pcall(_O, flagId, true)
            end
        end,
    })
    gb:AddButton("Change Key: "..label, function()
        if _G._UNC_QbStartListen then _G._UNC_QbStartListen(flagId) end
    end)
end

_addQbEntry(QBL, "QbKeyEsp",       "Player ESP",      "EspEnabled",     "None")
_addQbEntry(QBL, "QbKeyVoid",      "Void",            "VoidToggle",     "None")
_addQbEntry(QBL, "QbKeyOrbit",     "Orbit",           "OrbitToggle",    "None")
_addQbEntry(QBL, "QbKeyPred",      "Prediction V2",   "PredToggle",     "None")
_addQbEntry(QBL, "QbKeyBhop",      "Bhop",            "BhopEnabled",    "None")
_addQbEntry(QBL, "QbKeyWireframe", "Wireframe ESP",   "WireframeEnabled","None")

_addQbEntry(QBR, "QbKeyAntiBait",  "Anti-Bait V2",    "AntiBaitToggle", "None")
_addQbEntry(QBR, "QbKeySling",     "Sling Bypass",    "SlingToggle",    "None")
_addQbEntry(QBR, "QbKeyAa",        "Anti-Aim",        "AaToggle",       "None")
_addQbEntry(QBR, "QbKeyEnemyInfo", "Enemy Info",      "EnemyInfoEnabled","None")
_addQbEntry(QBR, "QbKeyUaa",       "Underground AA",  "UaaEnabled",     "None")
_addQbEntry(QBR, "QbKeyRtrap",     "Rage Trap",       "RtEnabled",      "None")

QBR:AddButton(" Show Current Binds", function()
    local lines = {}
    for flagId, dispKey in pairs(_qbKeyDisplay) do
        if dispKey and dispKey ~= "None" then
            local lbl = _qbLabels[flagId] or flagId
            local st  = _qbState[flagId] and "ON" or "—"
            table.insert(lines, string.format("[%s] %s (%s)", dispKey, lbl, st))
        end
    end
    table.sort(lines)
    local content = #lines > 0 and table.concat(lines, "\n") or "No binds set"
    Notification.new({
        Title   = "Keybind List",
        Content = content,
        Duration = 6,
    })
end)


-- COLORED MODELS
do
	local L = State["models_L"] local R = State["models_R"]
	local g = Group(L, "Colored models")
	Label(g, "unlock")
	Toggle(g, "unlock all (skin/charm/wrap/dance)", function() return Config.Viewmodel.UnlockAll end, function(v)
		Config.Viewmodel.UnlockAll = v
		if v then
			SetSkinStatus("dang cai unlock...")
			task.spawn(function()
				local fn, lerr = loadstring(UNLOCK_SRC, "RVUnlock")
				if not fn then
					SetSkinStatus("loi nap unlock")
					return
				end
				local ok, res = pcall(fn)
				if ok then
					SetSkinStatus("unlock: ON (" .. tostring(res) .. ")")
				else
					SetSkinStatus("unlock loi, thu lai")
				end
				RefreshQueue()
			end)
		else
			local U = getgenv().RV_Unlock
			if type(U) == "table" then U.active = false end
			SetSkinStatus("unlock: OFF")
			RefreshQueue()
		end
	end)
	Toggle(g, "giu sau teleport", function() return Config.Viewmodel.UnlockPersist end, function(v)
		Config.Viewmodel.UnlockPersist = v
		RefreshQueue()
		SetSkinStatus(v and "se tu bat lai sau teleport" or ("unlock: " .. (Config.Viewmodel.UnlockAll and "ON" or "OFF")))
	end)
	Label(g, "bat unlock -> mo menu customize chon do")
	SkinStatus = Label(g, "unlock: OFF")
	Label(g, "viewmodel")
	Toggle(g, "enable override", function() return Config.Viewmodel.OverrideEnabled end, function(v)
		Config.Viewmodel.OverrideEnabled = v
		if v then
			SetOverrideStatus("dang moc viewmodel...")
			task.spawn(function()
				local fn = loadstring(OVERRIDE_SRC, "RVOv")
				if not fn then SetOverrideStatus("loi nap hook") return end
				local ok, res = pcall(fn)
				SetOverrideStatus(ok and ("hook: " .. tostring(res)) or "hook loi (dung loop)")
				RefreshQueue()
			end)
		else
			pcall(ApplyViewmodelOverride)
			RefreshQueue()
		end
	end)
	OverrideStatus = Label(g, "override: OFF")
	Label(g, "viewmodel appearance")
	ColorRow(g, "color", function() return Config.Viewmodel.VMColor end, function(v) Config.Viewmodel.VMColor = v end)
	Label(g, "material")
	Drop(g, "material", VM_MATS, function() return Config.Viewmodel.VMMaterial end, function(v) Config.Viewmodel.VMMaterial = v end)
	Toggle(g, "wireframe", function() return Config.Viewmodel.VMWireframe end, function(v) Config.Viewmodel.VMWireframe = v end)
	Toggle(g, "disable textures", function() return Config.Viewmodel.VMNoTextures end, function(v) Config.Viewmodel.VMNoTextures = v end)
	Slider(g, "transparency: %s", 0, 100, function() return Config.Viewmodel.VMTrans end, function(v) Config.Viewmodel.VMTrans = v end, "%")
	Label(g, "arm appearance")
	ColorRow(g, "color", function() return Config.Viewmodel.ArmColor end, function(v) Config.Viewmodel.ArmColor = v end)
	Label(g, "material")
	Drop(g, "material", VM_MATS, function() return Config.Viewmodel.ArmMaterial end, function(v) Config.Viewmodel.ArmMaterial = v end)
	Toggle(g, "disable clothes", function() return Config.Viewmodel.ArmNoClothes end, function(v) Config.Viewmodel.ArmNoClothes = v end)
	Slider(g, "transparency: %s", 0, 100, function() return Config.Viewmodel.ArmTrans end, function(v) Config.Viewmodel.ArmTrans = v end, "%")
	Toggle(g, "override fps", function() return Config.Viewmodel.OverrideFPS end, function(v) Config.Viewmodel.OverrideFPS = v end)
	Slider(g, "fps: %s", 10, 240, function() return Config.Viewmodel.FPS end, function(v) Config.Viewmodel.FPS = math.floor(v) end, "x")
	Slider(g, "recoil percent: %s", 0, 200, function() return Config.Viewmodel.Recoil end, function(v) Config.Viewmodel.Recoil = v end, "%")

	local a = Group(R, "Appearance")
	Toggle(a, "enabled", function() return Config.Appearance.Enabled end, function(v) Config.Appearance.Enabled = v if v then ApplyAppearance() end end)
	ColorRow(a, "color", function() return Config.Appearance.Color end, function(v) Config.Appearance.Color = v if Config.Appearance.Enabled then ApplyAppearance() end end)
	Drop(a, "material", { "ForceField", "Neon", "Glass", "SmoothPlastic", "Metal" }, function() return Config.Appearance.Material end, function(v) Config.Appearance.Material = v end)
	Drop(a, "disable", { "decals, clothing", "none", "all" }, function() return "decals, clothing" end, function(v) Config.Appearance.NoDecal = (v ~= "none") end)
	Slider(a, "transparency: %s", 0, 100, function() return Config.Appearance.Transparency end, function(v) Config.Appearance.Transparency = v if Config.Appearance.Enabled then ApplyAppearance() end end, "%")
	Toggle(a, "aura", function() return Config.Appearance.Aura end, function(v) Config.Appearance.Aura = v end)
	Drop(a, "aura", { "angel", "demon", "ring", "wings" }, function() return Config.Appearance.AuraType end, function(v) Config.Appearance.AuraType = v end)

	local au = Group(R, "Aura")
	Toggle(au, "aura enabled", function() return Config.Aura.Enabled end, function(v) Config.Aura.Enabled = v if v then BuildAura(GetChar()) else ClearAura() end end)
	Toggle(au, "rgb cycle", function() return Config.Aura.RGB end, function(v) Config.Aura.RGB = v end)
	Drop(au, "aura mode", { "Cyber Blue", "Blood Red", "Venom Green", "Royal Purple", "Sun God", "Shadow" }, function() return Config.Aura.Mode end, function(v) Config.Aura.Mode = v BuildAura(GetChar()) end)
	Slider(au, "intensity: %s", 0.3, 2, function() return Config.Aura.Intensity end, function(v) Config.Aura.Intensity = v BuildAura(GetChar()) end, "")
	Slider(au, "size: %s", 0.6, 1.8, function() return Config.Aura.Size end, function(v) Config.Aura.Size = v BuildAura(GetChar()) end, "")

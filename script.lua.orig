    _uaaCFG.enabled = v
    if v then _uaaStart() else _uaaStop() end
end)

-- ── Resolver ────────────────────────────────────────────────────────────
local _rsvCFG = {
    enabled   = false,
    method    = "Delta",
    static    = 0,
    bruteStep = 45,
    log       = false,
    _bruteYaw = 0,
}
local _rsvHits  = {}  -- [player_name] → {[yaw_bucket] → {hits,total}}

local function _rsvGetBestYaw(plrName)
    local d = _rsvHits[plrName]
    if not d then return 0 end
    local best, bestRate = 0, -1
    for _, info in pairs(d) do
        if type(info) == "table" then
            local rate = (info.hits or 0) / math.max(1, info.total or 1)
            if rate > bestRate then bestRate = rate; best = info.yaw or 0 end
        end
    end
    return best
end

-- Public API: returns yaw offset (degrees) to add when aiming at plrName
function _G._UNC_ResolveYaw(plrName)
    if not _rsvCFG.enabled then return 0 end
    if _rsvCFG.method == "Static" then
        return _rsvCFG.static
    elseif _rsvCFG.method == "Brute Force" then
        _rsvCFG._bruteYaw = (_rsvCFG._bruteYaw + _rsvCFG.bruteStep) % 360
        return _rsvCFG._bruteYaw
    elseif _rsvCFG.method == "Delta" then
        return _rsvGetBestYaw(plrName)
    end
    return 0
end

-- Public API: record hit feedback (call on hit confirmation)
function _G._UNC_ResolverHit(plrName, yaw, hit)
    if not _rsvCFG.enabled or _rsvCFG.method ~= "Delta" then return end
    if not _rsvHits[plrName] then _rsvHits[plrName] = {} end
    local bucket = tostring(math.floor(yaw / 10) * 10)
    if not _rsvHits[plrName][bucket] then
        _rsvHits[plrName][bucket] = { yaw=yaw, hits=0, total=0 }
    end
    _rsvHits[plrName][bucket].total = _rsvHits[plrName][bucket].total + 1
    if hit then _rsvHits[plrName][bucket].hits = _rsvHits[plrName][bucket].hits + 1 end
    if _rsvCFG.log and hit then
        Notification.new({ Title="Resolver", Content="HIT "..plrName.." @"..math.floor(yaw).."°", Duration=1 })
    end
end

_URVL:AddToggle("RsvEnabled", {
    Text    = "Resolver",
    Default = false,
    Tooltip = "Attempts to resolve enemy Anti-Aim for better hit registration.",
    Callback = function(v) _rsvCFG.enabled = v end,
})
_URVL:AddDropdown("RsvMethod", {
    Text    = "Resolver Method",
    Values  = {"Delta","Brute Force","Static"},
    Default = "Delta",
    Tooltip = "Delta=per-player learning | Brute=cycle angles | Static=fixed offset",
    Callback = function(v) _rsvCFG.method = v end,
})
_URVL:AddToggle("RsvLog", {
    Text    = "Log Hits",

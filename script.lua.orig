New("TextLabel", { Size = UDim2.new(1, -12, 0, 14), Position = UDim2.new(0, 6, 1, -16), BackgroundTransparency = 1, Font = Enum.Font.Code, TextSize = 11, TextColor3 = C_DIM, Text = "rightshift: an/hien  |  v3 dark", TextXAlignment = Enum.TextXAlignment.Left }, Main)

--// API
local API = {}
function API:Destroy()
	State.Destroyed = true
	State.SliderActive = nil
	for _, c in pairs(State.Conns) do pcall(function() if typeof(c) == "RBXScriptConnection" then c:Disconnect() end end) end
	for _, c in pairs(State.DmgConns) do pcall(function() if typeof(c) == "RBXScriptConnection" then c:Disconnect() end end) end
	table.clear(State.DmgConns)
	for _, h in pairs(State.TracerPool) do pcall(function() if h and h.Parent then h:Destroy() end end) end
	table.clear(State.TracerPool)
	pcall(ClearAura) pcall(RestoreWorld)
	for _, v in pairs(State.ESPGui) do pcall(function() if typeof(v) == "Instance" and v.Parent then v:Destroy() end end) end
	table.clear(State.ESPGui)
	table.clear(hooked)
	pcall(function() gui:Destroy() end)
	pcall(function() visGui:Destroy() end)
	pcall(function() crossGui:Destroy() end)
	getgenv().RivalsVisuals_API = nil
end
getgenv().RivalsVisuals_API = API
getgenv().RivalsVisuals_Config = Config
-- debug console cho test truc tiep trong game (chi doc/goi engine, khong anh huong gameplay)
getgenv().RV_Test = {
	config = Config,
	applyWorld = function() pcall(ApplyWorld) return true end,
	aura = function() local c = GetChar() if c then BuildAura(c) return true end return false end,
	tracer = function()
		local cam = Workspace.CurrentCamera
		if not cam then return "nocam" end
		local o = cam.CFrame.Position
		SpawnTracer((cam.CFrame * CFrame.new(0.45, -0.35, -1.5)).Position, o + cam.CFrame.LookVector * 200)
		return "pool:" .. (#State.TracerPool)
	end,
	override = function()
		Config.Viewmodel.OverrideEnabled = true
		pcall(ApplyViewmodelOverride)
		local c = State.VMCounts
		return c and (c.w .. " sung + " .. c.a .. " tay") or "none"
	end,
	overrideOff = function()
		Config.Viewmodel.OverrideEnabled = false
		State.VMDirty = true
		pcall(ApplyViewmodelOverride)
		return "off"
	end,
	unlock = function()
		local fn = loadstring(UNLOCK_SRC, "RVUnlock")
		if not fn then return "loadstring loi" end
		local ok, res = pcall(fn)
		return ok and tostring(res) or "unlock loi"
	end,
	ovhook = function()
		local fn = loadstring(OVERRIDE_SRC, "RVOv")
		if not fn then return "loadstring loi" end
		local ok, res = pcall(fn)
		return ok and tostring(res) or "hook loi"
	end,
	owns = function(name)
		local ok, r = pcall(function()
			local CosLib = require(game:GetService("ReplicatedStorage").Modules.CosmeticLibrary)
			return CosLib:OwnsCosmetic(nil, name, nil)
		end)
		return ok and tostring(r) or "err"
	end,
}

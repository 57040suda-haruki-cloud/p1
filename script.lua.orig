	Slider(g3, "rotation: %s", 0, 300, function() return Config.Crosshair.RotSpeed end, function(v) Config.Crosshair.RotSpeed = math.floor(v) end, "")
	do
		local r = Row(g3, 14)
		for i = 1, 4 do
			local cc = ({ Config.Crosshair.C1, Config.Crosshair.C2, Config.Crosshair.C3, Config.Crosshair.C4 })[i]
			local b = New("TextButton", { Size = UDim2.new(0, 40, 0, 12), Position = UDim2.new(0, (i - 1) * 46, 0, 1), BackgroundColor3 = cc, Text = "", BorderSizePixel = 0 }, r)
			b.MouseButton1Click:Connect(function()
				local n = b.BackgroundColor3 == Color3.fromRGB(255,255,255) and C_GR or Color3.fromRGB(255,255,255)
				b.BackgroundColor3 = n
				if i == 1 then Config.Crosshair.C1 = n elseif i == 2 then Config.Crosshair.C2 = n elseif i == 3 then Config.Crosshair.C3 = n else Config.Crosshair.C4 = n end
			end)
		end
	end
	Toggle(g3, "disable game crosshair", function() return Config.Crosshair.DisableGame end, function(v)
		Config.Crosshair.DisableGame = v
		-- khong tat MouseIcon (se lam mat chuot). Chi thu an crosshair mac dinh cua Rivals neu tim thay.
		pcall(function()
			local pg = LocalPlayer:FindFirstChildOfClass("PlayerGui")
			if pg then
				for _, d in pairs(pg:GetDescendants()) do
					if d:IsA("GuiObject") and (d.Name:lower():find("cross") or d.Name:lower():find("crosshair")) then
						if v then d:SetAttribute("RV_Hidden", true) d.Visible = false end
					end
				end
			end
		end)
	end)
	Slider(g3, "gap: %s", 0, 20, function() return Config.Crosshair.Gap end, function(v) Config.Crosshair.Gap = v end, "")

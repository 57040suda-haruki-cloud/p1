;(function()
-- ── Reload guard: skip if already running (prevents double-load lag) ──
if getgenv()._UNC_RUNNING then
    warn("[UNCODE] Already loaded — rejoin or run _UNC_UNLOAD() first")
    return
end
getgenv()._UNC_RUNNING = true
-- ╔═══════════════════════════════════════════════════════════════════════╗
-- ║  UNCODE v1 — Linoria UI  (build 20261017)                           ║
-- ╚═══════════════════════════════════════════════════════════════════════╝
local _lnRepo = "https://raw.githubusercontent.com/xyznick/UELinoriaLib/main/"
local Library      = loadstring(game:HttpGet(_lnRepo .. "Library.lua"))()
local ThemeManager = loadstring(game:HttpGet(_lnRepo .. "addons/ThemeManager.lua"))()
local SaveManager  = loadstring(game:HttpGet(_lnRepo .. "addons/SaveManager.lua"))()
warn("[UNCODE] Linoria loaded OK")

Library.ShowCustomCursor          = false
Library.NotifySide                = "Left"
Library.ShowToggleFrameInKeybinds = true

-- Snapshot PlayerGui before CreateWindow so we can inject UIScale into new ScreenGuis
local _lnPG = game:GetService("Players").LocalPlayer:WaitForChild("PlayerGui")
local _lnPGSnap = {}
for _, _sg in ipairs(_lnPG:GetChildren()) do
    if _sg:IsA("ScreenGui") then _lnPGSnap[_sg] = true end
end

local _lnWindow = Library:CreateWindow({
    Title                = "UNCODE  v1",
    Center               = true,
    AutoShow             = true,
    Resizable            = true,
    UnlockMouseWhileOpen = true,
    MenuFadeTime         = 0.2,
    TabPadding           = 8,
})
-- Menu toggle keybind: Left Shift
pcall(function()
    Library.ToggleKeybind = Enum.KeyCode.LeftShift
end)
warn("[UNCODE] window created OK")

-- Apply UIScale to new Linoria ScreenGui(s) (mobile / tablet support)
if _UNC_UI_SCALE ~= 1 then
    task.delay(0.5, function()
        pcall(function()
            for _, _sg in ipairs(_lnPG:GetChildren()) do
                if _sg:IsA("ScreenGui") and not _lnPGSnap[_sg]
                        and not _sg:FindFirstChildOfClass("UIScale") then
                    local _sc = Instance.new("UIScale")
                    _sc.Scale  = _UNC_UI_SCALE
                    _sc.Parent = _sg
                end
            end
        end)
    end)
end

getgenv()._UNC_UNLOAD = function()
    pcall(function() Library:Unload() end)
    getgenv()._UNC_RUNNING = false
    getgenv()._UNC_UNLOAD  = nil
    warn("[UNCODE] Unloaded — safe to re-run")
end

-- Compatibility shim: window.tab({name, tabs={}}) creates ONE Linoria sidebar
-- tab for the parent group (name) and returns that same tab object once per
-- sub-tab entry, so all sub-tab locals share a single sidebar tab.
-- Result: 7 sidebar tabs total (Main/World/ESP/Visual/HvH/Tools/Setting).
local window = {}
function window:tab(opts)
    local t = _lnWindow:AddTab(opts.name)   -- one tab per parent group only
    local refs = {}
    for _ in ipairs(opts.tabs or {}) do
        table.insert(refs, t)               -- every sub-tab slot gets the same tab
    end
    return table.unpack(refs)
end
function window:Destroy() pcall(function() Library:Unload() end) end
function window:GetStateData() return {} end
function window:SaveState() end

-- Accent shim (Linoria uses ThemeManager; no direct SetAccent API)
local _mlLib = {}
function _mlLib:SetAccent(_c) end
function _mlLib:init_config() end

-- Notification helper: delegates to Linoria built-in notification
local Notification = {}
Notification.new = function(opts)
    pcall(function()
        Library:Notify({
            Title       = opts.Title   or "UNCODE v1",
            Description = opts.Content or opts.Description or "",
            Time        = opts.Duration or opts.Time or 3,
        })
    end)
end
local Logging   = { log = function() end }
local Indicator = { Update = function() end }

-- Watermark stubs
local _WmPing  = { SetText = function() end }
local _WmBuild = { Input  = function() end }

-- ── Flag registry (replaces Obsidian Library.Toggles / Library.Options) ──
local _FlagCb = {}
local function _regFlag(id, cb) if cb then _FlagCb[id] = cb end end
-- _T / _O declared at file scope so community configs can reach them
local function _T(id, v) if _FlagCb[id] then local ok, err = pcall(_FlagCb[id], v); if not ok then warn("[UNCODE _T] " .. tostring(id) .. ": " .. tostring(err)) end end end
local function _O(id, v) _T(id, v) end

-- Options / Toggles: alias Linoria globals (populated as controls are added)
local Options = getgenv().Options
local Toggles = getgenv().Toggles

-- ╔═══════════════════════════════════════════════════════════════════════╗
-- ║  LANGUAGE SYSTEM — JP / EN                                           ║
-- ╚═══════════════════════════════════════════════════════════════════════╝
local _LANG = "JP"
local function _t(jp, en)
    if _LANG == "EN" then return en end
    return jp
end

-- ╔═══════════════════════════════════════════════════════════════════════╗
-- ║  QUICK KEYBIND ENGINE                                                ║
-- ╚═══════════════════════════════════════════════════════════════════════╝
local _qbState   = {}    -- flagId → current bool state
local _qbLabels  = {}    -- flagId → display name
local _qbEnabled = true  -- master switch (UI toggle)
local _qbKeyMap  = {}    -- Enum.KeyCode.Value → flagId  (runtime binding table)
local _qbMode    = {}    -- flagId → "Toggle" | "Hold" | "Always"

local _QB_KEY_LIST = {
    "None",
    "Z","X","C","V","B","N","M",
    "Q","W","E","R","T","Y","U","I","O","P",
    "A","S","D","F","G","H","J","K","L",
    "F1","F2","F3","F4","F5","F6","F7","F8",
    "LeftAlt","RightAlt","Tab","CapsLock",
    "Semicolon","Comma","Period","Backquote",
    "One","Two","Three","Four","Five",
    "Six","Seven","Eight","Nine","Zero",
}

local _qbCodeOf = {}
for _, name in ipairs(_QB_KEY_LIST) do
    if name ~= "None" then
        pcall(function() _qbCodeOf[name] = Enum.KeyCode[name] end)
    end
end

local _qbKeyDisplay = {}

local function _qbSetKey(flagId, keyName)
    for kv, fid in pairs(_qbKeyMap) do
        if fid == flagId then _qbKeyMap[kv] = nil end
    end
    if keyName and keyName ~= "None" then
        local kc = _qbCodeOf[keyName]
        if kc then
            _qbKeyMap[kc.Value] = flagId
            _qbKeyDisplay[flagId] = keyName
        end
    else
        _qbKeyDisplay[flagId] = "None"
    end
end

-- ╔══════════════════════════════════════════════════════════════════╗
-- ╚══════════════════════════════════════════════════════════════════╝
local _qbListenMode = nil

local function _qbSetKeyAny(flagId, kc)
    for kv, fid in pairs(_qbKeyMap) do
        if fid == flagId then _qbKeyMap[kv] = nil end
    end
    if kc and kc ~= Enum.KeyCode.Unknown then
        _qbKeyMap[kc.Value] = flagId
        _qbKeyDisplay[flagId] = kc.Name
    else
        _qbKeyDisplay[flagId] = "None"
    end
end

function _G._UNC_QbStartListen(flagId)
    _qbListenMode = flagId
    Notification.new({
        Title   = "Keybind",
        Content = "Press any key to bind to ["..(_qbLabels[flagId] or flagId).."]...",
        Duration = 4,
    })
end

local function _quickToggle(flagId)
    if not _qbEnabled then return end
    local nv = not (_qbState[flagId] or false)
    _qbState[flagId] = nv
    pcall(_T, flagId, nv)
    Notification.new({
        Title   = "Quick Toggle",
        Content = (_qbLabels[flagId] or flagId) .. "  →  " .. (nv and "ON " or "OFF"),
        Duration = 1.5,
    })
end

local _UIS_qb = game:GetService("UserInputService")
_UIS_qb.InputBegan:Connect(function(inp, processed)
    if _qbListenMode and not processed then
        local flagId = _qbListenMode
        _qbListenMode = nil
        local kc = inp.KeyCode
        if kc ~= Enum.KeyCode.Unknown then
            _qbSetKeyAny(flagId, kc)
            Notification.new({
                Title   = "Keybind Set",
                Content = (_qbLabels[flagId] or flagId).." → "..kc.Name,
                Duration = 2,
            })
        end
        return
    end
    -- ② Normal keybind: Toggle / Hold / Always
    if processed or not _qbEnabled then return end
    local fid = _qbKeyMap[inp.KeyCode.Value]
    if fid then
        local mode = _qbMode[fid] or "Toggle"
        if mode == "Toggle" then
            pcall(_quickToggle, fid)
        elseif mode == "Hold" then
            _qbState[fid] = true
            pcall(_T, fid, true)
            pcall(_O, fid, true)
        end
        -- "Always" mode: key ignored; feature stays on via _qbMode setter
    end
end)

-- InputEnded: release key for Hold mode
_UIS_qb.InputEnded:Connect(function(inp, processed)
    if not _qbEnabled then return end
    local fid = _qbKeyMap[inp.KeyCode.Value]
    if fid and (_qbMode[fid] or "Toggle") == "Hold" then
        _qbState[fid] = false
        pcall(_T, fid, false)
        pcall(_O, fid, false)
    end
end)

-- ╔══════════════════════════════════════════════════════════════════╗
-- ╚══════════════════════════════════════════════════════════════════╝
local _kbHudEnabled = false
local _kbHudGui     = nil
local _kbHudConn    = nil
local _kbHudLastStr = ""

local function _kbHudDestroy()
    pcall(function() if _kbHudGui then _kbHudGui:Destroy() end end)
    _kbHudGui = nil
    if _kbHudConn then _kbHudConn:Disconnect(); _kbHudConn = nil end
end

local function _kbHudBuild()
    _kbHudDestroy()
    local ok, cg = pcall(function() return game:GetService("CoreGui") end)
    if not ok then return end

    local sg = Instance.new("ScreenGui")
    sg.Name = "UNC_KbHud"
    sg.ResetOnSpawn = false
    sg.IgnoreGuiInset = true
    sg.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    sg.Parent = cg

    local frame = Instance.new("Frame")
    frame.Name = "KbFrame"
    frame.AnchorPoint = Vector2.new(0, 0.5)
    frame.Position = UDim2.new(0, 8, 0.5, 0)
    frame.BackgroundColor3 = Color3.fromRGB(10, 10, 10)
    frame.BackgroundTransparency = 0.35
    frame.BorderSizePixel = 0
    frame.AutomaticSize = Enum.AutomaticSize.Y
    frame.Size = UDim2.new(0, 160, 0, 0)
    frame.Parent = sg
    Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 7)
    local pad = Instance.new("UIPadding", frame)
    pad.PaddingLeft  = UDim.new(0, 7)
    pad.PaddingRight = UDim.new(0, 7)
    pad.PaddingTop   = UDim.new(0, 5)
    pad.PaddingBottom= UDim.new(0, 5)
    local list = Instance.new("UIListLayout", frame)
    list.Padding = UDim.new(0, 1)
    list.SortOrder = Enum.SortOrder.LayoutOrder

    local title = Instance.new("TextLabel", frame)
    title.LayoutOrder = 0
    title.Size = UDim2.new(1, 0, 0, 14)
    title.BackgroundTransparency = 1
    title.Text = "UNCODE Keybinds"
    title.TextColor3 = Color3.fromRGB(255, 200, 60)
    title.TextSize = 11
    title.Font = Enum.Font.GothamBold
    title.TextXAlignment = Enum.TextXAlignment.Left

    _kbHudGui = sg

    local _rowMap = {}  -- flagId → TextLabel
    local _timer  = 0
    _kbHudConn = game:GetService("RunService").Heartbeat:Connect(function(dt)
        _timer = _timer + dt
        if _timer < 0.25 then return end
        _timer = 0
        if not _kbHudEnabled then return end
        local order = 1
        for flagId, dispKey in pairs(_qbKeyDisplay) do
            if dispKey and dispKey ~= "None" then
                order = order + 1
                local st  = _qbState[flagId] or false
                local lbl = _qbLabels[flagId] or flagId
                local txt = string.format("[%s]  %s", dispKey, lbl)
                if not _rowMap[flagId] then
                    local row = Instance.new("TextLabel", frame)
                    row.Size = UDim2.new(1, 0, 0, 13)
                    row.BackgroundTransparency = 1
                    row.TextSize = 10
                    row.Font = Enum.Font.Gotham
                    row.TextXAlignment = Enum.TextXAlignment.Left
                    _rowMap[flagId] = row
                end
                local row = _rowMap[flagId]
                row.LayoutOrder = order
                row.Text = txt
                row.TextColor3 = st
                    and Color3.fromRGB(80, 255, 120)
                    or  Color3.fromRGB(200, 200, 200)
            end
        end
        for flagId, row in pairs(_rowMap) do
            if not _qbKeyDisplay[flagId] or _qbKeyDisplay[flagId] == "None" then
                pcall(function() row:Destroy() end)
                _rowMap[flagId] = nil
            end
        end
    end)
end

_G._UNC_KbHudShow = function(v)
    _kbHudEnabled = v
    if v then _kbHudBuild()
    else _kbHudDestroy() end
end

local _qbDefs = {
    { flagId = "EspEnabled",     label = "Player ESP",    default = "None" },
    { flagId = "VoidToggle",     label = "Void",          default = "None" },
    { flagId = "OrbitToggle",    label = "Orbit",         default = "None" },
    { flagId = "PredToggle",     label = "Prediction V2", default = "None" },
    { flagId = "AntiBaitToggle", label = "Anti-Bait V2",  default = "None" },
    { flagId = "SlingToggle",    label = "Sling Bypass",  default = "None" },
    { flagId = "AaToggle",       label = "Anti-Aim",      default = "None" },
}
for _, d in ipairs(_qbDefs) do
    _qbLabels[d.flagId] = d.label
    _qbState[d.flagId]  = false
    _qbSetKey(d.flagId, d.default)
end

-- ╔═══════════════════════════════════════════════════════════════════════╗
-- ║  MILLENIUM COMPAT LAYER                                              ║
-- ║  wrapSection  →  Obsidian groupbox API on top of Millenium section  ║
-- ║  wrapTab      →  Obsidian tab API on top of a Millenium sub-tab     ║
-- ║  Window       →  AddTab() lookup into pre-created sub-tab objects   ║
-- ╚═══════════════════════════════════════════════════════════════════════╝

-- ── wrapSection ─────────────────────────────────────────────────────────
-- Real Millenium element API: section:toggle/slider/dropdown/label/button/
--   keybind/colorpicker({name, flag, default, callback, ...})
local function wrapSection(mlSec)
    local ws = {}

    -- Helper: convert Obsidian Rounding → Millenium interval
    -- Rounding=0 → 1, Rounding=1 → 0.1, Rounding=2 → 0.01
    local function _toInterval(rounding)
        if not rounding or rounding <= 0 then return 1 end
        return 10 ^ (-rounding)
    end

    function ws:AddToggle(id, opts)
        _regFlag(id, opts.Callback)
        local _ok, _err = pcall(function()
            mlSec:toggle({
                name     = opts.Text or id,
                flag     = id,
                default  = opts.Default or false,
                callback = function(v)
                    if opts.Callback then
                        local ok2, err2 = pcall(opts.Callback, v)
                        if not ok2 then warn("[UNCODE CB] " .. tostring(id) .. ": " .. tostring(err2)) end
                    end
                end,
            })
        end)
        if not _ok then warn("[UNCODE UI] toggle '" .. tostring(id) .. "': " .. tostring(_err)) end
        -- Return proxy so callers (AddKeyPicker, sub-settings) don't error
        return setmetatable({}, {
            __index = function(t, k) return function() end end,
        })
    end

    function ws:AddSlider(id, opts)
        _regFlag(id, opts.Callback)
        local _ok, _err = pcall(function()
            mlSec:slider({
                name     = opts.Text or id,
                flag     = id,
                default  = opts.Default or 0,
                min      = opts.Min or 0,
                max      = opts.Max or 100,
                interval = _toInterval(opts.Rounding),
                suffix   = opts.Suffix or "",
                callback = function(v)
                    if opts.Callback then
                        local ok2, err2 = pcall(opts.Callback, v)
                        if not ok2 then warn("[UNCODE CB] " .. tostring(id) .. ": " .. tostring(err2)) end
                    end
                end,
            })
        end)
        if not _ok then warn("[UNCODE UI] slider '" .. tostring(id) .. "': " .. tostring(_err)) end
    end

    function ws:AddDropdown(id, opts)
        _regFlag(id, opts.Callback)
        local _ok, _err = pcall(function()
            mlSec:dropdown({
                name     = opts.Text or id,
                flag     = id,
                default  = opts.Default,
                items    = opts.Values or opts.Items or {},
                multi    = opts.Multi or false,
                callback = function(v)
                    if opts.Callback then
                        local ok2, err2 = pcall(opts.Callback, v)
                        if not ok2 then warn("[UNCODE CB] " .. tostring(id) .. ": " .. tostring(err2)) end
                    end
                end,
            })
        end)
        if not _ok then warn("[UNCODE UI] dropdown '" .. tostring(id) .. "': " .. tostring(_err)) end
    end

    function ws:AddLabel(text)
        pcall(function() mlSec:label({ name = text or "" }) end)
    end

    function ws:AddButton(text, cb)
        local _ok, _err = pcall(function()
            mlSec:button({
                name     = text or "Button",
                callback = function()
                    if cb then
                        local ok2, err2 = pcall(cb)
                        if not ok2 then warn("[UNCODE CB] button '" .. tostring(text) .. "': " .. tostring(err2)) end
                    end
                end,
            })
        end)
        if not _ok then warn("[UNCODE UI] button '" .. tostring(text) .. "': " .. tostring(_err)) end
    end

    -- Colorpicker: inline color swatch attached to this section
    function ws:AddColorPicker(id, opts)
        pcall(function()
            mlSec:colorpicker({
                name     = opts.Title or opts.Text or id,
                flag     = id,
                color    = (opts.Default and typeof(opts.Default) == "Color3")
                            and opts.Default or Color3.new(1, 1, 1),
                alpha    = opts.Transparency or 0,
                callback = function(v)
                    if opts.Callback then pcall(opts.Callback, v) end
                end,
            })
        end)
    end

    -- KeyPicker: maps to a Millenium keybind element
    function ws:AddKeyPicker(id, opts)
        _regFlag(id, opts and opts.Callback)
        pcall(function()
            mlSec:keybind({
                name     = (opts and (opts.Text or opts.Label)) or id,
                flag     = id,
                key      = opts and opts.Default or nil,
                mode     = "Toggle",
                callback = function(v)
                    if opts and opts.Callback then pcall(opts.Callback, v) end
                end,
            })
        end)
    end

    -- AddKeybind: fires _quickToggle for the bound flag when pressed
    function ws:AddKeybind(flagId, opts)
        pcall(function()
            mlSec:keybind({
                name     = (opts and (opts.Text or opts.Label)) or flagId,
                flag     = flagId,
                key      = opts and opts.Default or nil,
                mode     = "Toggle",
                callback = function(v)
                    pcall(_quickToggle, flagId)
                end,
            })
        end)
    end

    return ws
end

-- ── wrapTab ──────────────────────────────────────────────────────────────
-- Wraps a Millenium sub-tab page to expose Obsidian-style groupbox API.
-- Real Millenium API: page:column({size}) → column; column:section({name}) → section
local function wrapTab(mlSubTab)
    local wt = {}
    -- Two side-by-side columns; HorizontalFlex.Fill in the tab splits them equally
    local _leftCol  = mlSubTab:column({ size = 1 })
    local _rightCol = mlSubTab:column({ size = 1 })

    function wt:AddLeftGroupbox(name)
        return wrapSection(_leftCol:section({ name = name or "" }))
    end
    function wt:AddRightGroupbox(name)
        return wrapSection(_rightCol:section({ name = name or "" }))
    end
    function wt:AddSection(opts)
        local nm = type(opts) == "string" and opts or (opts.Name or opts.name or "")
        return wrapSection(_leftCol:section({ name = nm }))
    end
    return wt
end

-- ── Millenium tab groups ─────────────────────────────────────────────────
-- 20 logical tabs → 7 Millenium parent tabs, each with ≤3 sub-tabs.
-- (>3 sub-tabs per group causes the sub-tab row to overflow / drop down.)
-- Real Millenium API: window:tab({name, tabs={"Sub1","Sub2",...}})
--   returns sub-tab page objects (one per entry, via unpack).
--
--   ┌─ HvH ───────┐  Aim | Rage | AA
--   ├─ Rivals ────┤  Trap | Pred | VS
--   ├─ World ─────┤  Orbit | Def | Skin
--   ├─ Misc ──────┤  Trans | Sling | Riot
--   ├─ Player ────┤  Cam | World | Auto
--   ├─ Config ────┤  Keys | UI | Tools
--   └─ settings ──┘  HUD | Save
--
-- Layout mirrors Unnamed Enhancements (discord.gg/enhancements):
--   main / world / esp / visuals / character / misc / settings
--
-- ── Window compat ────────────────────────────────────────────────────────
-- window:tab() now creates ONE Linoria sidebar tab per group name.
-- All sub-tab locals for the same group alias the same tab object.
-- _mlTabMap persists after the do..end; locals are freed.
local _mlTabMap = {}
do
    local _tMain, _tHvH, _tWorld, _tEsp, _tVisuals, _tCharacter, _tMisc, _tSettings

    -- One Linoria sidebar tab per group: 8 tabs total
    _tMain      = window:tab({ name = "combat",    tabs = {"Combat"}    })
    _tHvH       = window:tab({ name = "hvh",       tabs = {"HvH"}       })
    _tWorld     = window:tab({ name = "world",     tabs = {"World"}     })
    _tEsp       = window:tab({ name = "esp",       tabs = {"Esp"}       })
    _tVisuals   = window:tab({ name = "visuals",   tabs = {"Visuals"}   })
    _tCharacter = window:tab({ name = "character", tabs = {"Character"} })
    _tMisc      = window:tab({ name = "misc",      tabs = {"Misc"}      })
    _tSettings  = window:tab({ name = "settings",  tabs = {"Settings"}  })

    -- combat: silent aim / aimbot / general combat content
    _mlTabMap["Combat"]        = _tMain
    _mlTabMap["PlayerFight"]   = _tMain
    _mlTabMap["VoidSpam"]      = _tMain
    _mlTabMap["Trap"]          = _tMain
    _mlTabMap["Prediction"]    = _tMain
    _mlTabMap["Orbit"]         = _tMain
    _mlTabMap["Defense"]       = _tMain

    -- hvh: ragebot / triggerbot / flickbot (dedicated rage tab)
    _mlTabMap["HvH"]           = _tHvH

    -- world: world changer / skin changer
    _mlTabMap["SkinChanger"]   = _tWorld
    _mlTabMap["World"]         = _tWorld

    -- esp: box / info / sound
    _mlTabMap["EspBox"]        = _tEsp
    _mlTabMap["EspInfo"]       = _tEsp
    _mlTabMap["EspSound"]      = _tEsp

    -- visuals: chams / FX / misc visuals (mirrors UE "visuals")
    _mlTabMap["WepChams"]      = _tVisuals
    _mlTabMap["WepFX"]         = _tVisuals
    _mlTabMap["QolMisc"]       = _tVisuals

    -- character: movement / player / animation / anti-aim / spoofer
    --            (mirrors UE "character": movement + noclip + fly + AA)
    _mlTabMap["Player"]        = _tCharacter
    _mlTabMap["Movement"]      = _tCharacter
    _mlTabMap["PlayerUtil"]    = _tCharacter
    _mlTabMap["Automation"]    = _tCharacter
    _mlTabMap["AA"]            = _tCharacter
    _mlTabMap["Spoofer"]       = _tCharacter
    _mlTabMap["PlayerSpoofer"] = _tCharacter
    _mlTabMap["PlayerSpoof"]   = _tCharacter

    -- misc: utility / tools / bypass (mirrors UE "misc")
    _mlTabMap["Translocation"] = _tMisc
    _mlTabMap["Sling Bypass"]  = _tMisc
    _mlTabMap["Riot"]          = _tMisc
    _mlTabMap["Keybinds"]      = _tMisc
    _mlTabMap["UI"]            = _tMisc
    _mlTabMap["Tools"]         = _tMisc

    -- settings: HUD / save config
    _mlTabMap["HUD"]           = _tSettings
    _mlTabMap["Save"]          = _tSettings
end
-- All tab locals freed here; _mlTabMap persists (7 groups matching UE layout)

-- Fallback no-op tab (returns Obsidian-style API directly; never reaches wrapTab)
local function _noopTab()
    local function _noopSec()
        local ns = {}
        local function _noop() return setmetatable({}, {__index=function() return _noop end}) end
        ns.AddToggle        = _noop
        ns.AddSlider        = _noop
        ns.AddDropdown      = _noop
        ns.AddMultiDropdown = _noop
        ns.AddLabel         = _noop
        ns.AddButton        = _noop
        ns.AddKeybind       = _noop
        ns.AddColorPicker   = _noop
        ns.AddKeyPicker     = _noop
        return ns
    end
    return {
        AddLeftGroupbox  = function(self, name) return _noopSec() end,
        AddRightGroupbox = function(self, name) return _noopSec() end,
        AddSection       = function(self, opts) return _noopSec() end,
    }
end

local Window = {}
function Window:AddTab(name, _icon)
    local t = _mlTabMap[name]
    if not t then
        warn("[UNCODE] Window:AddTab — unknown tab name: " .. tostring(name))
        return _noopTab()
    end
    -- Linoria tabs already have AddLeftGroupbox/AddRightGroupbox natively
    if t.AddLeftGroupbox then return t end
    return wrapTab(t)
end


local function Notify(text, duration)
    Notification.new({ Title = "UNCODE v1", Content = text, Duration = duration or 3 })
end

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local LocalPlayer = Players.LocalPlayer
local Camera = workspace.CurrentCamera

local char, root, hum
local conns = {}

local function killConn(key)
    if conns[key] then conns[key]:Disconnect(); conns[key] = nil end
end

local function getLocalRoot() return root end

local function safeCall(fn, ...)
    local ok, err = pcall(fn, ...)
    if not ok then
        warn("[UNCODE] error:", err)
    end
    return ok
end

local function safeSet(instance, prop, value)
    if not instance then return end
    pcall(function() instance[prop] = value end)
end


	Toggle(g3, "enabled", function() return Config.Crosshair.Enabled end, function(v) Config.Crosshair.Enabled = v end)
	Toggle(g3, "rgb cycle", function() return Config.Crosshair.RGB end, function(v) Config.Crosshair.RGB = v end)

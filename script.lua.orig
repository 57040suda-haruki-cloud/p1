_URVR:AddSlider("RsvBruteStep", {
    Text    = "Brute Step",
    Default = 45,
    Min = 1, Max = 90, Rounding = 0, Suffix = "°",
    Tooltip = "Degrees advanced per tick in Brute Force mode.",
    Callback = function(v) _rsvCFG.bruteStep = v end,
})
_URVR:AddButton("Reset Resolver Data", function()
    _rsvHits = {}
    _rsvCFG._bruteYaw = 0
    Notification.new({ Title="UNCODE v1", Content="Resolver data reset.", Duration=2 })
end)

-- ── Auto Peek ───────────────────────────────────────────────────────────
local _apCFG = {
    enabled     = false,
    holdTime    = 0.4,
    retractTime = 0.3,
}
local _apConn, _apState = nil, "idle"
local _apOrigin, _apPeekStart

local function _apStop()
    if _apConn then pcall(function() _apConn:Disconnect() end); _apConn = nil end
    _apState = "idle"
end

local function _apStart()
    _apStop()
    _apConn = _uaaRS.Heartbeat:Connect(function()
        if not _apCFG.enabled then return end
        pcall(function()
            local char = _uaaLP.Character
            if not char then return end
            local root = char:FindFirstChild("HumanoidRootPart")
            local hum  = char:FindFirstChildOfClass("Humanoid")
            if not root or not hum then return end
            if _apState == "idle" then
                if hum.MoveDirection.Magnitude > 0.1 then
                    _apOrigin    = root.CFrame.Position
                    _apPeekStart = tick()
                    _apState     = "peeking"
                end
            elseif _apState == "peeking" then
                if tick() - _apPeekStart >= _apCFG.holdTime then
                    _apState = "retracting"
                end
            elseif _apState == "retracting" then
                local elapsed = tick() - _apPeekStart - _apCFG.holdTime
                if elapsed >= _apCFG.retractTime then
                    _apState = "idle"
                    if _apOrigin then pcall(function() hum:MoveTo(_apOrigin) end) end
                end
            end
        end)
    end)
end

_UAPL:AddToggle("UapEnabled", {
    Text    = "Auto Peek",
    Default = false,
    Tooltip = "Auto-peek on move start then retract after hold time.",
    Callback = function(v)
        _apCFG.enabled = v
        if v then _apStart() else _apStop() end
    end,
})
_UAPL:AddSlider("UapHoldTime", {
    Text    = "Peek Hold Time",
    Default = 4,
    Min = 1, Max = 20, Rounding = 0, Suffix = "×0.1s",
    Tooltip = "How long to stay exposed before retracting.",
    Callback = function(v) _apCFG.holdTime = v * 0.1 end,
})
_UAPL:AddSlider("UapRetractTime", {
    Text    = "Retract Time",
    Default = 3,
    Min = 1, Max = 15, Rounding = 0, Suffix = "×0.1s",
    Tooltip = "How fast to retract.",
    Callback = function(v) _apCFG.retractTime = v * 0.1 end,
})

end -- Underground AA / Resolver / Auto Peek scope

-- ╔═══════════════════════════════════════════════════════════════════════╗
-- ╚═══════════════════════════════════════════════════════════════════════╝
do
local _RTL  = Tabs.Trap:AddLeftGroupbox("Rage Trap")
local _RTR  = Tabs.Trap:AddRightGroupbox("Trap Config")

local _rtCFG = {
    enabled     = false,
    y           = 1300,
    range       = 40,
    cooldown    = 3,
    detectRage  = true,
    spinThresh  = 180,
    _prevYaw    = {},
}
local _rtLP   = game:GetService("Players").LocalPlayer
local _rtLast = {}   -- [plr] → last TP tick
local _rtConn

local function _rtIsRaging(plr)
    pcall(function()
        local char = plr.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        if not root then return end
        local _, ry, _ = root.CFrame:ToEulerAnglesYXZ()
        local cur  = math.deg(ry)
        local key  = tostring(plr.UserId)
        local prev = _rtCFG._prevYaw[key]
        _rtCFG._prevYaw[key] = cur
        if not prev then return end
        local delta = math.abs(cur - prev)
        if delta > 180 then delta = 360 - delta end
        if delta >= _rtCFG.spinThresh then return true end
    end)
end

local function _rtIsRagingBool(plr)
    local result = false
    pcall(function()
        local char = plr.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        if not root then return end
        local _, ry, _ = root.CFrame:ToEulerAnglesYXZ()
        local cur  = math.deg(ry)
        local key  = tostring(plr.UserId)
        local prev = _rtCFG._prevYaw[key]
        _rtCFG._prevYaw[key] = cur
        if not prev then return end
        local delta = math.abs(cur - prev)
        if delta > 180 then delta = 360 - delta end
        if delta >= _rtCFG.spinThresh then result = true end
    end)
    return result
end

local function _rtTeleport(plr)
    if not _rtCFG.enabled then return end
    local now = tick()
    if _rtLast[plr] and now - _rtLast[plr] < _rtCFG.cooldown then return end
    _rtLast[plr] = now
    pcall(function()
        local char = plr.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        if not root then return end
        local rng = _rtCFG.range
        local pos = root.Position
        local ox  = math.random(-rng, rng)
        local oz  = math.random(-rng, rng)
        local targetCF = CFrame.new(pos.X + ox, _rtCFG.y, pos.Z + oz)
        -- Claim network ownership so the CFrame change replicates to server
        pcall(function() root:SetNetworkOwner(LocalPlayer) end)
        -- Bypass __newindex metamethod protection (same pattern as slingshot NoTP mode)
        local _mt = getrawmetatable and getrawmetatable(root)
        local _ni = _mt and rawget(_mt, "__newindex")
        if _ni then
            pcall(_ni, root, "CFrame", targetCF)
            pcall(_ni, root, "AssemblyLinearVelocity", Vector3.zero)
        else
            root.CFrame = targetCF
            pcall(function() root.AssemblyLinearVelocity = Vector3.zero end)
        end
        Notification.new({
            Title   = "Rage Trap",
            Content = "Teleported "..plr.Name.." to Y="..tostring(_rtCFG.y),
            Duration = 1.5,
        })
    end)
end

local function _rtStop()
    if _rtConn then pcall(function() _rtConn:Disconnect() end); _rtConn = nil end
end

local function _rtStart()
    _rtStop()
    _rtConn = game:GetService("RunService").Heartbeat:Connect(function()
        if not _rtCFG.enabled then return end
        pcall(function()
            local lp = _rtLP
            for _, plr in ipairs(game:GetService("Players"):GetPlayers()) do
                if plr ~= lp then
                    local rage = _rtCFG.detectRage and _rtIsRagingBool(plr) or (not _rtCFG.detectRage)
                    if rage then
                        _rtTeleport(plr)
                    end
                end
            end
        end)
    end)
end

_RTL:AddToggle("RtEnabled", {
    Text    = "Rage Trap",
    Default = false,
    Tooltip = "Teleport raging (Spin/Jitter AA) enemies to the arena boundary to make them self-destruct.",
    Callback = function(v)
        _rtCFG.enabled = v
        if v then _rtStart() else _rtStop() end
        Notification.new({ Title="UNCODE v1", Content="Rage Trap "..(v and "ON " or "OFF"), Duration=1.5 })
    end,
})
-- Wire _FlagCb so QB keybind (_T/"_O") can also toggle Rage Trap
_regFlag("RtEnabled", function(v)
    _rtCFG.enabled = v
    if v then _rtStart() else _rtStop() end
end)
_RTL:AddToggle("RtDetectRage", {
    Text    = "Rage-Only Filter",
    Default = true,
    Tooltip = "ON: only TP enemies detected as spinning/jittering. OFF: TP all enemies.",
    Callback = function(v) _rtCFG.detectRage = v end,
})
_RTL:AddButton("Teleport All Now", function()
    local lp = _rtLP
    for _, plr in ipairs(game:GetService("Players"):GetPlayers()) do
        if plr ~= lp then _rtTeleport(plr) end
    end
end)

_RTR:AddSlider("RtY", {
    Text    = "Boundary Y",
    Default = 1300,
    Min = -2000, Max = 5000, Rounding = 0,
    Tooltip = "Y coordinate to TP to. Around 1300 puts enemies out of bounds → instant death.",
    Callback = function(v) _rtCFG.y = v end,
})
_RTR:AddSlider("RtRange", {
    Text    = "XZ Random Range",
    Default = 40,
    Min = 0, Max = 300, Rounding = 0, Suffix = " studs",
    Tooltip = "Random XZ spread added to the TP target position (±studs).",
    Callback = function(v) _rtCFG.range = v end,
})
_RTR:AddSlider("RtCooldown", {
    Text    = "Cooldown",
    Default = 3,
    Min = 1, Max = 30, Rounding = 0, Suffix = "s",
    Tooltip = "Minimum interval in seconds before re-TPing the same player.",
    Callback = function(v) _rtCFG.cooldown = v end,
})
_RTR:AddSlider("RtSpinThresh", {
    Text    = "Rage Detect Threshold",
    Default = 180,
    Min = 30, Max = 360, Rounding = 0, Suffix = "°/f",
    Tooltip = "Yaw change per frame above this = raging. Recommended: 180°.",
    Callback = function(v) _rtCFG.spinThresh = v end,
})

end -- Rage Trap scope


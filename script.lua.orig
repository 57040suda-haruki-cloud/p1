-- ── WIREFRAME ─────────────────────────────────────────────────
do
-- ╔══════════════════════════════════════════════════════════════════╗
-- ║  WIREFRAME ESP                                                  ║
-- ╚══════════════════════════════════════════════════════════════════╝
local _wfCFG = {
    enabled       = false,
    color         = Color3.fromRGB(255, 50, 50),
    thickness     = 2,
    wallhack      = true,
    selfOnly      = false,
    teamVisible   = false,
}

local _wfHighlights = {}  -- [player] = Highlight instance
local _wfConn       = nil
local _wfLP         = game:GetService("Players").LocalPlayer

local function _wfRemove(plr)
    local hl = _wfHighlights[plr]
    if hl then
        pcall(function() hl:Destroy() end)
        _wfHighlights[plr] = nil
    end
end

local function _wfApply(plr)
    if not _wfCFG.enabled then return end
    if plr == _wfLP and not _wfCFG.selfOnly then return end
    _wfRemove(plr)
    pcall(function()
        local char = plr.Character
        if not char then return end
        local hl = Instance.new("Highlight")
        hl.FillTransparency    = 1
        hl.OutlineColor        = _wfCFG.color
        hl.OutlineTransparency = 0
        hl.DepthMode = _wfCFG.wallhack
            and Enum.HighlightDepthMode.AlwaysOnTop
            or  Enum.HighlightDepthMode.Occluded
        hl.Adornee = char
        hl.Parent  = char
        _wfHighlights[plr] = hl
    end)
end

local function _wfClear()
    for plr, _ in pairs(_wfHighlights) do
        _wfRemove(plr)
    end
end

local function _wfStart()
    _wfConn = game:GetService("RunService").Heartbeat:Connect(function()
        for _, plr in ipairs(game:GetService("Players"):GetPlayers()) do
            repeat
                if plr == _wfLP then break end
                local isTeam = false
                pcall(function()
                    isTeam = (plr.Team == _wfLP.Team)
                end)
                if isTeam and not _wfCFG.teamVisible then
                    _wfRemove(plr)
                    break
                end
                local char = plr.Character
                local hl   = _wfHighlights[plr]
                if not hl or not hl.Parent or hl.Adornee ~= char then
                    _wfApply(plr)
                else
                    hl.OutlineColor = _wfCFG.color
                    hl.DepthMode = _wfCFG.wallhack
                        and Enum.HighlightDepthMode.AlwaysOnTop
                        or  Enum.HighlightDepthMode.Occluded
                end
            until true
        end
        for plr, _ in pairs(_wfHighlights) do
            if not plr.Parent then _wfRemove(plr) end
        end
    end)
end

local function _wfStop()
    if _wfConn then _wfConn:Disconnect(); _wfConn = nil end
    _wfClear()
end

-- ── UI ──────────────────────────────────────────────────────
HvHL4:AddToggle("WireframeEnabled", {
    Text    = "Wireframe ESP",
    Default = false,
    Tooltip = "Show enemy outlines through walls (pseudo-wireframe).",
    Callback = function(v)
        _wfCFG.enabled = v
        if v then _wfStart() else _wfStop() end
        Notification.new({
            Title   = "Wireframe ESP",
            Content = "Wireframe "..(v and "ON" or "OFF"),
            Duration = 1.5,
        })
    end,
})

HvHL4:AddToggle("WireframeWallhack", {
    Text    = "Wallhack (AlwaysOnTop)",
    Default = true,
    Tooltip = "Show outlines through walls.",
    Callback = function(v) _wfCFG.wallhack = v end,
})

HvHL4:AddToggle("WireframeTeam", {
    Text    = "Show Teammates",
    Default = false,
    Callback = function(v) _wfCFG.teamVisible = v end,
})

HvHR4:AddColorpicker("WireframeColor", {
    Text    = "Wireframe Color",
    Default = Color3.fromRGB(255, 50, 50),
    Callback = function(v) _wfCFG.color = v end,
})

HvHR4:AddSlider("WireframeThickness", {
    Text    = "Outline Thickness",
    Default = 2, Min = 1, Max = 5, Rounding = 0,
    Tooltip = "Highlight outline thickness (1-5).",
    Callback = function(v)
        _wfCFG.thickness = v
        if _wfCFG.enabled then
            _wfClear()
            for _, plr in ipairs(game:GetService("Players"):GetPlayers()) do
                if plr ~= _wfLP then _wfApply(plr) end
            end
        end
    end,
})

end -- Wireframe scope

-- ═══════════════════════════════════════════════════════════════
--  UNCODE v1 ·  Player Radar
-- ═══════════════════════════════════════════════════════════════
do -- Player Radar scope
local _radarCFG = { enabled=false, range=500,
    selfColor=Color3.fromRGB(0,255,0), enemyColor=Color3.fromRGB(255,50,50) }
local _radarGui = nil
local _radarCon = nil
local _radarRS  = game:GetService("RunService")
local _radarP   = game:GetService("Players")
local RADAR_SIZE = 200

local function _radarBuild()
    pcall(function()
        if _radarGui then _radarGui:Destroy(); _radarGui = nil end
        local sg = Instance.new("ScreenGui")
        sg.Name = "UNC_RadarHUD"
        sg.ResetOnSpawn = false
        sg.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
        sg.DisplayOrder = 15
        pcall(function() sg.Parent = game:GetService("CoreGui") end)
        if not sg.Parent then sg.Parent = _radarP.LocalPlayer.PlayerGui end
        _radarGui = sg

        local bg = Instance.new("Frame")
        bg.Name = "RadarBG"
        bg.Size = UDim2.new(0, RADAR_SIZE, 0, RADAR_SIZE)
        bg.Position = UDim2.new(0, 20, 0.5, -(RADAR_SIZE/2))
        bg.BackgroundColor3 = Color3.fromRGB(8,8,8)
        bg.BackgroundTransparency = 0.35
        bg.BorderSizePixel = 0
        bg.Parent = sg
        local corner = Instance.new("UICorner")
        corner.CornerRadius = UDim.new(1, 0)
        corner.Parent = bg

        local lbl = Instance.new("TextLabel")
        lbl.Size = UDim2.new(1, 0, 0, 14)
        lbl.Position = UDim2.new(0, 0, 0, 2)
        lbl.BackgroundTransparency = 1
        lbl.Text = "RADAR"
        lbl.TextColor3 = Color3.fromRGB(200,200,200)
        lbl.TextSize = 11
        lbl.Font = Enum.Font.GothamBold
        lbl.Parent = bg

        local sd = Instance.new("Frame")
        sd.Name = "SelfDot"
        sd.Size = UDim2.new(0, 7, 0, 7)
        sd.Position = UDim2.new(0.5, -3, 0.5, -3)
        sd.BackgroundColor3 = _radarCFG.selfColor
        sd.BorderSizePixel = 0
        local sc = Instance.new("UICorner"); sc.CornerRadius = UDim.new(1,0); sc.Parent = sd
        sd.Parent = bg
    end)
end

HvHL4:AddToggle("RadarEnabled", { Text="Player Radar", Default=false,
    Tooltip="Show enemy positions on a mini-map radar",
    Callback = function(v)
        _radarCFG.enabled = v
        if v then
            _radarBuild()
            _radarCon = _radarRS.Heartbeat:Connect(function()
                if not _radarCFG.enabled or not _radarGui then return end
                local bg = _radarGui:FindFirstChild("RadarBG")
                if not bg then return end
                for _, c in ipairs(bg:GetChildren()) do
                    if c.Name:sub(1,8) == "EnemyDot" then c:Destroy() end
                end
                local lp   = _radarP.LocalPlayer
                local char = lp.Character
                if not char then return end
                local hrp  = char:FindFirstChild("HumanoidRootPart")
                if not hrp then return end
                local cf = hrp.CFrame
                for _, p in ipairs(_radarP:GetPlayers()) do
                    if p ~= lp and p.Character then
                        local phrp = p.Character:FindFirstChild("HumanoidRootPart")
                        local phum = p.Character:FindFirstChildOfClass("Humanoid")
                        if phrp and phum and phum.Health > 0 then
                            local rel = cf:PointToObjectSpace(phrp.Position)
                            local rx  = math.clamp(rel.X / _radarCFG.range, -1, 1)
                            local rz  = math.clamp(rel.Z / _radarCFG.range, -1, 1)
                            local dot = Instance.new("Frame")
                            dot.Name = "EnemyDot_"..p.Name
                            dot.Size = UDim2.new(0, 6, 0, 6)
                            dot.Position = UDim2.new(0.5 + rx*0.44, -3, 0.5 + rz*0.44, -3)
                            dot.BackgroundColor3 = _radarCFG.enemyColor
                            dot.BorderSizePixel = 0
                            local dc = Instance.new("UICorner"); dc.CornerRadius = UDim.new(1,0); dc.Parent = dot
                            dot.Parent = bg
                        end
                    end
                end
            end)
        else
            if _radarCon then _radarCon:Disconnect(); _radarCon = nil end
            if _radarGui then _radarGui:Destroy(); _radarGui = nil end
        end
    end })
HvHR4:AddSlider("RadarRange", { Text="Radar Range (studs)",
    Default=500, Min=50, Max=2000, Rounding=0,
    Callback = function(v) _radarCFG.range = v end })
end -- Player Radar scope

-- ═══════════════════════════════════════════════════════════════
--  UNCODE v1 ·  Hitbox Visualizer
-- ═══════════════════════════════════════════════════════════════
do -- Hitbox Visualizer scope
local _hvCFG  = { enabled=false, headOnly=false, color=Color3.fromRGB(255,200,0) }
local _hvBoxes = {}
local _hvCon  = nil
local _hvRS   = game:GetService("RunService")
local _hvP    = game:GetService("Players")

local function _hvClear()
    for _, b in pairs(_hvBoxes) do pcall(function() b:Destroy() end) end
    _hvBoxes = {}
end

HvHL4:AddToggle("HitboxVisEnabled", { Text="Hitbox Visualizer", Default=false,
    Tooltip="Show enemy hitboxes via SelectionBox",
    Callback = function(v)
        _hvCFG.enabled = v
        if v then
            _hvCon = _hvRS.Heartbeat:Connect(function()
                if not _hvCFG.enabled then return end
                _hvClear()
                local lp = _hvP.LocalPlayer
                for _, p in ipairs(_hvP:GetPlayers()) do
                    if p ~= lp and p.Character then
                        local phum = p.Character:FindFirstChildOfClass("Humanoid")
                        if phum and phum.Health > 0 then
                            local parts = _hvCFG.headOnly
                                and { p.Character:FindFirstChild("Head") }
                                or  p.Character:GetChildren()
                            for _, part in ipairs(parts) do
                                if part and part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
                                    local sb = Instance.new("SelectionBox")
                                    sb.Adornee             = part
                                    sb.Color3              = _hvCFG.color
                                    sb.LineThickness       = 0.05
                                    sb.SurfaceTransparency = 0.8
                                    sb.SurfaceColor3       = _hvCFG.color
                                    sb.Parent              = workspace
                                    table.insert(_hvBoxes, sb)
                                end
                            end
                        end
                    end
                end
            end)
        else
            if _hvCon then _hvCon:Disconnect(); _hvCon = nil end
            _hvClear()
        end
    end })
HvHL4:AddToggle("HitboxVisHeadOnly", { Text="Head Only", Default=false,
    Callback = function(v) _hvCFG.headOnly = v end })
HvHR4:AddColorpicker("HitboxVisColor", { Text="Hitbox Color",
    Default=Color3.fromRGB(255,200,0),
    Callback = function(v) _hvCFG.color = v end })
end -- Hitbox Visualizer scope


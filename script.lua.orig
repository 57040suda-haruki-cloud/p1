do
local BhopL = Tabs.Player:AddLeftGroupbox("Bhop / Movement Utils")
local BhopR = Tabs.Player:AddRightGroupbox("Bhop Config")

local _bhopCFG = { enabled=false, mode="Auto", holdDelay=0.01 }
local _bhopLP  = game:GetService("Players").LocalPlayer
local _bhopConn

local function _bhopStart()
    _bhopConn = game:GetService("RunService").Heartbeat:Connect(function()
        pcall(function()
            local char = _bhopLP.Character
            local hum  = char and char:FindFirstChildOfClass("Humanoid")
            if not hum then return end
            if hum.FloorMaterial ~= Enum.Material.Air then
                hum.Jump = true
            end
        end)
    end)
end

local function _bhopStop()
    if _bhopConn then _bhopConn:Disconnect(); _bhopConn = nil end
end

BhopL:AddToggle("BhopEnabled", {
    Text    = "Bunny Hop",
    Default = false,
    Tooltip = "Auto-jump on land to maintain movement speed.",
    Callback = function(v)
        _bhopCFG.enabled = v
        if v then _bhopStart() else _bhopStop() end
        Notification.new({
            Title   = "Bhop",
            Content = "Bunny Hop "..(v and "ON" or "OFF"),
            Duration = 1.5,
        })
    end,
})

BhopR:AddDropdown("BhopMode", {
    Text    = "Mode",
    Default = "Auto",
    Values  = {"Auto","Ground Only"},
    Tooltip = "Auto: always / Ground Only: ground floor only.",
    Callback = function(v) _bhopCFG.mode = v end,
})
end -- Bhop scope

-- ╔══════════════════════════════════════════════════════════════════╗
-- ╚══════════════════════════════════════════════════════════════════╝
do
local AfkL = Tabs.Player:AddLeftGroupbox("Anti-AFK")
local AfkR = Tabs.Player:AddRightGroupbox("AFK Config")

local _afkCFG  = { enabled=false, interval=25, jitter=true }
local _afkLast = 0
local _afkConn
local _afkLP   = game:GetService("Players").LocalPlayer

local function _afkTick()
    local now = tick()
    if now - _afkLast < _afkCFG.interval then return end
    _afkLast = now
    pcall(function()
        local char = _afkLP.Character
        local hum  = char and char:FindFirstChildOfClass("Humanoid")
        local root = char and char:FindFirstChild("HumanoidRootPart")
        if not hum or not root then return end
        if _afkCFG.jitter then
            local ox = (math.random() - 0.5) * 0.02
            local oz = (math.random() - 0.5) * 0.02
            root.CFrame = root.CFrame * CFrame.new(ox, 0, oz)
        end
        hum:Move(Vector3.new(0, 0, 0), false)
    end)
end

AfkL:AddToggle("AfkEnabled", {
    Text    = "Anti-AFK",
    Default = false,
    Tooltip = "Prevent AFK kick with periodic micro-inputs.",
    Callback = function(v)
        _afkCFG.enabled = v
        if v then
            _afkConn = game:GetService("RunService").Heartbeat:Connect(_afkTick)
            Notification.new({ Title="Anti-AFK", Content="Anti-AFK ON", Duration=1.5 })
        else
            if _afkConn then _afkConn:Disconnect(); _afkConn = nil end
            Notification.new({ Title="Anti-AFK", Content="Anti-AFK OFF", Duration=1.5 })
        end
    end,
})

AfkL:AddToggle("AfkJitter", {
    Text    = "Micro-Position Jitter",
    Default = true,
    Tooltip = "Random tiny movement to avoid detection.",
    Callback = function(v) _afkCFG.jitter = v end,
})

AfkR:AddSlider("AfkInterval", {
    Text    = "Send Interval (s)",
    Default = 25, Min = 5, Max = 60, Rounding = 0,
    Tooltip = "How often to send anti-AFK input (seconds).",
    Callback = function(v) _afkCFG.interval = v end,
})
end -- Anti-AFK scope

-- ═══════════════════════════════════════════════════════════════
--  UNCODE v1 ·  Kill Aura
-- ═══════════════════════════════════════════════════════════════
do -- Kill Aura scope
local _kauraCFG = { enabled=false, range=30 }
local _kauraCon = nil
local _kauraRS  = game:GetService("RunService")
local _kauraP   = game:GetService("Players")
local KauraL = Tabs.PlayerFight:AddLeftGroupbox("Kill Aura")
local KauraR = Tabs.PlayerFight:AddRightGroupbox("Kill Aura Config")

KauraL:AddToggle("KillAuraEnabled", { Text="Kill Aura", Default=false,
    Tooltip="Auto-damage enemies in range",
    Callback = function(v)
        _kauraCFG.enabled = v
        if v then
            _kauraCon = _kauraRS.Heartbeat:Connect(function()
                if not _kauraCFG.enabled then return end
                local lp   = _kauraP.LocalPlayer
                local char = lp.Character
                if not char then return end
                local hrp = char:FindFirstChild("HumanoidRootPart")
                if not hrp then return end
                for _, p in ipairs(_kauraP:GetPlayers()) do
                    if p ~= lp and p.Character then
                        local phrp = p.Character:FindFirstChild("HumanoidRootPart")
                        local phum = p.Character:FindFirstChildOfClass("Humanoid")
                        if phrp and phum and phum.Health > 0 then
                            if (hrp.Position - phrp.Position).Magnitude <= _kauraCFG.range then
                                pcall(function()
                                    local tool = char:FindFirstChildOfClass("Tool")
                                    if tool then
                                        local act = tool:FindFirstChild("Activated")
                                        if act then act:Fire() end
                                    end
                                end)
                                pcall(function()
                                    local RS = game:GetService("ReplicatedStorage")
                                    for _, n in ipairs({"DamageEvent","HitEvent","Hit","Damage"}) do
                                        local re = RS:FindFirstChild(n)
                                        if re then re:FireServer(p.Character, 15); break end
                                    end
                                end)
                            end
                        end
                    end
                end
            end)
        else
            if _kauraCon then _kauraCon:Disconnect(); _kauraCon = nil end
        end
    end })
KauraR:AddSlider("KillAuraRange", { Text="Aura Range (studs)",
    Default=30, Min=5, Max=100, Rounding=0,
    Callback = function(v) _kauraCFG.range = v end })
end -- Kill Aura scope

-- ═══════════════════════════════════════════════════════════════
--  UNCODE v1 ·  Knife Rage
-- ═══════════════════════════════════════════════════════════════
do -- Knife Rage scope
local _knrCFG = {
    enabled    = false,
    autoEquip  = true,
    speedBoost = true,
    range      = 12,
    swing      = true,
    panic      = false,
}
local _knrCon  = nil
local _knrConD = nil
local _knrRS   = game:GetService("RunService")
local _knrP    = game:GetService("Players")
local _knrUIS  = game:GetService("UserInputService")
local _knrVIM  = nil
pcall(function() _knrVIM = game:GetService("VirtualInputManager") end)

local _knrOrigSpeed = nil

local KnrL = Tabs.PlayerFight:AddLeftGroupbox("Knife Rage")
local KnrR = Tabs.PlayerFight:AddRightGroupbox("Knife Rage Config")

local _knrKnifeNames = {
    "Knife", "knife", "Katana", "Blade", "blade",
    "Dagger", "dagger", "Melee", "melee", "Saber",
    "Katana", "katana", "Sword", "sword"
}

local function _knrIsKnife(tool)
    if not tool then return false end
    for _, pat in ipairs(_knrKnifeNames) do
        if tool.Name:find(pat) then return true end
    end
    if tool:FindFirstChild("Handle") and
       not tool.Name:lower():find("gun") and
       not tool.Name:lower():find("shot") and
       not tool.Name:lower():find("rifle") and
       not tool.Name:lower():find("pistol") then
        if tool:FindFirstChild("Slash") or
           tool:FindFirstChild("Stab") or
           tool:FindFirstChild("Hit") then
            return true
        end
    end
    return false
end

local function _knrGetKnife(char)
    for _, tool in ipairs(char:GetChildren()) do
        if tool:IsA("Tool") and _knrIsKnife(tool) then
            return tool
        end
    end
    local lp = _knrP.LocalPlayer
    if lp.Backpack then
        for _, tool in ipairs(lp.Backpack:GetChildren()) do
            if tool:IsA("Tool") and _knrIsKnife(tool) then
                return tool
            end
        end
    end
    return nil
end

local function _knrEquip(char, knife)
    pcall(function()
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum and knife then hum:EquipTool(knife) end
    end)
end

local function _knrSwing(knife)
    pcall(function()
        if knife and knife.Parent and knife.Parent:FindFirstChildOfClass("Humanoid") then
            local activateEv = knife:FindFirstChild("Activate") or
                               knife:FindFirstChild("Slash") or
                               knife:FindFirstChild("OnActivated")
            if activateEv and activateEv:IsA("RemoteEvent") then
                activateEv:FireServer()
            else
                if _knrVIM then
                    _knrVIM:SendMouseButtonEvent(0, 0, 0, true, game, 1)
                    task.wait(0.05)
                    _knrVIM:SendMouseButtonEvent(0, 0, 0, false, game, 1)
                end
            end
        end
    end)
end

local function _knrGetClosestEnemy(hrp)
    local closest, closestDist = nil, math.huge
    for _, p in ipairs(_knrP:GetPlayers()) do
        if p ~= _knrP.LocalPlayer and p.Character then
            local phrp = p.Character:FindFirstChild("HumanoidRootPart")
            local phum = p.Character:FindFirstChildOfClass("Humanoid")
            if phrp and phum and phum.Health > 0 then
                local d = (hrp.Position - phrp.Position).Magnitude
                if d < closestDist then
                    closestDist = d
                    closest = { player=p, hrp=phrp, dist=d }
                end
            end
        end
    end
    return closest
end

KnrL:AddToggle("KnifeRageEnabled", {
    Text    = "Knife Rage",
    Default = false,
    Tooltip = "Auto-attack nearby enemies with knife",
    Callback = function(v)
        _knrCFG.enabled = v
        local lp   = _knrP.LocalPlayer
        local char = lp.Character
        if v then
            _knrCon = _knrRS.Heartbeat:Connect(function()
                if not _knrCFG.enabled then return end
                local c = lp.Character
                if not c then return end
                local hrp  = c:FindFirstChild("HumanoidRootPart")
                local hum  = c:FindFirstChildOfClass("Humanoid")
                if not hrp or not hum or hum.Health <= 0 then return end

                local enemy = _knrGetClosestEnemy(hrp)
                if not enemy or enemy.dist > _knrCFG.range then return end

                local knife = _knrGetKnife(c)
                if not knife then return end

                if knife.Parent ~= c then
                    if _knrCFG.autoEquip then
                        _knrEquip(c, knife)
                        task.wait(0.1)
                    else
                        return
                    end
                end

                if _knrCFG.speedBoost then
                    if not _knrOrigSpeed then
                        _knrOrigSpeed = hum.WalkSpeed
                    end
                    hum.WalkSpeed = math.max(hum.WalkSpeed, _knrOrigSpeed * 1.6)
                end

                pcall(function()
                    local targetPos = enemy.hrp.Position
                    hrp.CFrame = CFrame.new(hrp.Position, Vector3.new(targetPos.X, hrp.Position.Y, targetPos.Z))
                end)

                if _knrCFG.swing then
                    _knrSwing(knife)
                end
            end)

            _knrConD = lp.CharacterAdded:Connect(function(newChar)
                _knrOrigSpeed = nil
            end)

            Notification.new({ Title="Knife Rage",
                Content="Enabled — Range ".._knrCFG.range.."st", Duration=2 })
        else
            if _knrCon  then _knrCon:Disconnect();  _knrCon  = nil end
            if _knrConD then _knrConD:Disconnect(); _knrConD = nil end
            if _knrOrigSpeed and char then
                local hum = char:FindFirstChildOfClass("Humanoid")
                if hum then hum.WalkSpeed = _knrOrigSpeed end
            end
            _knrOrigSpeed = nil
        end
    end })

KnrL:AddToggle("KnifeRageAutoEquip", {
    Text    = "Auto Equip Knife",
    Default = true,
    Tooltip = "Equip knife automatically if not held",
    Callback = function(v) _knrCFG.autoEquip = v end })

KnrL:AddToggle("KnifeRageSpeed", {
    Text    = "Speed Boost",
    Default = true,
    Tooltip = "1.6x walk speed during Knife Rage",
    Callback = function(v)
        _knrCFG.speedBoost = v
        if not v and _knrOrigSpeed then
            local lp  = _knrP.LocalPlayer
            local char = lp.Character
            if char then
                local hum = char:FindFirstChildOfClass("Humanoid")
                if hum then hum.WalkSpeed = _knrOrigSpeed end
            end
            _knrOrigSpeed = nil
        end
    end })

KnrL:AddToggle("KnifeRageSwing", {
    Text    = "Auto Swing",
    Default = true,
    Tooltip = "Auto swing at enemies in range",
    Callback = function(v) _knrCFG.swing = v end })

KnrR:AddSlider("KnifeRageRange", {
    Text    = "Knife Range (studs)",
    Default = 12, Min = 4, Max = 40, Rounding = 0,
    Callback = function(v) _knrCFG.range = v end })

KnrR:AddLabel("── Knife Name Patterns ──")
KnrR:AddLabel("Knife / Blade / Dagger")
KnrR:AddLabel("Melee / Saber / Katana")
KnrR:AddLabel("Sword / slash-stab events")

end -- Knife Rage scope

-- ═══════════════════════════════════════════════════════════════
--  UNCODE v1 ·  Hitbox Expander
-- ═══════════════════════════════════════════════════════════════
do -- Hitbox Expander scope
local _hbxCFG = { enabled=false, scale=2.0 }
local _hbxCon = nil
local _hbxRS  = game:GetService("RunService")
local _hbxP   = game:GetService("Players")
local HbxL = Tabs.PlayerFight:AddLeftGroupbox("Hitbox Expander")
local HbxR = Tabs.PlayerFight:AddRightGroupbox("Hitbox Config")

local function _hbxApply(char, s)
    pcall(function()
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if hrp then hrp.Size = Vector3.new(2*s, 2*s, 1*s) end
        local head = char:FindFirstChild("Head")
        if head then head.Size = Vector3.new(2*s, 2*s, 2*s) end
    end)
end
local function _hbxReset(char)
    pcall(function()
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if hrp then hrp.Size = Vector3.new(2, 2, 1) end
        local head = char:FindFirstChild("Head")
        if head then head.Size = Vector3.new(2, 2, 2) end
    end)
end

HbxL:AddToggle("HitboxExpandEnabled", { Text="Hitbox Expander", Default=false,
    Tooltip="Expand enemy hitboxes",
    Callback = function(v)
        _hbxCFG.enabled = v
        if v then
            _hbxCon = _hbxRS.Heartbeat:Connect(function()
                if not _hbxCFG.enabled then return end
                for _, p in ipairs(_hbxP:GetPlayers()) do
                    if p ~= _hbxP.LocalPlayer and p.Character then
                        _hbxApply(p.Character, _hbxCFG.scale)
                    end
                end
            end)
        else
            if _hbxCon then _hbxCon:Disconnect(); _hbxCon = nil end
            for _, p in ipairs(_hbxP:GetPlayers()) do
                if p ~= _hbxP.LocalPlayer and p.Character then
                    _hbxReset(p.Character)
                end
            end
        end
    end })
HbxR:AddSlider("HitboxExpandScale", { Text="Scale Factor",
    Default=2, Min=1, Max=10, Rounding=1,
    Callback = function(v)
        _hbxCFG.scale = v
    end })
end -- Hitbox Expander scope

-- ═══════════════════════════════════════════════════════════════
--  UNCODE v1 ·  No Fall Damage
-- ═══════════════════════════════════════════════════════════════
do -- No Fall Damage scope
local _nfdCFG = { enabled=false }
local _nfdCon = nil
local _nfdL = Tabs.PlayerFight:AddLeftGroupbox("Fall Protection")

_nfdL:AddToggle("NoFallDamageEnabled", { Text="No Fall Damage", Default=false,
    Tooltip="Prevents fall damage",
    Callback = function(v)
        _nfdCFG.enabled = v
        local lp = game:GetService("Players").LocalPlayer
        local function _setupNFD(char)
            if _nfdCon then _nfdCon:Disconnect(); _nfdCon = nil end
            if not v then return end
            local hum = char:WaitForChild("Humanoid", 5)
            if not hum then return end
            pcall(function()
                hum:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
            end)
            local prevHP = hum.Health
            _nfdCon = hum.HealthChanged:Connect(function(hp)
                if not _nfdCFG.enabled then return end
                local diff = prevHP - hp
                if diff > 0 and diff <= 150 then
                    task.defer(function()
                        pcall(function()
                            hum.Health = math.min(hum.Health + diff, hum.MaxHealth)
                        end)
                    end)
                end
                prevHP = hum.Health
            end)
        end
        if lp.Character then _setupNFD(lp.Character) end
        lp.CharacterAdded:Connect(function(c)
            task.wait(0.3)
            if _nfdCFG.enabled then _setupNFD(c) end
        end)
    end })
end -- No Fall Damage scope

-- ═══════════════════════════════════════════════════════════════
--  UNCODE v1 ·  Damage Multiplier
-- ═══════════════════════════════════════════════════════════════
do -- Damage Multiplier scope
local _dmgCFG = { enabled=false, mult=2.0 }
local _dmgL = Tabs.PlayerFight:AddLeftGroupbox("Damage Modifier")
local _dmgR = Tabs.PlayerFight:AddRightGroupbox("Damage Config")

_dmgL:AddToggle("DmgMultEnabled", { Text="Damage Multiplier", Default=false,
    Tooltip="Amplify outgoing damage (executor-dependent)",
    Callback = function(v)
        _dmgCFG.enabled = v
        if v then
            pcall(function()
                local mt = getrawmetatable and getrawmetatable(game)
                if not mt then return end
                if setreadonly then setreadonly(mt, false) end
                local old_nc = mt.__namecall
                mt.__namecall = newcclosure(function(self, ...)
                    local m = getnamecallmethod and getnamecallmethod()
                    if _dmgCFG.enabled and m == "TakeDamage" then
                        local args = {...}
                        if type(args[1]) == "number" then
                            return old_nc(self, args[1] * _dmgCFG.mult)
                        end
                    end
                    return old_nc(self, ...)
                end)
                if setreadonly then setreadonly(mt, true) end
            end)
        end
    end })
_dmgR:AddSlider("DmgMultValue", { Text="Multiplier",
    Default=2, Min=1, Max=20, Rounding=1,
    Callback = function(v) _dmgCFG.mult = v end })
end -- Damage Multiplier scope


--  UNCODE v1 ·  Auto Scope / ADS
-- ═══════════════════════════════════════════════════════════════
do -- Auto Scope scope
local _adsCFG = { enabled=false, range=50 }
local _adsCon = nil
local _adsRS  = game:GetService("RunService")
local _adsP   = game:GetService("Players")
local AdsL = Tabs.PlayerUtil:AddLeftGroupbox("Auto ADS")
local AdsR = Tabs.PlayerUtil:AddRightGroupbox("ADS Config")

AdsL:AddToggle("AutoAdsEnabled", { Text="Auto Scope / ADS", Default=false,
    Tooltip="Auto-ADS when enemy is in range",
    Callback = function(v)
        _adsCFG.enabled = v
        if v then
            _adsCon = _adsRS.Heartbeat:Connect(function()
                if not _adsCFG.enabled then return end
                local lp   = _adsP.LocalPlayer
                local char = lp.Character
                if not char then return end
                local hrp  = char:FindFirstChild("HumanoidRootPart")
                if not hrp then return end
                local closest = math.huge
                for _, p in ipairs(_adsP:GetPlayers()) do
                    if p ~= lp and p.Character then
                        local phrp = p.Character:FindFirstChild("HumanoidRootPart")
                        local phum = p.Character:FindFirstChildOfClass("Humanoid")
                        if phrp and phum and phum.Health > 0 then
                            local d = (hrp.Position - phrp.Position).Magnitude
                            if d < closest then closest = d end
                        end
                    end
                end
                if closest <= _adsCFG.range then
                    pcall(function()
                        local VIM = game:GetService("VirtualInputManager")
                        VIM:SendMouseButtonEvent(0, 0, Enum.UserInputType.MouseButton2, true, game, 0)
                    end)
                end
            end)
        else
            if _adsCon then _adsCon:Disconnect(); _adsCon = nil end
        end
    end })
AdsR:AddSlider("AutoAdsRange", { Text="ADS Trigger Range (studs)",
    Default=50, Min=10, Max=300, Rounding=0,
    Callback = function(v) _adsCFG.range = v end })
end -- Auto Scope scope


do -- Automation Tab scope

-- Fetch Rivals map/weapon lists at runtime from game modules
local _rivalsMaps    = {}
local _rivalsWeapons = {}
pcall(function()
    local RS      = game:GetService("ReplicatedStorage")
    local mods    = RS:WaitForChild("Modules", 5)
    if mods then
        local ok1, IL = pcall(require, mods:WaitForChild("ItemLibrary", 5))
        if ok1 and IL and IL.Items then
            for k in next, IL.Items do
                if k ~= "MISSING_WEAPON" then
                    table.insert(_rivalsWeapons, k)
                end
            end
            table.sort(_rivalsWeapons)
        end
        local ok2, DL = pcall(require, mods:WaitForChild("DuelLibrary", 5))
        if ok2 and DL and DL.MapOrder then
            for _, m in DL.MapOrder do
                table.insert(_rivalsMaps, m)
            end
        end
    end
end)
if #_rivalsMaps    == 0 then _rivalsMaps    = {"Arena","Citadel","Ruins","Factory","Bridge"} end
if #_rivalsWeapons == 0 then _rivalsWeapons = {"Rifle","Shotgun","Sniper","SMG","Pistol","Revolver","Katana"} end


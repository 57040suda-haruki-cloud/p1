})

-- ╔═══════════════════════════════════════════════════════════════════════╗
-- ║  ENEMY INFO DISPLAY                                                  ║
-- ║  Combat → Enemy Info / Info Settings                                ║
-- ╚═══════════════════════════════════════════════════════════════════════╝
do
local THL = Tabs.Combat:AddLeftGroupbox("Enemy Info")
local THR = Tabs.Combat:AddRightGroupbox("Info Settings")

-- ── Config ───────────────────────────────────────────────────────────────
local eiCFG = {
    enabled    = false,
    showName   = true,
    showHP     = true,
    showWeapon = true,
    showLevel  = true,
    showRank   = true,
    updateRate = 0.15,  -- seconds between refresh
    boards     = {},    -- [Player] = { bb, lbl }
}

local _eiPlayers = game:GetService("Players")
local _eiLP      = _eiPlayers.LocalPlayer

local function _eiWeapon(char)
    if not char then return "?" end
    for _, v in ipairs(char:GetChildren()) do
        if v:IsA("Tool") then return v.Name end
    end
    local bp = _eiLP and _eiLP:FindFirstChild("Backpack")
    return "—"
end

local function _eiStat(player, key)
    local ls = player:FindFirstChild("leaderstats")
    if not ls then return "?" end
    local s = ls:FindFirstChild(key)
    return s and tostring(s.Value) or "?"
end

local function _eiMakeBB(player, char)
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return end
    local old = char:FindFirstChild("_UNC_EI")
    if old then old:Destroy() end

    local bb = Instance.new("BillboardGui")
    bb.Name           = "_UNC_EI"
    bb.Adornee        = root
    bb.AlwaysOnTop    = true
    bb.Size           = UDim2.new(0, 170, 0, 90)
    bb.StudsOffset    = Vector3.new(0, 3.2, 0)
    bb.LightInfluence = 0
    bb.Parent         = char

    local bg = Instance.new("Frame")
    bg.BackgroundColor3   = Color3.fromRGB(10, 10, 10)
    bg.BackgroundTransparency = 0.38
    bg.BorderSizePixel    = 0
    bg.Size               = UDim2.new(1, 0, 1, 0)
    bg.Parent             = bb
    Instance.new("UICorner", bg).CornerRadius = UDim.new(0, 5)

    local barBG = Instance.new("Frame")
    barBG.Name                 = "HPBarBG"
    barBG.BackgroundColor3     = Color3.fromRGB(60, 0, 0)
    barBG.BackgroundTransparency = 0
    barBG.BorderSizePixel      = 0
    barBG.Size                 = UDim2.new(1, -6, 0, 5)
    barBG.Position             = UDim2.new(0, 3, 1, -7)
    barBG.Parent               = bg
    Instance.new("UICorner", barBG).CornerRadius = UDim.new(0, 3)

    local barFG = Instance.new("Frame")
    barFG.Name                 = "HPBarFG"
    barFG.BackgroundColor3     = Color3.fromRGB(80, 220, 80)
    barFG.BorderSizePixel      = 0
    barFG.Size                 = UDim2.new(1, 0, 1, 0)
    barFG.Parent               = barBG
    Instance.new("UICorner", barFG).CornerRadius = UDim.new(0, 3)

    local lbl = Instance.new("TextLabel")
    lbl.Name                   = "InfoLbl"
    lbl.BackgroundTransparency = 1
    lbl.Size                   = UDim2.new(1, -4, 1, -10)
    lbl.Position               = UDim2.new(0, 2, 0, 2)
    lbl.TextColor3             = Color3.fromRGB(255, 255, 255)
    lbl.TextSize               = 11
    lbl.Font                   = Enum.Font.GothamBold
    lbl.TextWrapped            = true
    lbl.TextXAlignment         = Enum.TextXAlignment.Left
    lbl.TextYAlignment         = Enum.TextYAlignment.Top
    lbl.Text                   = player.Name
    lbl.Parent                 = bg

    eiCFG.boards[player] = { bb = bb, lbl = lbl, barFG = barFG }
end

local function _eiRemoveBB(player)
    local b = eiCFG.boards[player]
    if b and b.bb then pcall(function() b.bb:Destroy() end) end
    eiCFG.boards[player] = nil
end

local function _eiUpdateAll()
    for _, player in ipairs(_eiPlayers:GetPlayers()) do
        if player ~= _eiLP then
            local char = player.Character
            if char then
                local b = eiCFG.boards[player]
                if not b or not b.bb or not b.bb.Parent then
                    _eiMakeBB(player, char)
                    b = eiCFG.boards[player]
                end
                if not b then return end

                local hum  = char:FindFirstChild("Humanoid")
                local hp   = hum and math.floor(hum.Health)   or 0
                local maxhp= hum and math.floor(hum.MaxHealth) or 100
                if maxhp <= 0 then maxhp = 100 end
                local pct  = hp / maxhp

                local lines = {}
                if eiCFG.showName then
                    table.insert(lines, "▸ " .. player.Name)
                end
                if eiCFG.showHP then
                    table.insert(lines, "HP  " .. hp .. " / " .. maxhp)
                end
                if eiCFG.showWeapon then
                    table.insert(lines, "Weapon: " .. _eiWeapon(char))
                end
                if eiCFG.showLevel then
                    table.insert(lines, "Lv." .. _eiStat(player, "Level"))
                end
                if eiCFG.showRank then
                    table.insert(lines, "Rank  " .. _eiStat(player, "Rank"))
                end
                b.lbl.Text = table.concat(lines, "\n")

                if b.barFG then
                    b.barFG.Size = UDim2.new(math.clamp(pct, 0, 1), 0, 1, 0)
                    local r = math.clamp(1 - pct, 0, 1)
                    local g = math.clamp(pct,      0, 1) * 0.85
                    b.barFG.BackgroundColor3 = Color3.new(r, g, 0)
                end
            else
                _eiRemoveBB(player)
            end
        end
    end
    for player in pairs(eiCFG.boards) do
        if not player or not player.Parent then
            _eiRemoveBB(player)
        end
    end
end

local _eiConn
local _eiTimer = 0

local function _eiStart()
    if _eiConn then _eiConn:Disconnect() end
    _eiTimer = 0
    _eiConn = game:GetService("RunService").Heartbeat:Connect(function(dt)
        if not eiCFG.enabled then return end
        _eiTimer = _eiTimer + dt
        if _eiTimer < eiCFG.updateRate then return end
        _eiTimer = 0
        pcall(_eiUpdateAll)
    end)
end

local function _eiStop()
    if _eiConn then _eiConn:Disconnect(); _eiConn = nil end
    for player in pairs(eiCFG.boards) do _eiRemoveBB(player) end
end

THL:AddToggle("EnemyInfoEnabled", {
    Text    = "Enemy Info Display",
    Default = false,
    Tooltip = "Display enemy HP, weapon, level, and rank above their head",
    Callback = function(v)
        eiCFG.enabled = v
        _qbState["EnemyInfoEnabled"] = v
        if v then _eiStart() else _eiStop() end
    end,
})

THL:AddToggle("EIShowName", {
    Text    = "Show Name",
    Default = true,
    Callback = function(v) eiCFG.showName = v end,
})

THL:AddToggle("EIShowHP", {
    Text    = "Show HP",
    Default = true,
    Callback = function(v) eiCFG.showHP = v end,
})

THL:AddToggle("EIShowWeapon", {
    Text    = "Show Weapon",
    Default = true,
    Callback = function(v) eiCFG.showWeapon = v end,
})

THR:AddToggle("EIShowLevel", {
    Text    = "Show Level",
    Default = true,
    Callback = function(v) eiCFG.showLevel = v end,
})

THR:AddToggle("EIShowRank", {
    Text    = "Show Rank",
    Default = true,
    Callback = function(v) eiCFG.showRank = v end,
})

THR:AddSlider("EIUpdateRate", {
    Text    = "Update Rate (×0.05s)",
    Default = 3,
    Min = 1, Max = 20, Rounding = 0,
    Tooltip = "1 = 0.05s (fastest) / 20 = 1s (low load)",
    Callback = function(v) eiCFG.updateRate = v * 0.05 end,
})

_qbLabels["EnemyInfoEnabled"] = "Enemy Info"
_qbState["EnemyInfoEnabled"]  = false
_qbSetKey("EnemyInfoEnabled", "None")
_regFlag("EnemyInfoEnabled", function(v)
    eiCFG.enabled = v
    if v then _eiStart() else _eiStop() end
end)

end -- Enemy Info scope

end -- HvH UI scope



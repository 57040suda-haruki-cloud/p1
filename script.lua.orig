-- ═══════════════════════════════════════════════════════════════
-- ═══════════════════════════════════════════════════════════════
do -- Smooth Aim scope
local _smCFG  = { enabled=false, factor=0.12, humanness=0.25, maxDeg=8 }
local _smCon  = nil
local _smRS   = game:GetService("RunService")
local _smP    = game:GetService("Players")
local SmL = HvHTab:AddLeftGroupbox("Smooth Aim")
local SmR = HvHTab:AddRightGroupbox("Smooth Aim Config")

SmL:AddToggle("SmoothAimEnabled", { Text="Smooth Aim", Default=false,
    Tooltip="Add human-like lerp/curve to aimbot",
    Callback = function(v)
        _smCFG.enabled = v
        local cam = workspace.CurrentCamera
        if v then
            local targetCF = cam.CFrame
            _smCon = _smRS.RenderStepped:Connect(function(dt)
                if not _smCFG.enabled then return end
                local lp = _smP.LocalPlayer
                local char = lp.Character
                if not char then return end
                local hrp = char:FindFirstChild("HumanoidRootPart")
                if not hrp then return end
                local closest, closestPos = math.huge, nil
                for _, p in ipairs(_smP:GetPlayers()) do
                    if p ~= lp and p.Character then
                        local phrp = p.Character:FindFirstChild("HumanoidRootPart")
                        local phum = p.Character:FindFirstChildOfClass("Humanoid")
                        if phrp and phum and phum.Health > 0 then
                            local d = (hrp.Position - phrp.Position).Magnitude
                            if d < closest then
                                closest = d
                                local boneNames = {"Head","Neck","UpperTorso","HumanoidRootPart","LowerTorso"}
                                local bone = p.Character:FindFirstChild(boneNames[1]) or phrp
                                closestPos = bone.Position
                            end
                        end
                    end
                end
                if closestPos then
                    local noise   = math.random() * _smCFG.humanness * 0.04 - (_smCFG.humanness * 0.02)
                    local alpha   = math.clamp(_smCFG.factor + noise, 0.01, 1.0)
                    local dir     = (closestPos - cam.CFrame.Position).Unit
                    local targetRot = CFrame.new(cam.CFrame.Position, cam.CFrame.Position + dir)
                    local curDir  = cam.CFrame.LookVector
                    local angle   = math.deg(math.acos(math.clamp(curDir:Dot(dir), -1, 1)))
                    if angle > 0 and angle <= _smCFG.maxDeg then
                        cam.CFrame = cam.CFrame:Lerp(targetRot, alpha)
                    end
                end
            end)
        else
            if _smCon then _smCon:Disconnect(); _smCon = nil end
        end
    end })
SmL:AddToggle("SmoothAimLock", { Text="Max Angle Clamp", Default=true,
    Callback = function(v) _smCFG.maxDeg = v and 8 or 360 end })
SmR:AddSlider("SmoothAimFactor", { Text="Lerp Factor",
    Default=12, Min=1, Max=50, Rounding=0,
    Callback = function(v) _smCFG.factor = v / 100 end })
SmR:AddSlider("SmoothAimHumanness", { Text="Humanness",
    Default=25, Min=0, Max=100, Rounding=0,
    Callback = function(v) _smCFG.humanness = v / 100 end })
SmR:AddSlider("SmoothAimMaxDeg", { Text="Max Angle (°)",
    Default=8, Min=1, Max=45, Rounding=0,
    Callback = function(v) _smCFG.maxDeg = v end })
end -- Smooth Aim scope

-- ═══════════════════════════════════════════════════════════════
--  UNCODE v1 ·  Target Auto Switch
-- ═══════════════════════════════════════════════════════════════
do -- Target Auto Switch scope
local _tsCFG  = { enabled=false, mode="Closest", notifOnSwitch=true }
local _tsCon  = nil
local _tsRS   = game:GetService("RunService")
local _tsP    = game:GetService("Players")
local _tsCurr = nil
local TsL = HvHTab:AddLeftGroupbox("Target Auto Switch")
local TsR = HvHTab:AddRightGroupbox("Target Switch Config")

local function _tsPickNext(excludeName)
    local lp = _tsP.LocalPlayer
    local char = lp.Character
    if not char then return nil end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end
    local best, bestScore = nil, -math.huge
    for _, p in ipairs(_tsP:GetPlayers()) do
        if p ~= lp and p.Name ~= excludeName and p.Character then
            local phrp = p.Character:FindFirstChild("HumanoidRootPart")
            local phum = p.Character:FindFirstChildOfClass("Humanoid")
            if phrp and phum and phum.Health > 0 then
                local d = (hrp.Position - phrp.Position).Magnitude
                local score = _tsCFG.mode == "Closest" and (-d)
                           or _tsCFG.mode == "Lowest HP" and (-phum.Health)
                           or (-d) -- fallback
                if score > bestScore then bestScore = score; best = p end
            end
        end
    end
    return best
end

TsL:AddToggle("TargetSwitchEnabled", { Text="Target Auto Switch", Default=false,
    Tooltip="Auto switch to next enemy after kill",
    Callback = function(v)
        _tsCFG.enabled = v
        if v then
            _tsCon = _tsRS.Heartbeat:Connect(function()
                if not _tsCFG.enabled then return end
                if _tsCurr and _tsCurr.Character then
                    local phum = _tsCurr.Character:FindFirstChildOfClass("Humanoid")
                    if phum and phum.Health <= 0 then
                        local dead = _tsCurr.Name
                        local next = _tsPickNext(dead)
                        _tsCurr = next
                        if next then
                            _kSet({"Aimbot","ForceTarget"}, next.Name)
                            if _tsCFG.notifOnSwitch then
                                Notification.new({ Title="Target Switched",
                                    Content="→ "..next.Name, Duration=2 })
                            end
                        end
                    end
                else
                    _tsCurr = _tsPickNext(nil)
                    if _tsCurr then _kSet({"Aimbot","ForceTarget"}, _tsCurr.Name) end
                end
            end)
        else
            if _tsCon then _tsCon:Disconnect(); _tsCon = nil end
            _tsCurr = nil
        end
    end })
TsL:AddToggle("TargetSwitchNotif", { Text="Switch Notification", Default=true,
    Callback = function(v) _tsCFG.notifOnSwitch = v end })
TsR:AddDropdown("TargetSwitchMode", { Text="Priority Mode",
    Values={ "Closest", "Lowest HP", "Highest HP" }, Default=1,
    Callback = function(v) _tsCFG.mode = v end })
end -- Target Auto Switch scope


do -- Gravity Modifier scope
local _gravCFG = { enabled=false, value=196.2 }
local GravL = Tabs.World:AddLeftGroupbox("Gravity Modifier")
local GravR = Tabs.World:AddRightGroupbox("Gravity Config")

GravL:AddToggle("GravityEnabled", { Text="Gravity Modifier", Default=false,
    Tooltip="Modify workspace gravity",
    Callback = function(v)
        _gravCFG.enabled = v
        if v then
            pcall(function() workspace.Gravity = _gravCFG.value end)
        else
            pcall(function() workspace.Gravity = 196.2 end)
        end
    end })
GravL:AddButton("Reset Gravity", function()
    pcall(function() workspace.Gravity = 196.2 end)
    _gravCFG.value = 196.2
    Notification.new({ Title="Gravity",
        Content="Gravity reset to default (196.2)", Duration=2 })
end)
GravR:AddSlider("GravityValue", { Text="Gravity Value",
    Default=196, Min=0, Max=1000, Rounding=0,
    Callback = function(v)
        _gravCFG.value = v
        if _gravCFG.enabled then
            pcall(function() workspace.Gravity = v end)
        end
    end })
end -- Gravity Modifier scope

end -- World Tab scope


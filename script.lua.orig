--  UNCODE v1 ·  Rainbow Chams
-- ═══════════════════════════════════════════════════════════════
do -- Rainbow Chams scope
local _rbCFG = { enabled=false, speed=1.0 }
local _rbCon = nil
local _rbRS  = game:GetService("RunService")
local _rbP   = game:GetService("Players")

HvHL4:AddToggle("RainbowChamsEnabled", { Text="Rainbow Chams", Default=false,
    Tooltip="Chams color cycles through the rainbow",
    Callback = function(v)
        _rbCFG.enabled = v
        if v then
            _rbCon = _rbRS.Heartbeat:Connect(function()
                if not _rbCFG.enabled then return end
                local hue     = (tick() * _rbCFG.speed) % 1
                local rbColor = Color3.fromHSV(hue, 1, 1)
                local lp = _rbP.LocalPlayer
                for _, p in ipairs(_rbP:GetPlayers()) do
                    if p ~= lp and p.Character then
                        for _, hl in ipairs(p.Character:GetDescendants()) do
                            if hl:IsA("Highlight") then
                                hl.FillColor    = rbColor
                                hl.OutlineColor = rbColor
                            end
                        end
                    end
                end
            end)
        else
            if _rbCon then _rbCon:Disconnect(); _rbCon = nil end
        end
    end })
HvHR4:AddSlider("RainbowChamsSpeed", { Text="Color Cycle Speed",
    Default=1, Min=0.1, Max=10, Rounding=1,
    Callback = function(v) _rbCFG.speed = v end })
end -- Rainbow Chams scope

-- ═══════════════════════════════════════════════════════════════
--  UNCODE v1 ·  Distance-Based ESP Color
-- ═══════════════════════════════════════════════════════════════
do -- Distance Color ESP scope
local _dcCFG  = { enabled=false, nearDist=30, farDist=200 }
local _dcCon  = nil
local _dcRS   = game:GetService("RunService")
local _dcP    = game:GetService("Players")

HvHL4:AddToggle("DistColorEnabled", { Text="Distance Color ESP", Default=false,
    Tooltip="Near=red far=blue gradient on highlights",
    Callback = function(v)
        _dcCFG.enabled = v
        if v then
            _dcCon = _dcRS.Heartbeat:Connect(function()
                if not _dcCFG.enabled then return end
                local lp = _dcP.LocalPlayer
                local char = lp.Character
                if not char then return end
                local hrp = char:FindFirstChild("HumanoidRootPart")
                if not hrp then return end
                for _, p in ipairs(_dcP:GetPlayers()) do
                    if p ~= lp and p.Character then
                        local phrp = p.Character:FindFirstChild("HumanoidRootPart")
                        if phrp then
                            local d     = (hrp.Position - phrp.Position).Magnitude
                            local t     = math.clamp((d - _dcCFG.nearDist) / (_dcCFG.farDist - _dcCFG.nearDist), 0, 1)
                            local hue   = t * (240/360)
                            local color = Color3.fromHSV(hue, 1, 1)
                            for _, hl in ipairs(p.Character:GetDescendants()) do
                                if hl:IsA("Highlight") then
                                    hl.OutlineColor = color
                                    if hl.FillTransparency < 1 then hl.FillColor = color end
                                end
                            end
                        end
                    end
                end
            end)
        else
            if _dcCon then _dcCon:Disconnect(); _dcCon = nil end
        end
    end })
HvHR4:AddSlider("DistColorNear", { Text="Near Threshold (studs)",
    Default=30, Min=5, Max=100, Rounding=0, Callback = function(v) _dcCFG.nearDist = v end })
HvHR4:AddSlider("DistColorFar",  { Text="Far Threshold (studs)",
    Default=200, Min=50, Max=1000, Rounding=0, Callback = function(v) _dcCFG.farDist = v end })
end -- Distance Color ESP scope

-- ═══════════════════════════════════════════════════════════════
--  UNCODE v1 ·  Wallbang ESP
-- ═══════════════════════════════════════════════════════════════
do -- Wallbang ESP scope
local _wbCFG  = { enabled=false, color=Color3.fromRGB(255,120,0), maxThick=0.5 }
local _wbCon  = nil
local _wbRS   = game:GetService("RunService")
local _wbP    = game:GetService("Players")

local _wbPenetrableMats = {
    [Enum.Material.Glass]       = true,
    [Enum.Material.SmoothPlastic] = true,
    [Enum.Material.Metal]       = true,
    [Enum.Material.Foil]        = true,
}

HvHL4:AddToggle("WallbangEnabled", { Text="Wallbang ESP", Default=false,
    Tooltip="Highlight walls you can shoot through",
    Callback = function(v)
        _wbCFG.enabled = v
        if v then
            _wbCon = _wbRS.Heartbeat:Connect(function()
                if not _wbCFG.enabled then return end
                local lp  = _wbP.LocalPlayer
                local char = lp.Character
                if not char then return end
                local hrp = char:FindFirstChild("HumanoidRootPart")
                if not hrp then return end
                for _, p in ipairs(_wbP:GetPlayers()) do
                    if p ~= lp and p.Character then
                        local phrp = p.Character:FindFirstChild("HumanoidRootPart")
                        if phrp then
                            local origin = hrp.Position
                            local target = phrp.Position
                            local dir    = (target - origin)
                            local ray    = Ray.new(origin, dir)
                            local ignoreList = {char, p.Character}
                            local hit, _ = workspace:FindPartOnRayWithIgnoreList(ray, ignoreList)
                            if hit and _wbPenetrableMats[hit.Material] and hit.Size.Magnitude <= _wbCFG.maxThick * 50 then
                                local existing = hit:FindFirstChildOfClass("SelectionBox")
                                if not existing then
                                    local sb = Instance.new("SelectionBox")
                                    sb.Adornee             = hit
                                    sb.Color3              = _wbCFG.color
                                    sb.LineThickness       = 0.08
                                    sb.SurfaceColor3       = _wbCFG.color
                                    sb.SurfaceTransparency = 0.5
                                    sb.Parent              = workspace
                                    task.delay(0.5, function() pcall(function() sb:Destroy() end) end)
                                end
                            end
                        end
                    end
                end
            end)
        else
            if _wbCon then _wbCon:Disconnect(); _wbCon = nil end
        end
    end })
HvHR4:AddColorpicker("WallbangColor", { Text="Wallbang Color",
    Default=Color3.fromRGB(255,120,0),
    Callback = function(v) _wbCFG.color = v end })
end -- Wallbang ESP scope

-- ═══════════════════════════════════════════════════════════════
--  UNCODE v1 ·  Respawn Predictor
-- ═══════════════════════════════════════════════════════════════
do -- Respawn Predictor scope
local _rpCFG  = { enabled=false, showTimer=true }
local _rpBills = {}
local _rpCon   = nil
local _rpRS    = game:GetService("RunService")
local _rpP     = game:GetService("Players")

local function _rpClear()
    for _, b in pairs(_rpBills) do pcall(function() b:Destroy() end) end
    _rpBills = {}
end

local function _rpShowSpawn(spawnPart, label)
    pcall(function()
        local bb = Instance.new("BillboardGui")
        bb.Size  = UDim2.new(0, 100, 0, 30)
        bb.StudsOffset = Vector3.new(0, 3, 0)
        bb.Adornee = spawnPart
        bb.AlwaysOnTop = true
        bb.Parent = workspace
        local tl = Instance.new("TextLabel")
        tl.Size   = UDim2.new(1, 0, 1, 0)
        tl.Text   = label
        tl.TextColor3 = Color3.fromRGB(255,200,0)
        tl.TextSize = 14
        tl.Font   = Enum.Font.GothamBold
        tl.BackgroundTransparency = 1
        tl.Parent = bb
        table.insert(_rpBills, bb)
    end)
end

HvHL4:AddToggle("RespawnPredEnabled", { Text="Respawn Predictor", Default=false,
    Tooltip="Predict and highlight enemy spawn locations",
    Callback = function(v)
        _rpCFG.enabled = v
        if v then
            _rpClear()
            for _, obj in ipairs(workspace:GetDescendants()) do
                if obj:IsA("SpawnLocation") then
                    _rpShowSpawn(obj, "⟳ SPAWN")
                end
            end
            _rpCon = _rpP.PlayerRemoving:Connect(function()
                _rpClear()
            end)
        else
            if _rpCon then _rpCon:Disconnect(); _rpCon = nil end
            _rpClear()
        end
    end })
HvHL4:AddToggle("RespawnPredTimer", { Text="Show Respawn Timer", Default=true,
    Callback = function(v) _rpCFG.showTimer = v end })
end -- Respawn Predictor scope


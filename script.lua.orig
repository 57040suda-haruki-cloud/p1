-- ============================================================
--  Yabujin frontend: inject groupboxes into existing UNCODE tabs
-- ============================================================
;(function()
    task.spawn(function()
        local _t0 = os.clock()
        repeat task.wait(0.2) until
            (getgenv()._YabyRuntime and getgenv().__YabujinCF)
            or (os.clock() - _t0) > 25
        local _rt = getgenv()._YabyRuntime
        local _cf = getgenv().__YabujinCF
        if not (_rt and _cf) then
            warn('[UNCODE] Yabujin: runtime or frontend not ready after timeout')
            return
        end
        -- Map each Yabujin tab name to an existing UNCODE tab
        local _yTabMap = {
            ['Spoofers']         = Tabs.Player,
            ['Settings']         = Tabs.Player,
            ['Cosmetics']        = Tabs.SkinChanger,
            ['Inventory']        = Tabs.SkinChanger,
            ['Custom cosmetics'] = Tabs.SkinChanger,
            ['Ranks']            = Tabs.SkinChanger,
            ['Resources']        = Tabs.SkinChanger,
            ['Visuals']          = Tabs.SkinChanger,
        }
        -- Fake window: AddTab returns the mapped UNCODE tab
        local _fakeWin = {}
        _fakeWin.AddTab = function(_, name, _icon)
            return _yTabMap[name] or Tabs.SkinChanger
        end
        -- Intercept CreateWindow so createFrontend gets our fake window
        local _origCW = Library.CreateWindow
        Library.CreateWindow = function() return _fakeWin end
        local _ok, _err = pcall(_cf, _rt, Library)
        Library.CreateWindow = _origCW
        if not _ok then
            warn('[UNCODE] Yabujin frontend: ' .. tostring(_err))
        end
    end)
end)()

-- ============================================================
--  FFA Auto Collect (Tabs.Automation): balls + health pickups
-- ============================================================
;(function()
    local _LP  = game:GetService('Players').LocalPlayer
    local _RS  = game:GetService('RunService')
    local _WS  = game:GetService('Workspace')

    local _collectBalls  = false
    local _collectHealth = false
    local _collectDelay  = 0.3

    -- Case-insensitive substring patterns for each category
    local _BALL_PATS = {
        'abilityorb','abilityball','abilitydrop',
        'droppedballs','droppedball','droporb',
        'ballorb','orbball',
        'ball','orb',
    }
    local _HEAL_PATS = {
        'healorb','healthorb','healpack','healthpack',
        'healthball','healball','healthpickup','healpickup',
        'recoveryorb','healitem','healthitem',
    }

    local function _matches(name, pats)
        local low = name:lower()
        for _, p in ipairs(pats) do
            if low:find(p, 1, true) then return true end
        end
        return false
    end

    local function _getHRP()
        local c = _LP.Character
        return c and c:FindFirstChild('HumanoidRootPart')
    end
    local function _getHum()
        local c = _LP.Character
        return c and c:FindFirstChildOfClass('Humanoid')
    end

    local _lastScan = 0

    _RS.Heartbeat:Connect(function()
        if not (_collectBalls or _collectHealth) then return end
        local now = os.clock()
        if now - _lastScan < _collectDelay then return end
        _lastScan = now

        local hrp = _getHRP()
        if not hrp then return end
        local hum = _getHum()
        if not hum or hum.Health <= 0 then return end

        for _, obj in ipairs(_WS:GetDescendants()) do
            if not obj:IsA('BasePart') then continue end
            local matched = false
            if _collectBalls  and _matches(obj.Name, _BALL_PATS) then matched = true end
            if _collectHealth and _matches(obj.Name, _HEAL_PATS) then matched = true end
            if not matched then continue end
            pcall(function()
                hrp.CFrame = CFrame.new(obj.Position + Vector3.new(0, 3, 0))
            end)
        end
    end)

    local _AGL = Tabs.Automation:AddLeftGroupbox('FFA Auto Collect')

    _AGL:AddToggle('FFACollectBalls', {
        Text     = 'Auto Collect Balls',
        Default  = false,
        Tooltip  = 'Auto-collect all dropped ability orbs/balls in FFA',
        Callback = function(v) _collectBalls = v end,
    })
    _AGL:AddToggle('FFACollectHealth', {
        Text     = 'Auto Collect Health',
        Default  = false,
        Tooltip  = 'Auto-collect all health pickups in FFA',
        Callback = function(v) _collectHealth = v end,
    })
end)()

